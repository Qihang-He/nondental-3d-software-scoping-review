@article{ WOS:000777188800001,
Author = {Turek, Pawel and Pakla, Pawel and Budzik, Grzegorz and Lewandowski,
   Bogumil and Przeszlowski, Lukasz and Dziubek, Tomasz and Wolski,
   Slawomir and Franczak, Jan},
Title = {Procedure Increasing the Accuracy of Modelling and the Manufacturing of
   Surgical Templates with the Use of 3D Printing Techniques, Applied in
   Planning the Procedures of Reconstruction of the Mandible},
Journal = {JOURNAL OF CLINICAL MEDICINE},
Year = {2021},
Volume = {10},
Number = {23},
Month = {DEC},
Abstract = {The application of anatomical models and surgical templates in
   maxillofacial surgery allows, among other benefits, the increase of
   precision and the shortening of the operation time. Insufficiently
   precise anastomosis of the broken parts of the mandible may adversely
   affect the functioning of this organ. Applying the modern mechanical
   engineering methods, including computer-aided design methods (CAD),
   reverse engineering (RE), and rapid prototyping (RP), a procedure used
   to shorten the data processing time and increase the accuracy of
   modelling anatomical structures and the surgical templates with the use
   of 3D printing techniques was developed. The basis for developing and
   testing this procedure was the medical imaging data DICOM of patients
   treated at the Maxillofacial Surgery Clinic of the Fryderyk Chopin
   Provincial Clinical Hospital in RzeszOw. The patients were operated on
   because of malignant tumours of the floor of the oral cavity and the
   necrosis of the mandibular corpus, requiring an extensive resection of
   the soft tissues and resection of the mandible. Familiarity with and the
   implementation of the developed procedure allowed doctors to plan the
   operation precisely and prepare the surgical templates and tools in
   terms of the expected accuracy of the procedures. The models obtained
   based on this procedure shortened the operation time and increased the
   accuracy of performance, which accelerated the patient's rehabilitation
   in the further course of events.},
DOI = {10.3390/jcm10235525},
Article-Number = {5525},
EISSN = {2077-0383},
ResearcherID-Numbers = {Wolski, Sławomir/HMV-6848-2023
