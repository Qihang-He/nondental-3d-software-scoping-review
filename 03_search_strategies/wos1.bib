}

@article{ WOS:001739474500001,
Author = {Azpiazu-Flores, Francisco X. and Aldosari, Abdullah M. and Saponaro,
   Paola C. and Sawangsri, Kedith and Lin, Wei-Shao},
Title = {Prosthetic designs for complete dentures manufactured using contemporary
   3D printing techniques: A case series with clinical, design, and
   laboratory considerations},
Journal = {JOURNAL OF PROSTHODONTICS-IMPLANT ESTHETIC AND RECONSTRUCTIVE DENTISTRY},
Year = {2026},
Month = {2026 APR 14},
Abstract = {Advancements in additive manufacturing have enabled the precise
   fabrication of complete dentures using modern photopolymers and diverse
   3D printing techniques. These innovations have transformed removable
   prosthodontics by allowing clinicians to design and manufacture highly
   customized prostheses to manage difficult anatomical and esthetic
   clinical scenarios. This article presents three different prosthetic
   designs for complete dentures created using different clinical workflows
   and manufacturing techniques, including monolithic printed dentures,
   segmented tooth-base assemblies, and emerging multichromatic additive
   manufacturing systems. This article aims to serve as a practical
   framework for clinicians, offering guidance on selecting prosthetic
   designs based on patient-specific anatomical constraints, esthetic
   expectations, and the capabilities of available digital manufacturing
   technologies.},
DOI = {10.1111/jopr.70144},
EarlyAccessDate = {APR 2026},
ISSN = {1059-941X},
EISSN = {1532-849X},
