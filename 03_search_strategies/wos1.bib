   Gsaxner, Christina/AAJ-7787-2021},
ORCID-Numbers = {Pepe, Antonio/0000-0002-5843-6275
   Holzapfel, Gerhard/0000-0001-8119-5775
   Rolf, Malte/0000-0003-4467-5483
   Gsaxner, Christina/0000-0002-2227-3523},
Unique-ID = {WOS:000567865900003},
