}

@article{ WOS:000567865900003,
Author = {Pepe, Antonio and Li, Jianning and Rolf-Pissarczyk, Malte and Gsaxner,
   Christina and Chen, Xiaojun and Holzapfel, Gerhard A. and Egger, Jan},
Title = {Detection, segmentation, simulation and visualization of aortic
   dissections: A review},
Journal = {MEDICAL IMAGE ANALYSIS},
Year = {2020},
Volume = {65},
Month = {OCT},
Abstract = {Aortic dissection (AD) is a condition of the main artery of the human
   body, resulting in the formation of a new flow channel, or false lumen.
   The disease is usually diagnosed with a computed tomography angiography
   scan during the acute phase. A better understanding of the causes of AD
   requires knowledge of the aortic geometry (segmentation), including the
   true and false lumina, which is very time-consuming to reconstruct when
   performed manually on a slice-by-slice basis. Hence, different automatic
   and semiautomatic medical image analysis approaches have been proposed
   for this task over the last years. In this review, we present and
   discuss these computing techniques used to segment dissected aortas,
   also in regard to the detection and visualization of clinically relevant
   information and features from dissected aortas for customized
   patient-specific treatments. (c) 2020 Elsevier B.V. All rights reserved.},
DOI = {10.1016/j.media.2020.101773},
Article-Number = {101773},
