@article{ WOS:001036558100001,
Author = {Konov, Stanislav and Frolov, Aleksander and Shapovalov, Petr and
   Peretyagin, Pavel and Grigoriev, Sergey},
Title = {Segmented Four-Element Photodiodes in a Three-Dimensional Laser Beam
   Angle Measurement},
Journal = {PHOTONICS},
Year = {2023},
Volume = {10},
Number = {7},
Month = {JUL},
Abstract = {Based on the registration of two laser beam projections, a method for
   measuring the angular deviation of a laser beam from its initial
   position in three-dimensional space is proposed and experimentally
   demonstrated. The laser ray is directed into the beam-splitting cube,
   which distributes the ray into two mutually orthogonal parts, on the
   path of which, two four-segment photodiodes are located at different
   distances from the beam-splitting cube. The value of the angular
   deviation from a certain initial position of the laser beam in
   three-dimensional space is obtained after the mathematical processing of
   the measured position of the laser beam projections' centers in the
   photodiodes coordinates systems. The innovation of this method is that
   the resulting angular deviation of the laser beam is in
   three-dimensional space due to the registration of a pair of
   projections. The experimental results also demonstrate that the proposed
   method has a high speed-measuring potential and can be used for solving
   a wide range of problems.},
DOI = {10.3390/photonics10070704},
Article-Number = {704},
EISSN = {2304-6732},
