  booktitle={2023 International Workshop on Artificial Intelligence and Image Processing (IWAIIP)}, 
  title={Android-Based English Vocabulary Learning Media using Speech Recognition and Augmented Reality}, 
  year={2023},
  volume={},
  number={},
  pages={371-375},
  abstract={English is one of the international languages that must be learned as early as possible, and vocabulary is the main obstacle in learning English. Children tend to like things related to games, so innovation in interactive English learning media is needed to attract children. The Tupai Pintar application offers solutions using three features: object detection, speech recognition, and speech assessment. This application has a sequential working principle from object detection to pronounce assessment. Children can use the application by exploring objects around them to scan and train English vocabulary pronunciation accompanied by the character Tutu Si Tupai Pintar. The Tupai Pintar App has two testing schemes. First, the Tupai Pintar Application has been tested on fifteen objects and has an object detection accuracy of 100%. The Tupai Pintar application has also been tested on elementary school children in grades 3 - 6 and has an average increase in pre-test and post-test scores of two points. This application can add more object datasets and increase interaction between characters and users for further development.},
  keywords={Vocabulary;Technological innovation;Speech recognition;Object detection;Learning (artificial intelligence);Media;Feature extraction;augmented reality;speech recognition;hidden markov model;English vocabulary},
  doi={10.1109/IWAIIP58158.2023.10462739},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9897966,
  author={Gai, Lulu and Chen, Wei and Gao, Rui and Chen, Yan-Wei and Qiao, Xu},
  booktitle={2022 IEEE International Conference on Image Processing (ICIP)}, 
  title={Using Vision Transformers in 3-D Medical Image Classifications}, 
  year={2022},
  volume={},
  number={},
  pages={696-700},
  abstract={Convolutional Neural Networks (CNNs) have been the controlling deep learning approach for a decade in automated medical image diagnosis. Recently, vision transformers (ViTs) have appeared as a competitive alternative to CNNs in computer vision, yielding similar levels of performance while possessing several interesting properties that could prove to be beneficial for the explanation of deep neural networks. Since most medical images are grayscale scans of CT, MRI, etc. and in 3-dimensional (3-D) spaces, which are highly different from natural images, we explore whether it is possible to move to transformer-based models or if we should keep working with CNNs in the domain of 3-D medical image classifi-cations. If so, what are the advantages and drawbacks of switching to ViTs for medical image diagnosis? We consider these problems in a series of experiments on three 3-D medical image datasets. Our findings show that, while CNNs perform better when trained from scratch, ViTs gain strong benifit when pre-trained on ImageNet and outperform their CNN counterparts using self-supervised learning and sharpness-aware minimizer optimization method on the large datasets.},
  keywords={Deep learning;Training;Visualization;Transfer learning;Optimization methods;Self-supervised learning;Transformers;vision transformers;convolutional neural networks;3-D medical image classifications},
  doi={10.1109/ICIP46576.2022.9897966},
  ISSN={2381-8549},
  month={Oct},}@INPROCEEDINGS{10958134,
  author={Dababo, Razan and Wang, Ming-Hwa},
  booktitle={2024 International Conference on Image Processing, Computer Vision and Machine Learning (ICICML)}, 
  title={Speech2Sign with ASL-Transformers and SL-GAN}, 
  year={2024},
  volume={},
  number={},
  pages={965-971},
  abstract={Sign language is an essential means of communication for the deaf and hard-of-hearing, yet its translation and production are uniquely challenging due to its multimodality and the ambiguity of aligning spoken language sentences with visual signs. The objective of automatic Sign Language Production (SLP) is to transform speech into sign language videos that closely match the accuracy and expressiveness of a human interpreter, facilitating communication between the deaf community and the predominantly speaking world. Many prior SLP works have taken a gloss-free approach at the expense of accuracy, or have produced low-quality 2D sign poses as the final output, failing to convey the intricacies of sign language. Contrary to these approaches, we demonstrate the merits of gloss, a well-crafted loss function, and a multi-scale Generative Adversarial Network (GAN) in the production of accurate and photorealistic sign language videos. Our approach is a multistage SLP framework that begins with translating transcribed speech to its written sign language notation (gloss) using our ASL-Transformers model. We then map the gloss to its dictionary sign frames through a database query and generate the corresponding 2D pose sequence with DWPose, a pretrained pose estimator. Finally, we synthesize a photorealistic sign language video from the 2D pose sequence using our SL-GAN, a pose-conditioned image generation model. We evaluate our ASL-Transformers on the ASLG-PC12 dataset, reporting a BLEU-4 score of 89.58, and our SL-GAN on the ASLLVD dataset, reporting a mean SSIM value of 0.921.},
  keywords={Sign language;Visualization;Translation;Accuracy;Dictionaries;Image synthesis;Production;Assistive technologies;Generative adversarial networks;Videos;Sign Language Production;Transformers;Generative Adversarial Network;American Sign Language;Gloss;Pose Estimation;Sign Language Video},
  doi={10.1109/ICICML63543.2024.10958134},
  ISSN={},
  month={Nov},}
