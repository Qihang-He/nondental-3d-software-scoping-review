@INPROCEEDINGS{9301845,
  author={Li, Kang Rong and Hsung, Tai-Chiu and Yeung, Andy W.K. and Bornstein, Michael M.},
  booktitle={2020 IEEE International Conference on Visual Communications and Image Processing (VCIP)}, 
  title={On Segmentation of Maxillary Sinus Membrane using Automatic Vertex Screening}, 
  year={2020},
  volume={},
  number={},
  pages={108-111},
  abstract={The purpose of this study is to develop an automatic technique to segment the membrane of the maxillary sinus with morphological changes (e.g. thickened membrane and cysts) for the detection of abnormalities. The first step is to segment the sinus bone cavity in the CBCT image using fuzzy C-mean algorithm. Then, the vertices of inner bone walls of sinus in the mesh model are screened with vertex normal direction and angular based mean-distance filtering. The resulted vertices are then used to generate the bony sinus cavity mesh model by using Poisson surface reconstruction. Finally, the sinus membrane morphological changes are segmented by subtracting the air sinus segmentation from the reconstructed bony sinus cavity. The proposed method has been applied on 5 maxillary sinuses with mucosal thickening and has demonstrated that it can segment thin membrane thickening (<; 2 mm) successfully within 4.1% and 3.5% error in volume and surface area respectively. Existing methods have issues of leakages at openings and thin bones, and inaccuracy with irregular contours commonly seen in maxillary sinus. The current method overcomes these shortcomings.},
  keywords={Bones;Surface morphology;Surface reconstruction;Image segmentation;Three-dimensional displays;Mathematical model;Dentistry;maxillary sinus membrane segmentation;vertex screening;cone beam computed tomography},
  doi={10.1109/VCIP49819.2020.9301845},
  ISSN={2642-9357},
  month={Dec},}@ARTICLE{11351321,
  author={Guo, Yan and Li, Chenyao and Li, Haitao and Ge, Weiwen and Zeng, Bolun and Liu, Jiaxuan and Wan, Tianhao and Zhang, Shanyong and Chen, Xiaojun},
  journal={IEEE Transactions on Image Processing}, 
  title={Automated Orthognathic Surgery Planning Based on Shape-Aware Morphology Prediction and Anatomy-Constrained Registration}, 
  year={2026},
  volume={35},
  number={},
  pages={629-639},
  abstract={Orthognathic surgery demands precise preoperative planning to achieve optimal functional and aesthetic results, yet current practices remain labor-intensive and highly dependent on surgical expertise. To address these challenge, we propose OrthoPlanner, a novel two-stage framework for automated orthognathic surgical planning. In the first stage, we develop JawFormer, a shape sensitive transformer network that predicts postoperative bone morphology directly from preoperative 3D point cloud data. Built upon a point cloud encoder-decoder architecture, the network integrates anatomical priors through a region-based feature alignment module. This enables precise modeling of structural changes while preserving critical anatomical features. In the second stage, we introduce a symmetry-constrained rigid alignment algorithm that automatically outputs the precise translation and rotation of each osteotomized bone segment required to match the predicted morphology. This ensures bilateral anatomical consistency and facilitates interpretable surgical plans. Compared with existing approaches, our method achieves superior quantitative performance and enhanced visualization results, as demonstrated by 65 experiments on real clinical datasets. Moreover, OrthoPlanner significantly reduces planning time and manual workload, while ensuring reproducible and clinically acceptable outcomes.},
  keywords={Surgery;Planning;Bones;Shape;Morphology;Point cloud compression;Feature extraction;Transformers;Artificial intelligence;Predictive models;Surgical planning;orthognathic surgery;postoperative shape prediction},
  doi={10.1109/TIP.2026.3651981},
  ISSN={1941-0042},
  month={},}@INPROCEEDINGS{10009741,
  author={Su, Minglan and Yang, Mingchuan and Li, Xinchi and Zhang, Chaoying and Liang, Wei and Liu, Qiaoqiao},
  booktitle={2022 International Conference on Image Processing, Computer Vision and Machine Learning (ICICML)}, 
  title={3D Human Reconstruction Combined with Facial Features}, 
  year={2022},
  volume={},
  number={},
  pages={543-546},
  abstract={The Metaverse is a shared virtual space that allows individuals to interact with other users in a digital environment. Therefore, constructing a real 3D human body model in the Metaverse as a mapping of the real world is an indispensable content. It is currently very challenging to accurately and robustly model a 3D human body from a single image. The main problem is how to accurately reconstruct the detailed texture of the character, especially the facial texture that best characterizes the identity of the character. Therefore, we propose a 3D human reconstruction algorithm combined with facial features. By predicting the parameters of the 3DMM model, we construct a 3D facial model, extract the corresponding 3D facial features, and fuse them with the 2D image features to jointly realize the implicit prediction of the 3D human body. The method introduces 3D face model as prior knowledge, which greatly improves the accuracy of 3D human face reconstruction.},
  keywords={Solid modeling;Three-dimensional displays;Metaverse;Biological system modeling;Predictive models;Reconstruction algorithms;Feature extraction;component;Metaverse;3D human reconstruction;facial features},
  doi={10.1109/ICICML57342.2022.10009741},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{9301774,
  author={Tang, Hui and Hsung, Tai-Chiu and Lam, Walter Y.H. and Cheng, Leo Y. Y. and Pow, Edmond H.N.},
  booktitle={2020 IEEE International Conference on Visual Communications and Image Processing (VCIP)}, 
  title={On 2D-3D Image Feature Detections for Image-To-Geometry Registration in Virtual Dental Model}, 
  year={2020},
  volume={},
  number={},
  pages={140-143},
  abstract={3D digital smile design (DSD) gains great interest in dentistry because it enables esthetic design of teeth and gum. However, the color texture of teeth and gum is often lost/distorted in the digitization process. Recently, the image-to-geometry registration shade mapping (IGRSM) method was proposed for registering color texture from 2D photography to 3D mesh model. It allows better control of illumination and color calibration for automatic teeth shade matching. In this paper, we investigate automated techniques to find the correspondences between 3D tooth model and color intraoral photographs for accurately perform the IGRSM. We propose to use the tooth cusp tips as the correspondence points for the IGR because they can be reliably detected both in 2D photography and 3D surface scan. A modified gradient descent method with directional priority (GDDP) and region growing are developed to find the 3D correspondence points. For the 2D image, the tooth tips contour lines are extracted based on luminosity and chromaticity, the contour peaks are then detected as the correspondence points. From the experimental results, the proposed method shows excellent accuracy in detecting the correspondence points between 2D photography and 3D tooth model. The average registration error is less than 15 pixels for 4752×3168 size intraoral image.},
  keywords={Teeth;Three-dimensional displays;Two dimensional displays;Image color analysis;Dentistry;Surface morphology;Solid modeling;3D digital smile design;Image to geometry registration;Tooth Shade;Intraoral scan;Range Image},
  doi={10.1109/VCIP49819.2020.9301774},
  ISSN={2642-9357},
  month={Dec},}@ARTICLE{9487491,
  author={Andlauer, Robin and Wachter, Andreas and Schaufelberger, Matthias and Weichel, Frederic and Kühle, Reinald and Freudlsperger, Christian and Nahm, Werner},
  journal={IEEE Transactions on Image Processing}, 
  title={3D-Guided Face Manipulation of 2D Images for the Prediction of Post-Operative Outcome After Cranio-Maxillofacial Surgery}, 
  year={2021},
  volume={30},
  number={},
  pages={7349-7363},
  abstract={Cranio-maxillofacial surgery often alters the aesthetics of the face which can be a heavy burden for patients to decide whether or not to undergo surgery. Today, physicians can predict the post-operative face using surgery planning tools to support the patient’s decision-making. While these planning tools allow a simulation of the post-operative face, the facial texture must usually be captured by another 3D texture scan and subsequently mapped on the simulated face. This approach often results in face predictions that do not appear realistic or lively looking and are therefore ill-suited to guide the patient’s decision-making. Instead, we propose a method using a generative adversarial network to modify a facial image according to a 3D soft-tissue estimation of the post-operative face. To circumvent the lack of available data pairs between pre- and post-operative measurements we propose a semi-supervised training strategy using cycle losses that only requires paired open-source data of images and 3D surfaces of the face’s shape. After training on “in-the-wild” images we show that our model can realistically manipulate local regions of a face in a 2D image based on a modified 3D shape. We then test our model on four clinical examples where we predict the post-operative face according to a 3D soft-tissue prediction of surgery outcome, which was simulated by a surgery planning tool. As a result, we aim to demonstrate the potential of our approach to predict realistic post-operative images of faces without the need of paired clinical data, physical models, or 3D texture scans.},
  keywords={Faces;Three-dimensional displays;Surgery;Planning;Predictive models;Tools;Solid modeling;Cranio-maxillofacial surgery;post-operative face;surgery planning;face manipulation;face editing;generative adversarial network;CycleGAN;cycle loss;GAN;unsupervised learning;3D morphable model},
  doi={10.1109/TIP.2021.3096081},
  ISSN={1941-0042},
  month={},}@INPROCEEDINGS{11084585,
  author={Yan, Peizhi and Ward, Rabab and Tang, Qiang and Du, Shan},
  booktitle={2025 IEEE International Conference on Image Processing (ICIP)}, 
  title={Estimating Virtual Camera FOV to Reduce Perspective Shape Distortion in 2D-to-3D Face Reconstruction}, 
  year={2025},
  volume={},
  number={},
  pages={199-204},
  abstract={Existing image-based 3D face reconstruction methods rely on a virtual camera to project the reconstructed 3D face onto the 2D image plane for comparison with the input image, a crucial step for accurate results. To simplify the reconstruction process, these methods often use fixed camera intrinsics and assume minimal perspective distortion, overlooking the varying distortion levels in "in-the-wild" images and leading to inaccuracies in reconstructed 3D face shapes. To address this issue, we propose estimating the virtual camera’s optimal field-of-view (FOV) for a given image, enabling consistent 3D face reconstruction across varying distortion levels. We introduce two synthetic datasets: one to train our FOV estimation network (FOV-Net) and another to evaluate its performance and reconstruction accuracy. We use the FOV-Net predicted FOV to initialize the camera, which is used in the fitting-based reconstruction process. Experiments show that our approach significantly improves reconstruction consistency under different levels of perspective distortion.},
  keywords={Three-dimensional displays;Accuracy;Shape;Estimation;Reconstruction algorithms;Distortion;Cameras;Image reconstruction;Faces;Synthetic data;Camera Field-of-View;Perspective Distortion;2D-to-3D Face Reconstruction;Synthetic Data},
  doi={10.1109/ICIP55913.2025.11084585},
  ISSN={2381-8549},
  month={Sep.},}@ARTICLE{9381604,
  author={Guo, Yudong and Cai, Lin and Zhang, Juyong},
  journal={IEEE Transactions on Image Processing}, 
  title={3D Face From X: Learning Face Shape From Diverse Sources}, 
  year={2021},
  volume={30},
  number={},
  pages={3815-3827},
  abstract={We present a novel method to jointly learn a 3D face parametric model and 3D face reconstruction from diverse sources. Previous methods usually learn 3D face modeling from one kind of source, such as scanned data or in-the-wild images. Although 3D scanned data contain accurate geometric information of face shapes, the capture system is expensive and such datasets usually contain a small number of subjects. On the other hand, in-the-wild face images are easily obtained and there are a large number of facial images. However, facial images do not contain explicit geometric information. In this paper, we propose a method to learn a unified face model from diverse sources. Besides scanned face data and face images, we also utilize a large number of RGB-D images captured with an iPhone X to bridge the gap between the two sources. Experimental results demonstrate that with training data from more sources, we can learn a more powerful face model.},
  keywords={Faces;Three-dimensional displays;Solid modeling;Image reconstruction;Data models;Face recognition;Shape;Face modeling;shape from X;3D face reconstruction},
  doi={10.1109/TIP.2021.3065798},
  ISSN={1941-0042},
  month={},}@INPROCEEDINGS{10586613,
  author={Cen, Mengyue and Shen, Haoran and Zhao, Wangyan and Pan, Dingcheng and Feng, Xiaoyi},
  booktitle={2024 3rd International Conference on Image Processing and Media Computing (ICIPMC)}, 
  title={A Survey of Text-guided 3D Face Reconstruction}, 
  year={2024},
  volume={},
  number={},
  pages={82-87},
  abstract={Text-guided 3D face reconstruction is an emerging field that leverages artificial intelligence to generate detailed and animatable 3D facial models from textual descriptions. This technology holds promise for revolutionizing digital content creation, avatar design, and virtual interaction by allowing users to convert textual imaginations into realistic 3D representations. This survey paper provides a comprehensive overview of the state-of-the-art methods in text-guided 3D face reconstruction, including ClipFace, DreamFace, TG-3DFace, and E3-FaceNet. We discuss their unique features, advantages, limitations, and the innovative techniques they employ to bridge the gap between natural language and 3D visual space. We also highlight the challenges that remain, such as achieving high fidelity and efficiency in the rendering process, and the potential for future advancements in this domain.},
  keywords={Surveys;Solid modeling;Visualization;Three-dimensional displays;Computational modeling;Natural languages;Transforms;artificial intelligence;3D face reconstruction;text-guided;development},
  doi={10.1109/ICIPMC62364.2024.10586613},
  ISSN={},
  month={May},}@INPROCEEDINGS{10222432,
  author={Yan, Peizhi and Ward, Rabab and Wang, Dan and Tang, Qiang and Du, Shan},
  booktitle={2023 IEEE International Conference on Image Processing (ICIP)}, 
  title={Learning Disentangled Features for Nerf-Based Face Reconstruction}, 
  year={2023},
  volume={},
  number={},
  pages={1135-1139},
  abstract={The 3D-aware parametric face model named HeadNeRF achieved advantages in rendering photo-realistic face images. However, it has two limitations: (1) it uses single-image fitting reconstruction that is slow and prone to overfitting; (2) it lacks explicit 3D geometry information, making using semantic facial-parts-based loss challenging. This paper presents a 3D-aware face reconstruction learning framework tailored for HeadNeRF to address the limitations. We train a face encoder network that can directly learn the disentangled features for facial reconstruction to address the first limitation. For the second limitation, we introduce a lightweight semantic face segmentation network and facial-parts-based loss function to improve the reconstruction accuracy and quality. Our experiments show that the proposed method achieves a low reconstruction time consumption and enhanced reconstruction accuracy. Project page: https://peizhiyan.github.io/docs/headnerf+},
  keywords={Geometry;Three-dimensional displays;Codes;Semantics;Fitting;Rendering (computer graphics);Computational efficiency;3D-aware face reconstruction;neural radiance fields (NeRF);parametric face model},
  doi={10.1109/ICIP49359.2023.10222432},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{9897964,
  author={Tang, Chia-Hao and Hsu, Gee-Sern Jison and Tai, Ting-Yu},
  booktitle={2022 IEEE International Conference on Image Processing (ICIP)}, 
  title={Graph Refinement with Regression Prior for 3D Face Reconstruction}, 
  year={2022},
  volume={},
  number={},
  pages={2436-2440},
  abstract={We propose the Graph Refinement with Regression Prior (GRRP) framework for 3D face reconstruction. The GRRP framework is composed of two component networks, namely the 3D Face Regressor and the Graph-Convolutional Refining (GCR) Network. The 3D Face Regressor is made of a face reconstruction pre-trained model, which is not updated during training and offers a pseudo target to guide the training of the GCR. The GCR proposed to design the graph-refining architecture with appropriate graph convolutional settings for enhancing 3D reconstruction accuracy. Apart from the network design, we also highlight the influences of two objective functions, the adaptive vertex loss and surface normal loss, and point out the difficulty of generating 3D faces of local details. The adaptive vertex loss is designed to adaptively optimize the local facial meshes so that the local undesired vertices can be rectified while the global mesh can be kept, and the surface normal loss is designed to eliminate the flying vertices problem of the generated shape surface. The proposed framework is verified through the experiments on the AFLW2000-3D and MICC Florence datasets and compared with contemporary approaches for evaluation.},
  keywords={Training;Surface reconstruction;Three-dimensional displays;Adaptive systems;Shape;Refining;Task analysis},
  doi={10.1109/ICIP46576.2022.9897964},
  ISSN={2381-8549},
  month={Oct},}@INPROCEEDINGS{11321181,
  author={Ju, Xiangyang and Ayoub, Ashraf and Morley, Stephen},
  booktitle={2025 3rd International Conference on Computer Graphics and Image Processing (CGIP)}, 
  title={Assessment of The Expressions of Facial Paralysis Using PointNet: A Deep Learning Approach for 3D Facial Point Cloud Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={9-13},
  abstract={A dynamic 3D stereo photogrammetry imaging system has been applied to assess the facial paralysis objectively. 16 facial paralysis patients and 16 health participants were recruited for this study. Their facial expressions of the eyebrow raising, eye closure, smiling, cheek puff and lip pucker were captured by the imaging system. In this study, the point clouds of the rest expressions and the maximal expressions and the corresponding facial paralysis grades were used to train PointNet to predict the grades of facial paralysis. The approach took advantages of the full field facial movement tracking and 3D point cloud PointNet to predict the grades of the expressions of facial paralysis. The results showed a higher than 95% accuracy of grading.},
  keywords={Point cloud compression;Three-dimensional displays;Tracking;Lips;Image processing;Facial expressions;Imaging;Paralysis;Eyebrows;Photogrammetry;facial paralysis;pointNet;3d photogrammetry},
  doi={10.1109/CGIP66596.2025.00010},
  ISSN={},
  month={July},}@INPROCEEDINGS{9190979,
  author={Tian, Xin and Chen, Wei and Zhao, Fang and Li, Bo and Wang, Zhongyuan},
  booktitle={2020 IEEE International Conference on Image Processing (ICIP)}, 
  title={Robust CBCT Reconstruction Based On Low-Rank Tensor Decomposition And Total Variation Regularization}, 
  year={2020},
  volume={},
  number={},
  pages={330-334},
  abstract={Cone-beam computerized tomography (CBCT) has been widely used in numerous clinical applications. To reduce the effects of X-ray on patients, a low radiation dose is always recommended in CBCT. However, noise will seriously degrade image quality under a low dose condition because the intensity of the signal is relatively low. In this study, we propose to use the Huber loss function as a data fidelity term in CBCT reconstruction, making the reconstruction robust to impulse noise under low radiation dose condition. Furthermore, a low-rank tensor property is adopted as the prior term. Such property is helpful in recovering the missing structure information caused by impulse noise. The proposed CBCT reconstruction model is formulated by further integrating a 3D total variation term for reducing Gaussian noise. An alternative direction multiplier method is adopted to solve the optimization problem. Experiments on simulated and real data show that the proposed model outperforms existing CBCT reconstruction algorithms.},
  keywords={Image reconstruction;TV;Tensile stress;Three-dimensional displays;Two dimensional displays;Robustness;Gaussian noise;CBCT;Huber loss function;low rank;tensor decomposition;total variation},
  doi={10.1109/ICIP40778.2020.9190979},
  ISSN={2381-8549},
  month={Oct},}@INPROCEEDINGS{10222556,
  author={Díaz Barros, Jilliam María and Wang, Chen-Yu and Stricker, Didier and Rambach, Jason},
  booktitle={2023 IEEE International Conference on Image Processing (ICIP)}, 
  title={Confidence-Aware Clustered Landmark Filtering For Hybrid 3D Face Tracking}, 
  year={2023},
  volume={},
  number={},
  pages={2945-2949},
  abstract={The detection of facial landmarks in 2D images has received a great attention in the last decade, as it is a key step for several computer-vision-related applications. Most of the approaches are focused on still images, and are extended to videos by using a tracking-by-detection scheme. In this work, we propose a frame-to-frame tracking module based on grouped-landmark Kalman filters that can be integrated into existing deep-learning-based 3D face alignment pipelines. This method improves the landmark accuracy in cases with large occlusion, extreme head poses and blurriness that affect existing approaches. Our experiments on the Menpo 3DA-2D benchmark show improvements on model-free and 3D-model-based face alignment approaches.},
  keywords={Uncertainty;Three-dimensional displays;Filtering;Image processing;Pipelines;Benchmark testing;Kalman filters;Face alignment;tracking;landmarks;Kalman filter},
  doi={10.1109/ICIP49359.2023.10222556},
  ISSN={},
  month={Oct},}@ARTICLE{9266055,
  author={Nikan, Soodeh and Van Osch, Kylen and Bartling, Mandolin and Allen, Daniel G. and Rohani, S. Alireza and Connors, Ben and Agrawal, Sumit K. and Ladak, Hanif M.},
  journal={IEEE Transactions on Image Processing}, 
  title={PWD-3DNet: A Deep Learning-Based Fully-Automated Segmentation of Multiple Structures on Temporal Bone CT Scans}, 
  year={2021},
  volume={30},
  number={},
  pages={739-753},
  abstract={The temporal bone is a part of the lateral skull surface that contains organs responsible for hearing and balance. Mastering surgery of the temporal bone is challenging because of this complex and microscopic three-dimensional anatomy. Segmentation of intra-temporal anatomy based on computed tomography (CT) images is necessary for applications such as surgical training and rehearsal, amongst others. However, temporal bone segmentation is challenging due to the similar intensities and complicated anatomical relationships among critical structures, undetectable small structures on standard clinical CT, and the amount of time required for manual segmentation. This paper describes a single multi-class deep learning-based pipeline as the first fully automated algorithm for segmenting multiple temporal bone structures from CT volumes, including the sigmoid sinus, facial nerve, inner ear, malleus, incus, stapes, internal carotid artery and internal auditory canal. The proposed fully convolutional network, PWD-3DNet, is a patch-wise densely connected (PWD) three-dimensional (3D) network. The accuracy and speed of the proposed algorithm was shown to surpass current manual and semi-automated segmentation techniques. The experimental results yielded significantly high Dice similarity scores and low Hausdorff distances for all temporal bone structures with an average of 86% and 0.755 millimeter (mm), respectively. We illustrated that overlapping in the inference sub-volumes improves the segmentation performance. Moreover, we proposed augmentation layers by using samples with various transformations and image artefacts to increase the robustness of PWD-3DNet against image acquisition protocols, such as smoothing caused by soft tissue scanner settings and larger voxel sizes used for radiation reduction. The proposed algorithm was tested on low-resolution CTs acquired by another center with different scanner parameters than the ones used to create the algorithm and shows potential for application beyond the particular training data used in the study.},
  keywords={Image segmentation;Bones;Computed tomography;Shape;Biomedical imaging;Training;Three-dimensional displays;Temporal bone CT;fully-automated segmentation;multi-structure;patch-wise;balanced-weighting;PWD-3DNet},
  doi={10.1109/TIP.2020.3038363},
  ISSN={1941-0042},
  month={},}@INPROCEEDINGS{10871141,
  author={Kamran, Muhammad and Waseem, Muhammad and Shafi, Numan and Zahid, Abdullah},
  booktitle={2024 18th International Conference on Open Source Systems and Technologies (ICOSST)}, 
  title={Detection of Caries and Hypodontia using Deep Learning and Explainable AI}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={In today's world of technology breakthroughs, incorporating cutting-edge procedures has become essential, especially in healthcare, where an early and precise diagnosis is critical for improving patient outcomes and saving lives. Dental caries is an infectious bacterial disease primarily caused by the interaction of oral bacteria with dietary sugars, leading to plaque formation on teeth. Millions of people worldwide are facing this disease. Hypodontia is another dental term that healthcare providers use to describe congenitally missing teeth. We employed an AI-driven healthcare solution by utilizing a transformer-based image classification model, Vision Transformer (VIT), for the detection of dental caries and hypodontia. A dataset containing both periapical and panoramic dental x-rays utilized to gain maximum insights into teeth. The dataset was divided into 60% for training, 20% for testing, and 20% for validation. Data augmentation techniques are applied to enhance the diversity of training data and mitigate overfitting. The proposed model demonstrated remarkable performance and achieved an accuracy of 96.63% with evaluation matrices Precision, Recall, and F1-score of 96.60, 96.63, and 96.57 % respectively. Unlike Convolutional Neural Networks (CNN) which are black boxes, we utilized the Explainable Artificial Intelligence (XAI) models such as LIME, SHAP, and GRAD-CAM to gain insights into the inner workings of the VIT model. The XAI models contributed to fostering trust among medical dentists and medical professionals.},
  keywords={Accuracy;Explainable AI;Teeth;X-rays;Transformers;Data augmentation;Dentistry;Convolutional neural networks;Medical diagnostic imaging;Diseases;Dental Diseases;Caries Detection;Hypodontia;Vision Transformer;Explainable Artificial Intelligence (XAI)},
  doi={10.1109/ICOSST64562.2024.10871141},
  ISSN={2770-8225},
  month={Dec},}@INPROCEEDINGS{11284310,
  author={Shime, Nozomi and Ishida, Takayuki and Kamiya, Tohru},
  booktitle={2025 10th International Conference on Biomedical Signal and Image Processing (ICBIP)}, 
  title={Extraction of Cervical Lymph Nodes Based on Improved U-Net++ Incorporated Attention Module}, 
  year={2025},
  volume={},
  number={},
  pages={82-86},
  abstract={One of the difficulties in cancer treatment is cancer metastasis. The neck is sometimes swollen due to swelling in the lymph nodes, which may be closely related to cancer metastasis. The diagnosis of swollen lymph nodes in the neck is usually made by CT imaging. However, CT has problems such as increased physician workload and inconsistent diagnostic results. Computer-aided diagnosis (CAD) system can solve these problems. In this paper, we propose a segmentation method for cervical lymph nodes. In our previous study, we proposed a cervical lymph node extraction method using an improved CNN. However, (i)incorrect extraction of blood vessels that closely resemble the shape of cervical lymph nodes and (ii)failure to extract microscopic lymph nodes remained as problems. In this paper, we propose an improved CNN model with an attention module and a new attention module to be added to the network, considering the suppression of feature responses in background regions and the enhancement of feature responses in small target regions. The proposed method was applied to CT images of the neck of 11 patients, and the performance was evaluated, and IoU (Intersection over Union) of $\mathbf{0. 6 4 0}$ was obtained.},
  keywords={Solid modeling;Shape;Computed tomography;Semantic segmentation;Logic gates;Feature extraction;Neck;Metastasis;Lymph nodes;Biomedical imaging;computer aided diagnosis;cervical lymph node;semantic segmentation;convolutional neural network;U-Net++;attention module;CBAM;attention gates},
  doi={10.1109/ICBIP66535.2025.11284310},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10709201,
  author={Wang, Hanfang and Tao, Tao and Zhang, Hui and Yao, Chao},
  booktitle={2024 IEEE 2nd International Conference on Image Processing and Computer Applications (ICIPCA)}, 
  title={Vision-Guided Nucleic Acid Detection and Sampling Robot}, 
  year={2024},
  volume={},
  number={},
  pages={835-840},
  abstract={At present, the main method of nucleic acid sampling is oral throat swab sampling. In the process of nucleic acid detection throat swab sampling, medical staff need to be in close contact with the patient, and a large number of droplets or aerosols will be produced when the patient coughs and breathes hard, which will greatly increase the risk of cross-infection among medical staff in the sampling process. Robot technology and computer vision technology can restore the artificial nucleic acid detection scene, and on the premise of ensuring the detection accuracy and efficiency, it can effectively reduce the social labor cost of traditional nucleic acid detection methods. In this paper, based on the actual process of nucleic acid detection and sampling, combined with the application prospect and difficulties of robot technology in throat swab sampling, a target detection model of nucleic acid detection and sampling robot based on vision guidance is proposed. In this model, SSD algorithm (Single Shot Multi-Box Detector) based on attention mechanism is used to identify and locate tonsil region, and nucleic acid sampling and detection of human oral and respiratory throat swabs are realized under visual guidance. The experimental results show that the sampling robot designed in this paper has high detection efficiency and accuracy, which can provide technical support for the design of nucleic acid detection sampling robot.},
  keywords={Epidemics;Visualization;Accuracy;Hospitals;Prevention and mitigation;Image processing;Object detection;Detectors;Robots;Intelligent robots;Nucleic acid detection;Sampling robot;Machine vision},
  doi={10.1109/ICIPCA61593.2024.10709201},
  ISSN={},
  month={June},}@INPROCEEDINGS{11284449,
  author={Sakata, Keisuke and Kamiya, Tohru and Oda, Masafumi and Morimoto, Yasuhiro},
  booktitle={2025 10th International Conference on Biomedical Signal and Image Processing (ICBIP)}, 
  title={Identification of Root Resorption from Panoramic Xray Images Based on Deep Metric Learning and Multi-View Feature Integration}, 
  year={2025},
  volume={},
  number={},
  pages={60-63},
  abstract={Root resorption is a condition in which the cementum and dentin of the tooth are resorbed, resulting in the loss of the root structure. If left untreated, it can lead to tooth loss, so early detection is critical. Computed tomography (CT) scans are used for definitive diagnosis of root resorption; however, the availability of CT equipment is limited, and the cost of imaging is high. Therefore, there is a growing demand for the development of computer-aided diagnosis (CAD) systems that can identify root resorption using more widely available panoramic X-ray images. However, distinguishing root resorption on panoramic radiographs is challenging even for experienced clinicians. In this study, we classify root resorption in panoramic radiographs using feature extraction with EfficientNet and distance learning with ArcFace (Additive Angular Margin Loss for Deep Face Recognition). Furthermore, since the quality of panoramic radiographs varies due to different imaging conditions, we introduce super-resolution as a preprocessing step to improve the stability of learning. In addition, to address the instability of the evaluation loss, we employ ensemble learning and test-time augmentation (TTA), where multiple augmented versions of the same image from different angles are used during training to improve robustness. To evaluate the effectiveness of the proposed method, we performed a fivefold cross-validation using panoramic radiographs from 227 cases. The results showed an accuracy of 80.8%, TPR (true positive rate) of 89.5%, and FPR (false positive rate) of 32.7%, demonstrating improved classification performance compared to conventional methods using single images.},
  keywords={Measurement;Deep learning;Training;Accuracy;Computed tomography;Superresolution;Teeth;Feature extraction;Stability analysis;X-ray imaging;root resorption;EfficientNet;ArcFace;X-ray image;computer aided diagnosis;test time augmentation;ensemble;BSRGAN},
  doi={10.1109/ICBIP66535.2025.11284449},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10462739,
