   Teixeira, Liliana/G-6293-2011
   Leijten, Jeroen/G-5311-2011},
ORCID-Numbers = {Moreira Teixeira, Liliana/0000-0001-5039-8369
   Gomes, Nuno/0000-0003-1459-7592
   van den Beucken, Jeroen/0000-0002-0301-1966
   Conceição, Francisco/0000-0003-4587-2470
