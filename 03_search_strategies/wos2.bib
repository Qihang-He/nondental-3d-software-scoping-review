   Amirali},
Title = {Computer-aided design and additively manufactured resin-bonded framework
   to retain an existing ceramic crown as the interim restoration after
   extraction: A dental technique},
Journal = {JOURNAL OF PROSTHETIC DENTISTRY},
Year = {2024},
Volume = {132},
Number = {1},
Pages = {42-45},
Month = {JUL},
Abstract = {A novel way to use the patient `s existing ceramic crown from a
   nonrestorable maxillary anterior tooth as part of the interim
   restoration after extraction is described. The crown was fixed
   intraorally with a digitally designed and 3D printed resin -bonded fixed
   dental prosthesis framework in its pre -extraction position. The
   procedure maintained esthetics, optimized softtissue management, and
   provided a fixed prosthesis before implant placement in the esthetic
   zone. (J Prosthet Dent 2024;132:42-5)},
