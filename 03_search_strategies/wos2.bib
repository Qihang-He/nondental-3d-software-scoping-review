Volume = {125},
Number = {3},
Pages = {387-391},
Month = {MAR},
Abstract = {A method for creating a complete-arch digital trial tooth arrangement
   for completely edentulous patients is described. The technique
   demonstrates an effective way to reproduce the dental and gingival
   anatomies by using a free 3D modeling software program. This
   cost-effective, timesaving, and versatile method allows dental
   professionals to digitally plan challenging treatments for completely
   edentulous patients. The technique can also be used to fabricate
   diagnostic prostheses and implant-supported interim prostheses. (J
   Prosthet Dent 2021;125:387-91)},
