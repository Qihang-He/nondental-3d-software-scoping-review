@ARTICLE{10601639,
  author={Zhao, Meihua and Xiong, Gang and Fang, Qihang and Dong, Xisong and Wang, Fang and Han, Yunjun and Shen, Zhen and Wang, Fei-Yue},
  journal={IEEE Transactions on Computational Social Systems}, 
  title={Enlarge the Error Prediction Dataset in 3-D Printing: An Unsupervised Dental Crown Mesh Generator}, 
  year={2024},
  volume={11},
  number={6},
  pages={7929-7940},
  abstract={The quality of the dataset is critical to the performance of neural networks for error prediction in 3-D printing. In order to enlarge the dataset, we propose a customized two-stage framework, cascaded cross-modality generative adversarial networks (CCMGANs), for generating dental crown meshes in an unsupervised manner. At the first stage, a displacement map-guided generative adversarial network (GAN) is used to generate coarse meshes with diverse shapes. At the second stage, fine-grained details are added to the coarse meshes using an image-based GAN. Unlike previous work that integrates a differentiable renderer into the mesh deformation process directly, we adopt a two-step strategy. First, we use a depth image refinement module to achieve the domain transformation from the rendered depth images of the generated meshes to those of the real ones. Then, we propose a mesh refinement module to optimize the coarse meshes in an image-supervised manner. To alleviate the self-intersection problem, we propose a loss to penalize the distances of point pairs in self-intersection regions. Experimental results show that our method is able to generate highly realistic meshes and outperforms the state-of-the-art point cloud generation method TreeGCN in terms of the metrics FDD, MMD-CD, MMD-EMD, and COV-EMD. Furthermore, we utilize the generated data to augment the original dataset, and demonstrate that the generated data can effectively improve the accuracy of the error prediction task in 3-D printing.},
  keywords={Generative adversarial networks;Point cloud compression;Dentistry;Task analysis;Deformation;Three-dimensional printing;3-D printing;depth image refinement (DR);displacement map (DM);generative adversarial network (GAN);mesh refinement},
  doi={10.1109/TCSS.2024.3417388},
  ISSN={2329-924X},
  month={Dec},}@INPROCEEDINGS{11374695,
  author={S, Anbalagan},
  booktitle={2025 Tenth International Conference on Science Technology Engineering and Mathematics (ICONSTEM)}, 
  title={InceptionNet-Based AI Approach for Precise Classification and Diagnosis of Mouth Ulcers Leveraging Clinical Data}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Mouth ulcers are common oral mucosal diseases, which commonly confound clinical diagnosis because of similar clinical appearances with more serious pathology. In order to overcome this weakness, a sophisticated artificial intelligence framework, InceptionNet, was created to ensure accurate classification and diagnosis of mouth ulcers with a combination of clinical and image data. The data set consisted of annotated oral lesion pictures, demographical data, and symptoms, which was processed and enhanced to improve the model generalization. The architecture of InceptionNet was adjusted and verified on a stratified 80:20 data split. Findings have shown that the diagnostic accuracy of 98.4 % is higher, and the sensitivity, specificity, and F1-score are higher than 97 %, which beats the best traditional CNN and VGG architectures. Grad-CAM visualization ensured the ability of the model to localize the ulcer areas efficiently. Generally, the proposed InceptionNet-based system is a strong, understandable, and clinically feasible early mouth ulcer diagnostic instrument that can likely enhance oral healthcare results and decrease diagnostic bias.},
  keywords={Deep learning;Visualization;Accuracy;Sensitivity;Mouth;Data models;Skin;Lesions;Artificial intelligence;Diseases;Mouth ulcer diagnosis;InceptionNet;Deep learning;Clinical data integration;Medical image classification},
  doi={10.1109/ICONSTEM65670.2025.11374695},
  ISSN={2996-2986},
  month={Nov},}@INPROCEEDINGS{11380759,
  author={Ramar, Vijai Anand and Kumar Kolli, Yashwant and Radhakrishnan, Priyadarshini and Induru, Venkataramesh and Kushala, Karthik and Pravin Kumar, S K},
  booktitle={2025 5th International Conference on Ubiquitous Computing and Intelligent Information Systems (ICUIS)}, 
  title={Hybrid Deep Learning Model for Brain Tumor Prediction}, 
  year={2025},
  volume={},
  number={},
  pages={40-46},
  abstract={Deep learning-based brain tumor prediction has been in high demand in medical diagnosis because of its ability for early detection and correct classification. This paper presents a record-breaking deep learning model that combines ShuffleNet for feature extraction, Mean Shift Clustering for tumor segmentation, Histogram Equalization for contrast enhancement, the Artificial Bee Colony (ABC) Algorithm for hyperparameter optimization, and Sparse Feature Encoding for dimensionality reduction. Hybrid approach greatly enhances the accuracy of classification by 98.1% accuracy, 97.5% precision, 98.3% recall, and 97.9% F1-score. Comparative evaluation determines that the suggested model outperforms other approaches when compared. Conclusions validate stability, effectiveness, and applicability of the suggested model for usage in real-world medical situations for enhanced tumor detection, diagnostic rate, and enhanced patient outcomes.},
  keywords={Deep learning;Solid modeling;Histograms;Accuracy;Computational modeling;Brain tumors;Feature extraction;Brain modeling;Artificial bee colony algorithm;Encoding;Brain Tumor Prediction;Deep Learning;MRI;ShuffleNet;Mean Shift Clustering;Histogram Equalization;ABC Algorithm;Sparse Feature Encoding;Feature Extraction;Tumor Segmentation;CAD;CNNs;Tumor Classification},
  doi={10.1109/ICUIS67429.2025.11380759},
  ISSN={},
  month={Nov},}@ARTICLE{10274698,
  author={Chen, Sheng},
  journal={IEEE Transactions on Instrumentation and Measurement}, 
  title={Calibration of Intraoral 3-D Measurement System With Using Consummated Model Combined With Highly Accurate Data Pairs}, 
  year={2023},
  volume={72},
  number={},
  pages={1-13},
  abstract={Direct digital impressions can be obtained using intraoral 3-D scanners. Among them, the fringe projection profilometry (FPP)-based intraoral scanner serves as a micro-3D imaging system. Here, proper calibration is critical for highly accurate digital impressions. However, due to its miniaturized structure, some of the designed geometric parameters are difficult to be attained in factory assembly using model-based reconstruction. Moreover, the angle of the structured light is typically small to avoid shadows of the dental sulcus. Consequently, even a small error in detecting stripe feature within the FPP image is magnified in the reconstructed 3-D point. Thus, it is challenging to achieve proper calibration and meet the accuracy requirements of an intraoral 3-D scanner. In this study, we introduce a consummated calibration model, by importing all the geometric parameters to compensate for assembly errors. A subpixel cross-center detection algorithm is proposed to prepare the data pairs for optimization of parameters in the calibration model. All parameters are optimized using the Levenberg–Marquardt algorithm. A 3-D lookup table (LUT) is used to refine the reconstructed 3-D points. Excellent calibration results were achieved, demonstrating a precision of  $15 \mu \text{m}$  for 3-D teeth impression.},
  keywords={Three-dimensional displays;Calibration;Cameras;Optical distortion;Lenses;Optical imaging;Optical sensors;3-D measurement;fringe projection;intraoral},
  doi={10.1109/TIM.2023.3323007},
  ISSN={1557-9662},
  month={},}@INPROCEEDINGS{10687893,
  author={Khan, Irfan and Anjimoon, Shaik and Asha, V and Singla, Atul and Akhil, P. and Alsultany, Nahed Mahmood Ahmed},
  booktitle={2024 OPJU International Technology Conference (OTCON) on Smart Computing for Innovation and Advancement in Industry 4.0}, 
  title={Advancing Wire Arc Additive Manufacturing: A New Era of Precision and Efficiency in Large Metal Component Production}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={A comprehensive Wire Arc Additive Manufacturing (WAAM) approach that employs five algorithms to improve massive metal components is described in this research. The adaptive layer thickness control algorithm adjusts layer thickness based on real-time complexity. This ensures additive manufacturing accuracy throughout. Also, the Material Versatility Optimization Algorithm simplifies working with multiple materials, making casting more efficient. The Intelligent Path Planning Algorithm allocates the robotic arm’s movement to traverse the shortest distance and uniformly distribute heat during deposition. The MultiMaterial-Materialon Strategy Algorithm improves material amounts, making WAAM more usable for additional materials. The Real-Time Excellent Assurance Algorithm constantly examines and adjusts parameters to ensure excellent production. A complete analysis of research reveals how algorithms are related and how vital they are for accuracy, speed, and flexibility. Testing shows that the recommended technique controls layer thickness, material variety, deposition velocity, accuracy, energy efficiency, and real-time tracking better than typical WAAM methods. Figures 6, 7, and 8 indicate that the proposed method delivers superior results across several criteria. The recommended WAAM approach can create more massive metal components by fundamentally changing how things are done. This research provides a comprehensive additive manufacturing approach to solve numerous large-scale metal production issues.},
  keywords={Technological innovation;Accuracy;Metals;Production;Three-dimensional printing;Real-time systems;Path planning;Adaptive Layer Thickness Control Algorithm;Material Versatility Optimization Algorithm;Intelligent Path Planning Algorithm;Multi-Material Deposition Strategy Algorithm;Real-time Quality Assurance Algorithm;Wire Arc Additive Manufacturing (WAAM)},
  doi={10.1109/OTCON60325.2024.10687893},
  ISSN={},
  month={June},}@INPROCEEDINGS{10073817,
  author={Sarkar, Priya and Saha, Ashim},
  booktitle={2023 Third International Conference on Artificial Intelligence and Smart Energy (ICAIS)}, 
  title={Review of Artificial Intelligence methods for detecting cancer in medical image processing}, 
  year={2023},
  volume={},
  number={},
  pages={636-640},
  abstract={Cancer is the unchecked spread of aberrant cells throughout the body. Cancer is a general word for a set of diseases brought on by the growth of abnormal cells in various bodily parts. Lung cancer, breast cancer, skin cancer, oral cancer, colon cancer, and prostate cancer are just a few of the more than a hundred different forms of cancer. Delays in treatment might result in major health problems and even death. This research reviews strategies for detecting liver, brain, and lung cancer using image processing. Automated and computer-aided detection systems (CAD) with artificial intelligence are the approaches utilized for detection, and these systems are good at processing big datasets to produce accurate and effective results in the detection of cancer. To be compatible with AI, these processing systems must overcome numerous obstacles, including picture capture, pre-processing, data management, segmentation, and classification algorithms. The numerous picture acquisition and segmentation approaches are reviewed in this work. These methods are now essential to meet the needs of the expanding patient population and to improve the healthcare system.},
  keywords={Image segmentation;Sociology;Lung cancer;Liver;Medical services;Artificial intelligence;Statistics;Cancer;Pre-processing;Segmentation;Classification},
  doi={10.1109/ICAIS56108.2023.10073817},
  ISSN={},
  month={Feb},}@ARTICLE{11435599,
  author={Guan, Jiahui and Yao, Lantian and Xie, Peilin and Zhao, Zhihao and Meng, Dian and Chen, Zimeng and Lee, Tzong-Yi and Chiang, Ying-Chih and Wang, Junwen},
  journal={IEEE Journal of Biomedical and Health Informatics}, 
  title={GeoCTP: Structure-aware Prediction of Multifunctional Cancer Therapy Peptides via Graph Transformer and Contrastive Learning}, 
  year={2026},
  volume={},
  number={},
  pages={1-15},
  abstract={Cancer therapy peptides (CTPs), as multifunctional peptides, possess the ability to target cancer cells or related proteins, exhibiting significant therapeutic potential. However, traditional experimental screening methods are time-consuming and labor-intensive, limiting the pace of discovery. To address this challenge, we propose GeoCTP, a geometric deep learning framework that integrates both sequence and structural information for accurate CTP prediction. Specifically, GeoCTP employs ESMfold to generate peptide 3D structures and utilizes a Graph Transformer to extract structure-aware representations. For semantic feature extraction from sequences, the ESM-2 language model is adopted. Additionally, a two-level contrastive learning strategy is employed to enhance feature alignment across modalities and improve inter-class discriminability. Experimental results indicate that GeoCTP outperforms state-of-the-art peptide function prediction methods. As the first predictive tool specifically designed for multifunctional CTPs, GeoCTP not only achieves strong classification performance but also identifies high-attention regions indicative of potential functional sites. Overall, this study highlights the potential of CTP functional prediction and its implications for bioinformatics in precision medicine.},
  keywords={Peptides;Cancer;Proteins;Predictive models;Bioinformatics;Biomembranes;Biological cells;Medical treatment;Feature extraction;Amino acids;cancer therapy peptides;peptide-based therapeutics;geometric deep learning;contrastive learning;sequence analysis},
  doi={10.1109/JBHI.2026.3674608},
  ISSN={2168-2208},
  month={},}@INPROCEEDINGS{11521509,
  author={Aahed, Fatima-Zohra El and Zhar, Mehdi and Kelkoul, Houria and Bendhiba, Safaa},
  booktitle={2026 IEEE International Conference on Complex Systems and Intelligent Computing (ICCSIC)}, 
  title={Dar’s Data: A Collaborative AI-Driven Framework for the Preservation and Generative Reinterpretation of Vernacular Heritage : Case Study of the Medina of Fez}, 
  year={2026},
  volume={},
  number={},
  pages={356-363},
  abstract={The preservation of vernacular architectural heritage faces a dual challenge: the physical degradation of historic urban fabrics due to environmental and seismic risks, and the erosion of intangible cultural knowledge. Traditional documentation methods, often limited to static archiving or "museumification," fail to capture the dynamic socio-architectural essence of living heritage sites like the Medina of Fez. This paper introduces "Dar’s Data," a multimodal digital ecosystem designed to document, preserve, and reinterpret Moroccan heritage. The proposed framework integrates low-cost photogrammetry, 360° immersive visualization, and participatory sourcing to create a semantic database of architectural typologies. Beyond preservation, the system introduces a novel approach to "heritage projection" through two distinct modules: F’Darna, a gamified environment for intergenerational transmission, and Dar Ghdda, a generative design concept leveraging AI to adapt traditional morphological rules (e.g., bioclimatic courtyards, moucharabieh) for contemporary sustainable construction. A pilot implementation at Dar Seffarine validates the feasibility of this hybrid workflow, demonstrating how digital tools can bridge the gap between historical documentation and future urban resilience.},
  keywords={Modeling;Printing;Visualization;Artificial intelligence;Design methodology;Three-dimensional displays;Modules (abstract algebra);Architecture;Computer architecture;Memory;Digital Heritage;Artificial Intelligence;Vernacular Architecture;Participatory Sensing;Gamification;Generative Design;Medina of Fez},
  doi={10.1109/ICCSIC69301.2026.11521509},
  ISSN={},
  month={March},}@INPROCEEDINGS{11486676,
  author={Zheng, Jiliang and Chai, Qinqin and Sun, Jinbo and Li, Jiabao and Chen, Runkun},
  booktitle={2025 China Automation Congress (CAC)}, 
  title={Segmentation of the Mandibular Nerve Canal Based on GAGA-UNet}, 
  year={2025},
  volume={},
  number={},
  pages={6379-6384},
  abstract={Damage to the mandibular nerve canal during the treatment of oral diseases may cause serious consequences such as acute pain, numbness, and even facial paralysis in patients. The purpose of this study is to develop an algorithm to achieve accurate three-dimensional segmentation of the mandibular nerve canal to help doctors make reasonable preoperative planning and reduce the risk of mandibular nerve canal injury. This paper proposes a gated attention group aggregation UNet (GAGA-UNet) to complete high-precision segmentation of the mandibular neural canal. Firstly, the gated channel spatial attention unit (GCSAU) is designed to focus the segmentation on the key area and reduce the interference of tissues around the mandibular nerve canal. Then, the multi-scale information is fused through the group aggregation bridge (GAB) to enhance the model's understanding of details and global information, which enhances the accuracy of boundary segmentation. Finally, the deep supervision mechanism is adopted to utilize multi-stage results to update the model, alleviating the gradient vanishing problem and accelerating model convergence. The model achieved excellent results in the self-built oral CBCT dataset, with a Dice coefficient of 86.66% and a HD95 of 1.5624 mm.},
  keywords={Central Processing Unit;Electronic circuits;Radio access networks;Regional area networks;Protocols;Pixel;Communication systems;HTTP;Location awareness;Mobile communication;UNet;mandibular nerve canal;CBCT;gated attention;three-dimensional segmentation},
  doi={10.1109/CAC67268.2025.11486676},
  ISSN={2688-0938},
  month={Sep.},}@INPROCEEDINGS{10709201,
  author={Wang, Hanfang and Tao, Tao and Zhang, Hui and Yao, Chao},
  booktitle={2024 IEEE 2nd International Conference on Image Processing and Computer Applications (ICIPCA)}, 
  title={Vision-Guided Nucleic Acid Detection and Sampling Robot}, 
  year={2024},
  volume={},
  number={},
  pages={835-840},
  abstract={At present, the main method of nucleic acid sampling is oral throat swab sampling. In the process of nucleic acid detection throat swab sampling, medical staff need to be in close contact with the patient, and a large number of droplets or aerosols will be produced when the patient coughs and breathes hard, which will greatly increase the risk of cross-infection among medical staff in the sampling process. Robot technology and computer vision technology can restore the artificial nucleic acid detection scene, and on the premise of ensuring the detection accuracy and efficiency, it can effectively reduce the social labor cost of traditional nucleic acid detection methods. In this paper, based on the actual process of nucleic acid detection and sampling, combined with the application prospect and difficulties of robot technology in throat swab sampling, a target detection model of nucleic acid detection and sampling robot based on vision guidance is proposed. In this model, SSD algorithm (Single Shot Multi-Box Detector) based on attention mechanism is used to identify and locate tonsil region, and nucleic acid sampling and detection of human oral and respiratory throat swabs are realized under visual guidance. The experimental results show that the sampling robot designed in this paper has high detection efficiency and accuracy, which can provide technical support for the design of nucleic acid detection sampling robot.},
  keywords={Epidemics;Visualization;Accuracy;Hospitals;Prevention and mitigation;Image processing;Object detection;Detectors;Robots;Intelligent robots;Nucleic acid detection;Sampling robot;Machine vision},
  doi={10.1109/ICIPCA61593.2024.10709201},
  ISSN={},
  month={June},}@INPROCEEDINGS{10871854,
  author={Zeng, Yanting and Chen, Guoming and Lin, Xinni and Zhang, Qian},
  booktitle={2024 International Conference on Intelligent Robotics and Automatic Control (IRAC)}, 
  title={Face Expression Recognition Method Based on Mamba and Different Facial Regions}, 
  year={2024},
  volume={},
  number={},
  pages={380-384},
  abstract={With the rapid advancement of information technology, facial expression recognition has become increasingly critical in various applications. To enhance recognition accuracy and computational efficiency, we propose a novel integration of the Vision Mamba framework with facial part-based image classification. This approach precisely segments key facial regions using Grad-CAM heatmaps, enabling the Mamba model to extract and analyze deep features from critical areas. By leveraging these techniques, our method achieves superior classification performance across multiple datasets. Experimental results demonstrate its robustness and efficiency, making it highly suitable for facial expression recognition. This work provides a practical and scalable solution, paving the way for advancements in intelligent systems and broader application scenarios, such as human-computer interaction and affective computing.},
  keywords={Heating systems;Image segmentation;Technological innovation;Image recognition;Accuracy;Face recognition;Computational modeling;Feature extraction;Computational efficiency;Image classification;Mamba Model;Grad-CAM Heatmap;Image Classification;Feature Extraction;Facial Regions},
  doi={10.1109/IRAC63143.2024.10871854},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9710725,
  author={Dib, Abdallah and Thébault, Cédric and Ahn, Junghyun and Gosselin, Philippe-Henri and Theobalt, Christian and Chevallier, Louis},
  booktitle={2021 IEEE/CVF International Conference on Computer Vision (ICCV)}, 
  title={Towards High Fidelity Monocular Face Reconstruction with Rich Reflectance using Self-supervised Learning and Ray Tracing}, 
  year={2021},
  volume={},
  number={},
  pages={12799-12809},
  abstract={Robust face reconstruction from monocular image in general lighting conditions is challenging. Methods combining deep neural network encoders with differentiable rendering have opened up the path for very fast monocular reconstruction of geometry, lighting and reflectance. They can also be trained in self-supervised manner for increased robustness and better generalization. However, their differentiable rasterization-based image formation models, as well as underlying scene parameterization, limit them to Lambertian face reflectance and to poor shape details. More recently, ray tracing was introduced for monocular face reconstruction within a classic optimization-based framework and enables state-of-the art results. However, optimization-based approaches are inherently slow and lack robustness. In this paper, we build our work on the afore-mentioned approaches and propose a new method that greatly improves reconstruction quality and robustness in general scenes. We achieve this by combining a CNN encoder with a differentiable ray tracer, which enables us to base the reconstruction on much more advanced personalized diffuse and specular albedos, a more sophisticated illumination model and a plausible representation of self-shadows. This enables to take a big leap forward in reconstruction quality of shape, appearance and lighting even in scenes with difficult illumination. With consistent face attributes reconstruction, our method leads to practical applications such as relighting and self-shadows removal. Compared to state-of-the-art methods, our results show improved accuracy and validity of the approach.},
  keywords={Reflectivity;Geometry;Shape;Neural networks;Lighting;Ray tracing;Rendering (computer graphics);3D from a single image and shape-from-x;Biometrics;Machine learning architectures and formulations;Optimization and learning methods;Scene analysis and understanding;Transfer/Low-shot/Semi/Unsupervised Learning},
  doi={10.1109/ICCV48922.2021.01258},
  ISSN={2380-7504},
  month={Oct},}@ARTICLE{10385188,
  author={Chen, Hongbo and Qian, Liyue and Gao, Yuchong and Zhao, Jianhao and Tang, Yiwen and Li, Jiawen and Le, Lawrence H. and Lou, Edmond and Zheng, Rui},
  journal={IEEE Transactions on Ultrasonics, Ferroelectrics, and Frequency Control}, 
  title={Development of Automatic Assessment Framework for Spine Deformity Using Freehand 3-D Ultrasound Imaging System}, 
  year={2024},
  volume={71},
  number={3},
  pages={408-422},
  abstract={A 3-D ultrasound (US) imaging technique has been studied to facilitate the diagnosis of spinal deformity without radiation. The objective of this article is to propose an assessment framework to automatically estimate spinal deformity in US spine images. The proposed framework comprises four major components, a US spine image generator, a novel transformer-based lightweight spine detector network, an angle evaluator, and a 3-D modeler. The principal component analysis (PCA) and discriminative scale space tracking (DSST) method are first adopted to generate the US spine images. The proposed detector is equipped with a redundancy queries removal (RQR) module and a regularization item to realize accurate and unique detection of spine images. Two clinical datasets, a total of 273 images from adolescents with idiopathic scoliosis, are used for the investigation of the proposed framework. The curvature is estimated by the angle evaluator, and the 3-D mesh model is established by the parametric modeling technique. The accuracy rate (AR) of the proposed detector can be achieved at 99.5%, with a minimal redundancy rate (RR) of 1.5%. The correlations between automatic curve measurements on US spine images from two datasets and manual measurements on radiographs are 0.91 and 0.88, respectively. The mean absolute difference (MAD) and standard deviation (SD) are  $2.72^{\circ} ~\pm ~2.14^{\circ} $  and  $2.91^{\circ} ~\pm ~2.36^{\circ} $ , respectively. The results demonstrate the effectiveness of the proposed framework to advance the application of the 3-D US imaging technique in clinical practice for scoliosis mass screening and monitoring.},
  keywords={Three-dimensional displays;Imaging;Scoliosis;Ultrasonic imaging;Transformers;Artificial intelligence;Frequency control;3-D ultrasound (US) spine imaging;automatic measurement;scoliosis;spine detection;transformer},
  doi={10.1109/TUFFC.2024.3351223},
  ISSN={1525-8955},
  month={March},}@INPROCEEDINGS{11365127,
  author={Nguyen, Van Binh and Ha, Duc Tan},
  booktitle={2025 RIVF International Conference on Computing and Communication Technologies (RIVF)}, 
  title={Enhancing Surgical Instrument Localization Using Image Processing}, 
  year={2025},
  volume={},
  number={},
  pages={346-351},
  abstract={This paper proposes an improved method to enhance the accuracy of surgical instrument tracking by using multi-point image processing. To accurately determine the coordinates of the reflective spheres attached to surgical instruments, we introduce a novel hybrid algorithm that integrates a convolutional neural network (CNN) with geometric constraints to refine the center position in 2D images, even under occlusion or light interference conditions. Combined with data from multiple infrared cameras, the system achieves high accuracy in 3D coordinate estimation. Experiments conducted on 3D printed model demonstrate that the proposed system significantly improves localization accuracy (error under 0.6 mm) and real-time tracking capability—especially in complex minimally invasive surgeries such as neurosurgery and endoscopy. This method promises to improve both the efficiency and safety of surgical navigation.},
  keywords={Surgical instruments;Location awareness;Technological innovation;Accuracy;Navigation;Image processing;Interference;Three-dimensional printing;Cameras;Convolutional neural networks;surgical instrument tracking;image processing;reflective spheres;deep learning;surgical navigation component},
  doi={10.1109/RIVF68649.2025.11365127},
  ISSN={2473-0130},
  month={Dec},}@INPROCEEDINGS{9600489,
  author={Shash, Yomna H. and Dohiem, Mohamed M. and Elwakad, Mohamed T. and Eldosoky, Mohamed A. A.},
  booktitle={2021 3rd Novel Intelligent and Leading Emerging Sciences Conference (NILES)}, 
  title={Effect of bar material on the biomechanical performance of hybrid dental prosthesis}, 
  year={2021},
  volume={},
  number={},
  pages={37-40},
  abstract={Edentulism is the condition of having no teeth which affects the ability of chewing and reduces the quality of patient's life both physically and psychologically. These problems can be reduced using implant- retained dentures, implant- supported dentures and hybrid prostheses to restore the chewing mechanism. The hybrid prosthesis is suitable for patients suffered bone loss. This prosthesis consists of bar (framework) attached to the copings of the abutments and implants. Acrylic artificial teeth are arranged on the bar and secured with acrylic material. The bar supports the artificial teeth, decreases the number of needed implants and reduces the bone stress. Protocol bars in hybrid prosthesis are usually made of metallic materials such as titanium and gold. The limitations of metal coupled with increasing demands of the patients for metal-free prosthesis led researchers to search for alternatives of metals. Polymers such as PEKK and PEEK have recently been introduced in the dental prostheses to eliminate metallic taste, allergic reactions and the high cost. PEEK properties can be improved by adding others materials such as carbon fibers (CFR-PEEK) or ceramic fillers (Bio-HPP). This paper studies the possibility of using polymers and their composites in the fabrication of bar in hybrid prosthesis as alternative to titanium, by using Finite element model. 3D model of mandible with hybrid prosthesis is constructed and different bar materials (Titanium, CFR-PEEK 30&60%, BIO-HPP, PEKK and PEEK) are stimulated, then the results are extracted and compared together. The simulation results clarify the ability of using the polymers and composites as a bar material. Moreover, CFR-PEEK 60% can be used as alternative to titanium.},
  keywords={Solid modeling;Pain;Teeth;Implants;Titanium;Bones;Plastics;Edentulism;hybrid prostheses;framework;PEKK;PEEK},
  doi={10.1109/NILES53778.2021.9600489},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{9544796,
  author={Sasi, Archana and Ravichandran, Sathish Kumar},
  booktitle={2021 Third International Conference on Inventive Research in Computing Applications (ICIRCA)}, 
  title={Future Innovation in Healthcare by Spatial Computing using ProjectDR}, 
  year={2021},
  volume={},
  number={},
  pages={829-833},
  abstract={Spatial Computation is the next step in the continuing convergence between the digital and physical realms. It is a set of inventions and developments that can better our lives through learning the real world, acknowledging and connecting our connection to, and traveling through various locations in the world. The lack of modern, precise, and effective diagnosis limits the rehabilitation of patients, despite technical advancements in medicines. The capabilities of spatial computing are expanded in a healthcare framework during the care and treatment of the patient. In this article, our purpose is to clarify the function of ProjectDR in the field of healthcare, which enables the display of medical images, such as CT scans and MRI results, directly on the patient's body in a manner that moves as patients do.},
  keywords={Technological innovation;Processor scheduling;Navigation;Magnetic resonance imaging;Instruments;Computed tomography;Surgery;Augmented Reality;3D Tracking;ProjectDR;Medical display;Rehabilitation of patients;Spatial Computing;Virtual Reality},
  doi={10.1109/ICIRCA51532.2021.9544796},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11427967,
  author={Alrahhal, Maher and Al-Shabi, Mohammad Ahmad Qasim and Bonny, Talal and Yateem, Nabeel Al and Hussain, Abir Jaafar and Hamad, Mawieh},
  booktitle={2025 Advances in Science and Engineering Technology International Conferences (ASET)}, 
  title={A Vision Transformer with Shift Encoding for Early Screening of Oral Cancer in Clinical Images}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={ShiftViT-XAI (Shift Vision Transformer with Explainable AI) is a novel deep learning framework designed for early detection of oral cancer from clinical images. The framework leverages the ShiftViT architecture, which integrates patch-wise token embedding with stacked shift-encoding transformer blocks to efficiently capture both local lesion textures and global spatial dependencies. During training, stochastic depth regularization and a cosine learning rate schedule are employed to improve generalization and ensure stable convergence. Data augmentation techniques, including resizing, random cropping, horizontal flipping, and pixel normalization, enhance robustness to variability in clinical imaging conditions. Evaluated on the Oral Cancer Detection L dataset comprising 1,152 high-resolution annotated images, ShiftViT-XAI achieved a 97.97% accuracy, demonstrating balanced performance across cancerous and noncancerous classes. To support interpretability and clinical trust, Gradient-weighted Class Activation Mapping (GradCAM) is integrated to generate saliency maps that localize diagnostically significant regions within each image, aligning closely with expert clinical assessments. The proposed ShiftViT-XAI framework combines high diagnostic accuracy, efficient transformer design, and explainable predictions, making it a promising tool for deployment in computer-aided diagnosis (CAD) systems, telemedicine, mobile health units, and community screening programs to facilitate early oral cancer detection and improve patient outcomes.},
  keywords={Deep learning;Training;Computer vision;Design automation;Accuracy;Explainable AI;Transformers;Cancer detection;Computer aided diagnosis;Cancer;Shift Vision Transformer (ShiftViT);Explainable AI (XAI);Grad-CAM;oral cancer detection;deep learning;medical image classification;computer-aided diagnosis (CAD);saliency map visualization},
  doi={10.1109/ASET66891.2025.11427967},
  ISSN={2831-6878},
  month={Sep.},}@INPROCEEDINGS{11537176,
  author={Başaran, Bora and Polat, Deniz and Yılmaz, Gökçe Nur},
  booktitle={2026 8th International Congress on Human-Computer Interaction, Optimization and Robotic Applications (ICHORA)}, 
  title={Overcoming Compression Artifacts in Oral Malignancy Detection via Deep Restoration and Ensemble Learning}, 
  year={2026},
  volume={},
  number={},
  pages={1-10},
  abstract={This study presents a novel pipeline for both high- and low-level vision tasks by implementing four proposed models exploiting the evolution of the transformer-based models in the diagnostic labeling and restoration domains. Researchers curated a dataset of 500 degraded oral cancer images and 250 non-oral cancer samples incorporating SwinTransformer, VisionTransformer, Hybrid-I, and R-Vi-Swin-Net. Hybrid-I integrates SwinTransformer and VisionTransformer while the R-Vi-Swin-Net pipeline synthesizes VisionTransformer, SwinTransformer, SwinIR, Restormer, and HINet models where the first three models prioritize classification, whereas R-Vi-Swin-Net performs diagnostic labeling on visual samples via introduced models in various quantization levels. The proposed framework attained a confidence level exceeding 95% while manifesting competitive PSNR, SSIM, and the metric described in ${SSIM}_{G}$ [5], consolidating robust and reliable image classification in the clinical domain of malignant and benign lesions with attained a peak accuracy of 97.87 % at the 22nd epoch; furthermore, refined images afford profound fidelity in oral lesions with restored structural features, such as edges and textures, thereby catalyzing improved health monitoring. The reported results are obtained on a compact dataset of 750 images and should therefore be regarded as a proof-of-concept; further validation on larger, multi-centre cohorts is required before any clinical generalisation can be claimed.},
  keywords={Cancer;Modeling;Timing;Quantization (signal);Measurement;Transformers;Architecture;Computer architecture;Accuracy;Art;binary classification;computer-aided diagnosis;deep image denoising;deep learning;image restoration;medical image analysis;oral cancer classification;r-vi-swin-net;sequential learning framework},
  doi={10.1109/ICHORA69329.2026.11537176},
  ISSN={2996-4393},
  month={May},}@INPROCEEDINGS{11009509,
  author={Sun, Ting and Xu, Jingjing and Liu, Jie and Cheng, Qiang and Wang, Yi},
  booktitle={2025 7th International Conference on Software Engineering and Computer Science (CSECS)}, 
  title={YOLO_MIC3: Facial Keypoints Detection Algorithm for Aggregating Reduced-Dimensional MRI Images}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Clinical diagnosis and treatment are highly dependent on medical images. However, the MRI reconstruction model of the human head is limited by insufficient resolution, blurred tissue contours, and spatial impurities, which makes it difficult to accurately locate the key points of the face, and thus severely restricts its wide application in clinical scenarios. In this study, we take a unique approach to capture the MRI reconstruction model with dimensionality reduction, and construct the YOLO_MIC3 deep learning algorithm based on YOLOv8 for the obtained 2D images. Through a series of optimization strategies, such as introducing the CBAM mechanism, replacing the DarknetBottleneck component in C2f with the CAA module, and applying the Inner-CloU computational loss, the comprehensive performance of the model is improved. Experimentally, the algorithm reduces the model complexity by 25%, improves the computational efficiency by 29%, and performs well in the Box metrics dimension of mAP50-95, which provides a promising solution for the localization of clinical facial keypoints.},
  keywords={Location awareness;YOLO;Adaptation models;Computational modeling;Magnetic resonance imaging;Feature extraction;Computational efficiency;Image reconstruction;Faces;Optimization;MRI;3D reconstruction;dimensionality-capture;YOLOv8;keypoint detection},
  doi={10.1109/CSECS64665.2025.11009509},
  ISSN={},
  month={March},}@INBOOK{9606799,
  author={Archana, P. and Megala, T. and Udaya, D. and Prabavathy, S.},
  booktitle={Big Data Management in Sensing: Applications in AI and IoT}, 
  title={1 Classification of Histopathological Variants of Oral Squamous Cell Carcinoma Using Convolutional Neural Networks}, 
  year={2021},
  volume={},
  number={},
  pages={1-14},
  abstract={Oral Cancer is a primary disease which affects the middle age and elderly age group people. When healthy cells undergo mutations, they develop gradually into a mass known as cancer. Cancer can be divided into two types: malignant and benign. The cells in malignant tumors multiply and spread to other parts of the body, whereas benign tumors do not spread. Oral Squamous Cell Carcinoma (OSCC) is a highly prevalent oral cancer that affects more than 90% of the head and neck areas, than other parts of the body. At present, the pathologist finds it difficult to identify the histopathological variants of OSCC. To address this problem, the Computer Aided Diagnosis (CAD) paradigm was developed to assist pathologists in making decisions. However, early detection and prevention of oral cancer is vital, but it is a timeconsuming task in medical image processing. Therefore, it is essential to find an effective diagnostic procedure for detecting cancer at the earlier stage. The proposed work aims at developing an effective deep learning model to identify the histopathological variants of OSCC. In the proposed work, convolutional layers and filters size have been altered to attain the accuracy. To evaluate the performance of the proposed models, a real time dataset is used which shows a highest accuracy of 93.65% to 96.83% compared to other models.},
  keywords={},
  doi={},
  ISSN={},
  publisher={River Publishers},
  isbn={9788770224147},
  url={https://ieeexplore.ieee.org/document/9606799},}@INPROCEEDINGS{10337961,
  author={Ali, A. S. R. Asraf and Landi, C. and Sarti, C. and Fusiello, A.},
  booktitle={2023 IEEE Nuclear Science Symposium, Medical Imaging Conference and International Symposium on Room-Temperature Semiconductor Detectors (NSS MIC RTSD)}, 
  title={Non-iterative Compensation for Patient Motion in Dental CBCT Imaging}, 
  year={2023},
  volume={},
  number={},
  pages={1-1},
  abstract={Cone Beam Computed Tomography is widely used in dentistry for diagnosis and treatment planning. However, it is susceptible to artifacts caused by patient movement during scanning. Manufacturers of cone beam CT systems have added mechanical fixations to prevent patient movement, but these are not completely rigid and still allow some movement. Researchers have tried to solve this problem with motion compensation algorithms. However, these solutions are often time consuming and only partially address the problem. This paper proposes a novel motion compensation approach based on a motion detection strategy to extract a motion-free subset of the scanned projections. A short-scan reconstruction is performed from the motion-free subset, which is used as a reference for the compensation algorithm, eliminating the need for multiple full-scan reconstructions at this stage. Motion compensation is performed by optimizing the motion parameters with a regularized 3D-2D image registration. The results show that the proposed algorithm can be used effectively to compensate for large and long-duration motions.},
  keywords={Microwave integrated circuits;Image registration;Semiconductor detectors;Computed tomography;Motion compensation;Motion detection;Dentistry},
  doi={10.1109/NSSMICRTSD49126.2023.10337961},
  ISSN={2577-0829},
  month={Nov},}@ARTICLE{11476878,
  author={Hu, Yisen and Xia, Yuanlin and Meng, Weiran and Guo, Xiang and Wang, Zhuqing and Hu, Zhimin},
  journal={IEEE Transactions on Instrumentation and Measurement}, 
  title={Accurate 3-D Radiation Field Measurement via Focus-Enhanced Gamma Imaging and Density-Adaptive Point Cloud Fusion}, 
  year={2026},
  volume={75},
  number={},
  pages={1-11},
  abstract={Accurate 3-D radiation field mapping is essential for nuclear safety, decommissioning, and environmental monitoring. This study presents a multimodal measurement system that integrates a gamma camera, MEMS-based LiDAR, and RGB imaging on a dual-axis platform to enhance the spatial accuracy and interpretability of 3-D radiological data. A measurement-aware sensor fusion workflow is introduced to establish a physical coupling between radiometric sensing and geometric sampling. This approach enables a compact, co-registered sensor package through two integrated stages. Gamma heatmap generation and enhancement (GHGE) improves source localization and separability by performing interpolation, multiscale filtering, and focus-guided enhancement on raw measurements. Subsequently, gamma heatmap-guided point cloud (GHPC) adjustment adaptively modulates local LiDAR point densities based on projected radiation intensities to increase geometric fidelity in high-response regions. Experimental validation in single- and dual-source indoor scenarios demonstrates up to 90% improvement in full-width at half-maximum (FWHM), a  $2.6\times $  increase in local point density, and effective reduction in localization error. Specifically, the angular error is reduced to 1° at 2.5 m for single-source and 2° for dual-source setups. The system also supports RGB-based texture mapping to enhance visual context in sparse point cloud regions. This work contributes a scalable and integrable solution for high-precision radiation sensing in the field of instrumentation and measurement.},
  keywords={Aerospace and electronic systems;Sensor systems;Apertures;Antennas;Filtering;Filters;Circuits and systems;Circuits;Central Processing Unit;Location awareness;3-D radiation measurement;gamma camera;LiDAR;multimodal data fusion;point cloud resampling;radiation imaging},
  doi={10.1109/TIM.2026.3676169},
  ISSN={1557-9662},
  month={},}@INPROCEEDINGS{10063102,
  author={Sathya, R. and Anirudh, N. Nikhil and Ganeshram, H.},
  booktitle={2023 IEEE International Students' Conference on Electrical, Electronics and Computer Science (SCEECS)}, 
  title={Teeth Gap and Position Recognition System with Intraoral Scanner Images Using Image Processing}, 
  year={2023},
  volume={},
  number={},
  pages={1-7},
  abstract={The position of teeth plays a vital role in a person's capability to ingest, articulate, and face's appearance. If there is an error in the position or alignment of the upper and lower jaw teeth while chewing or biting, there may be issues with the facial muscles and problems like breakage of teeth or swelling of gums. Detecting the errors in spacing between the adjacent teeth and identifying their position is a hectic task for orthodontists. Intraoral Scanners or IOS are scanners that create precise three-dimensional pictures of teeth and their supporting structures, enabling dentists to see irregularities with their teeth This detection and analysis of teeth is crucial for planning treatment using braces. This paper aims to detect the position of teeth, along with the gap between each tooth, and spot the error by taking intraoral scanner images as input. If the gap between teeth is over 1.5-2mm of spacing, an error in the structure of teeth will the shown using the faster R-CNN method, K-Means Clustering Algorithm, and Euclidean Distance formula. It will also spot the error in the position of the teeth. The proposed system will benefit orthodontists mainly by speeding up the pre-treatment analysis process and eliminating the physical work of using clay molds which are used for analysing the structure of teeth for an efficient treatment plan.},
  keywords={Computer science;Image recognition;Clustering algorithms;Teeth;Euclidean distance;Facial muscles;Planning;Teeth detection;position;space between adjacent teeth;K-Means;Euclidean;R-CNN},
  doi={10.1109/SCEECS57921.2023.10063102},
  ISSN={2688-0288},
  month={Feb},}@INPROCEEDINGS{11522826,
  author={Bona, Alessio De and Villani, Alberto and Prattichizzo, Domenico and Salvietti, Gionata},
  booktitle={2026 IEEE 9th International Conference on Soft Robotics (RoboSoft)}, 
  title={Physical Maxillofacial Simulator with Variable-Stiffness Sensorized Soft Tissues}, 
  year={2026},
  volume={},
  number={},
  pages={835-842},
  abstract={Realistic physical simulators for maxillofacial surgeons are still limited due to the lack of soft-tissue models capable of reproducing the complex mechanical behavior of human facial anatomy. This work presents a novel physical maxillofacial simulator specifically designed for diagnostic palpation. It integrates a high-fidelity 3D-printed skull with sensorized, pneumatic soft pads. The latter can actively modulate stiffness and shape to emulate both physiological and pathological tissue conditions. Each pad reproduces the layered structure of selected facial regions, i.e., mandibular, zygomatic, and maxillary. They are fabricated from silicone-based materials optimized to match human tissue compliance. Moreover, the system records palpation forces and dynamically varies internal pressure to simulate edematous or fibrotic responses. Experimental characterization demonstrates repeatable inflation–pressure dynamics, nonlinear stiffness modulation, and anatomically consistent swelling behavior. Validation with a maxillofacial surgeon confirms the simulator’s anatomical realism, tactile fidelity, and training effectiveness. Therefore, the proposed platform bridges the gap between static anatomical phantoms and virtual haptic systems, providing a controllable and high-fidelity environment for surgical training and diagnostic skill assessment.},
  keywords={Modeling;Biological tissues;Printing;Training;Materials;Silicon;Skull;Timing;Pathology;Design methodology},
  doi={10.1109/RoboSoft67810.2026.11522826},
  ISSN={2769-4534},
  month={April},}@INPROCEEDINGS{11379183,
  author={Urkande, Om Kiran and Chaudhari, Sharad S. and Urkande, Neha and Padmawar, Shubham and Adakane, Rakesh V.},
  booktitle={2025 3rd DMIHER International Conference on Artificial Intelligence in Healthcare, Education and Industry (IDICAIHEI)}, 
  title={AI-Based Knee Implant Recommendation from Radiographic Images using Deep Learning}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={In clinical decision-making for knee osteoarthritis management, determining whether a patient requires no implant, a partial knee replacement, or a total knee replacement is crucial. Manual interpretation of radiographs can be subjective and time-consuming. This study presents a deep learning-based framework that maps Kellgren–Lawrence grades to implant recommendations using four pretrained CNN architectures: ResNet50, MobileNetV2, EfficientNet-B0, and VGG16. Using a dataset of $1,240 \text{AP}$-view knee radiographs, the models were trained with transfer learning and evaluated using accuracy, precision, recall, and Grad-CAM interpretability. EfficientNet-B0 achieved the highest accuracy of 91 %, demonstrating superior generalization and clinically relevant visual attention patterns. The proposed system shows strong potential as an automated decision-support tool for orthopedic practitioners.},
  keywords={Deep learning;Visualization;Accuracy;Transfer learning;Surgery;Implants;Knee replacement;Osteoarthritis;Diagnostic radiography;Residual neural networks;Knee osteoarthritis;deep learning;implant recommendation;CNN;EfficientNet-B0;Grad-CAM},
  doi={10.1109/IDICAIHEI65991.2025.11379183},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10537757,
  author={Jayabalaji, K A and Laxmaiah, Bagam and Thatipudi, Jayendra Gopal and K, Chandraprabha and Badhe, Pravin and Balaram, Allam},
  booktitle={2023 Seventh International Conference on Image Information Processing (ICIIP)}, 
  title={Enhancing Content-Based Image Retrieval for Lung Cancer Diagnosis: Leveraging Texture Analysis and Ensemble Models}, 
  year={2023},
  volume={},
  number={},
  pages={386-390},
  abstract={In image retrieval systems, many search engines rely on text-based methods, extracting information from descriptions and tags to retrieve relevant images. However, this conventional approach often overlooks the optical or semantic information present in photographs, leading to errors in the retrieved results. To address this issue, it is essential to consider content-based information such as intensities, edges, and pixel values when designing image retrieval systems, especially in domains like medicine. This study focuses on developing a Content-Based Image Retrieval (CBIR) system for the domain of medicine, with a particular emphasis on lung cancer detection. Early identification and treatment of lung cancer are critical for patient outcomes, making suitable Computer-Aided Diagnosis (CAD) systems essential for assisting clinicians. The proposed ensemble model incorporates various feature extraction methods, including image processing techniques and wavelet transform, to harness the valuable information from images. These features are then fed into a deep learning model to assess their effectiveness in image retrieval tasks. By combining machine learning and image processing techniques, this work presents a comprehensive CBIR system capable of efficiently retrieving relevant medical images. Such advancements in image retrieval technology hold significant promise for aiding medical professionals in diagnosing and treating diseases like lung cancer promptly.},
  keywords={Wavelet transforms;Solid modeling;Design automation;Computational modeling;Image retrieval;Lung cancer;Feature extraction;Image retrieval;Content-Based Image Retrieval (CBIR);Deep learning;Machine learning;Lung cancer and Computer-Aided Diagnosis (CAD)},
  doi={10.1109/ICIIP61524.2023.10537757},
  ISSN={2640-074X},
  month={Nov},}@INPROCEEDINGS{10289357,
  author={Prodi, Nicola and Visentin, Chiara},
  booktitle={2023 Immersive and 3D Audio: from Architecture to Automotive (I3DA)}, 
  title={Using response time to evaluate noise fluctuations and Lombard speech in auralizations}, 
  year={2023},
  volume={},
  number={},
  pages={1-5},
  abstract={This work presents developments on the usage of a viable measure of listening effort, that is the response time, in the framework of auralization. The approach is confirmed to be informative and suitable to evaluate the current means of acoustical renderings. In particular the manipulation of the noise signals and of the speakers’ spectrum is introduced in the auralization process. It is shown that, even in conditions where speech intelligibility is kept constant, the response time can disclose the listener effort according to the required processing load to achieve the given accuracy of reception. Applications to the acoustical design of rooms for speech communication are discussed.},
  keywords={Fluctuations;Costs;Current measurement;Oral communication;Predictive models;Rendering (computer graphics);Time measurement;auralization;listening effort;Lombard speech;response time},
  doi={10.1109/I3DA57090.2023.10289357},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{9857100,
  author={Wu, Yunheng and Oda, Masahiro and Hayashi, Yuichiro and Takebe, Takanori and Nagata, Shogo and Wang, Cheng and Mori, Kensaku},
  booktitle={2022 IEEE/CVF Conference on Computer Vision and Pattern Recognition Workshops (CVPRW)}, 
  title={Blood Vessel Segmentation from Low-Contrast and Wide-Field Optical Microscopic Images of Cranial Window by Attention-Gate-Based Network}, 
  year={2022},
  volume={},
  number={},
  pages={1863-1872},
  abstract={The stereomicroscope, which is an optical microscope, is used to observe the organoids cultured in cranial windows. A cranial window is a light accessible observation window made on the brain of mice through craniotomy. Organoids research is often conducted on cranial windows. Hence, the observation of blood vessels in them is important for organoid research, like organoid vascularization. Therefore, achieving a simple, low-cost method that extracts blood vessel structures would significantly help researchers observe the blood vessels in cranial windows from microscopic images. However, wide-field optical microscopic images taken by stereomicroscope suffer from low contrast and dura mater occlusion, complicating the observation of the blood vessels in such images. To address such problems and assist researchers who are observing vascular structures, we propose a method that segments blood vessels in cranial windows from low-contrast and wide-field microscopic images. Our method is based on the Attention U-Net framework and clDice, which considers the connectivity of blood vessels. In addition, for low-contrast and partial occlusion problems, we used contrast enhancement and dehazing as preprocessing steps. Our method achieved a Dice score of 75.56%, a clDice score of 79.95%, and the Accuracy of 91.41% on our microscopic image dataset, suggesting that our method can extract blood vessels from low-contrast and wide-field microscopic images better than other methods.},
  keywords={Image segmentation;Visualization;Optical microscopy;Uncertainty;Three-dimensional displays;Microscopy;Blood vessels},
  doi={10.1109/CVPRW56347.2022.00203},
  ISSN={2160-7516},
  month={June},}@INPROCEEDINGS{11493324,
  author={V, Nidharsan and S, Shanthi and M, Ilango and S, Mugesh and J, Praveen},
  booktitle={2026 International Conference on Emerging Smart Computing and Informatics (ESCI)}, 
  title={Real-Time Indian Sign Language Recognition and Sentence Generation via CNN–LSTM and Agentic Semantic Reconstructions}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents an end-to-end system for translating Indian Sign Language (ISL) videos into fluent natural-language sentences. The proposed framework integrates MediaPipe-based landmark extraction with a BiLSTM temporal recognition model to identify dynamic ISL gestures with a test accuracy of 95.8% and an F1-score of 95.2%. A token stabilization module improves raw token accuracy from 92.4% to 97.1%, reducing prediction noise by 42%. A structured multi-agent semantic reasoning layer powered by LLaMA-3 enhances sentence-level translation, increasing semantic meaning accuracy from 68.5% to 91.4% and reducing hallucinated outputs by 63%. The system operates within 180–400 ms under GPU-based deployment, demonstrating scalable real-time feasibility for assistive communication applications.},
  keywords={Radio broadcasting;Frequency modulation;Central Processing Unit;Filtering;Filters;Electronic circuits;Circuits and systems;Videos;Video equipment;Protocols;Indian Sign Language;sign recognition;deep learning;temporal modeling;multi-agent reasoning;sentence generation;human-computer interaction},
  doi={10.1109/ESCI68015.2026.11493324},
  ISSN={2996-1815},
  month={March},}@INPROCEEDINGS{10888438,
  author={Feng, Guanwen and Jin, Siyu and Qian, Zhihao and Li, Yunan and Miao, Qiguang},
  booktitle={ICASSP 2025 - 2025 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={KAN-Face: Efficient Resource Usage and Precision Lip-Sync in Talking Head Generation}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Despite significant progress in NeRF-based talking head generation, problems like poor lip synchronization and inefficient resource usage remain. To solve these, we propose KANFace, a lightweight framework. In preprocessing, we introduce a Lip-Sync Enhancement Module that uses Wav2Lip to extract high-resolution audio features and map them to an explicit intermediate representation, ensuring precise lip movement alignment with the speaker’s identity. These predicted lip-sync features are combined with fundamental audio-extracted lip features and injected into the rendering module to improve synchronization. For rendering, we introduce FastKAN to map spatial points to color values. As a variant of KAN, FastKAN’s sensitivity to 3D scenes and efficient structure enable precise, fast color prediction. Our framework reduces resource consumption while enhancing lip-sync accuracy and facial reconstruction, making it ideal for talking head generation tasks in resource-limited settings. Project: https://peterfanfan.github.io/KAN-Face/},
  keywords={Accuracy;Three-dimensional displays;Lips;Color;Signal processing;Rendering (computer graphics);Feature extraction;Synchronization;Speech processing;Faces;Face Animation;Talking Head Generation;Neural Radiance Fields;KAN Network;Low Resource},
  doi={10.1109/ICASSP49660.2025.10888438},
  ISSN={2379-190X},
  month={April},}@INPROCEEDINGS{10290090,
  author={Oral, Okyanus and Oktem, Figen S.},
  booktitle={2023 31st European Signal Processing Conference (EUSIPCO)}, 
  title={Plug-and-Play Reconstruction with 3D Deep Prior for Complex-Valued Near-Field MIMO Imaging}, 
  year={2023},
  volume={},
  number={},
  pages={496-500},
  abstract={Near-field radar imaging systems are used in a wide range of applications, such as medical diagnosis, through-wall imaging, concealed weapon detection, and nondestructive evaluation. In this paper, we consider the inverse problem of reconstructing the three-dimensional (3D) complex-valued reflectivity distribution of the near-field scene from the sparse multiple-input multiple-output (MIMO) array measurements. Using the alternating direction method of multipliers (ADMM) framework, we formulate this problem by exploiting regularization on the magnitude of the complex-valued reflectivity distribution. We then provide a general expression for the proximal mapping associated with such regularization functionals operating on the magnitude of the complex-valued unknown. By utilizing this expression, we develop a computationally efficient plug-and-play reconstruction method that involves simple update steps both with analytical and deep priors. We illustrate the reconstruction performance of our approach with a 3D deep prior on a synthetic dataset. We also compare the result with the classical back-projection method and magnitude-total variation. Our results demonstrate that significant performance improvement can be achieved with learned 3D priors.},
  keywords={Reflectivity;Three-dimensional displays;Weapons;Imaging;Radar;Radar imaging;Radar signal processing;Inverse problems;MIMO radar imaging;complex-valued optimization;plug-and-play;deep prior;compressed sensing},
  doi={10.23919/EUSIPCO58844.2023.10290090},
  ISSN={2076-1465},
  month={Sep.},}@ARTICLE{10130292,
  author={Liu, Jiawei and Xing, Fuyong and Shaikh, Abbas and French, Brooke and Linguraru, Marius George and Porras, Antonio R},
  journal={IEEE Transactions on Medical Imaging}, 
  title={Joint Cranial Bone Labeling and Landmark Detection in Pediatric CT Images Using Context Encoding}, 
  year={2023},
  volume={42},
  number={10},
  pages={3117-3126},
  abstract={Image segmentation, labeling, and landmark detection are essential tasks for pediatric craniofacial evaluation. Although deep neural networks have been recently adopted to segment cranial bones and locate cranial landmarks from computed tomography (CT) or magnetic resonance (MR) images, they may be hard to train and provide suboptimal results in some applications. First, they seldom leverage global contextual information that can improve object detection performance. Second, most methods rely on multi-stage algorithm designs that are inefficient and prone to error accumulation. Third, existing methods often target simple segmentation tasks and have shown low reliability in more challenging scenarios such as multiple cranial bone labeling in highly variable pediatric datasets. In this paper, we present a novel end-to-end neural network architecture based on DenseNet that incorporates context regularization to jointly label cranial bone plates and detect cranial base landmarks from CT images. Specifically, we designed a context-encoding module that encodes global context information as landmark displacement vector maps and uses it to guide feature learning for both bone labeling and landmark identification. We evaluated our model on a highly diverse pediatric CT image dataset of 274 normative subjects and 239 patients with craniosynostosis (age 0.63 ± 0.54 years, range 0–2 years). Our experiments demonstrate improved performance compared to state-of-the-art approaches.},
  keywords={Cranial;Bones;Task analysis;Computed tomography;Labeling;Image segmentation;Training;Cranial bone labeling;context encoding;landmark detection},
  doi={10.1109/TMI.2023.3278493},
  ISSN={1558-254X},
  month={Oct},}@ARTICLE{11051047,
  author={Kam, Michael and Ge, Jiawei and Riaziat, Naveed D. and Opfermann, Justin D. and Mady, Leila J. and Brown, Jeremy D. and Krieger, Axel},
  journal={IEEE Transactions on Medical Robotics and Bionics}, 
  title={Autonomous Closed-Loop Control for Robotic Soft Tissue Electrosurgery Using RGB-D Image Guidance}, 
  year={2025},
  volume={7},
  number={3},
  pages={1041-1050},
  abstract={Oral cavity cancer, a common head and neck cancer, is typically treated through precise tumor excision via electrosurgery. Autonomous robotic electrosurgery has demonstrated the potential to achieve more accurate and consistent resection margins compared to manual methods, thereby improving surgical outcomes. However, current autonomous systems face challenges in tracking tissue deformation during electrosurgical cutting due to unpredictable and complex soft tissue dynamics. Failure to monitor and adapt to tissue deformation can significantly compromise resection precision. This paper presents an autonomous closed-loop robotic electrosurgery system to enhance surgical precision via 3D tissue tracking and image-based feedback control utilizing a Red Green Blue – Depth (RGB-D) sensor. The developed 3D tissue tracker employs CoTracker, a deep learning-based model for markerless tracking, complemented by a tool-occlusion algorithm to achieve tissue deformation tracking with no prior knowledge of the tissue model. The estimated deformation is fed into a fuzzy logic controller, which dynamically adjusts the cutting velocity to minimize cutting error during electrosurgery. The system’s efficacy was validated using ex vivo porcine tongues, demonstrating a 55% reduction in average cutting error (from 1.2 mm to 0.54 mm,  $p\lt 0.001$ ) in closed-loop operations (N=6) compared to open-loop cutting without feedback control (N=3). The results demonstrate the effectiveness of image-based closed-loop control in improving margin accuracy, a key factor in reducing the likelihood of cancer recurrence.},
  keywords={Robots;Deformation;Three-dimensional displays;Surgery;Tumors;Biological tissues;Electrosurgery;Trajectory;Tracking;Tongue;Electrosurgery;medical robotics;motion planning},
  doi={10.1109/TMRB.2025.3583169},
  ISSN={2576-3202},
  month={Aug},}@ARTICLE{11352978,
  author={Huang, Zhengyong and Cai, Ru and Xu, Weiwei and Zhang, Yingfan and He, Run and Wang, Yusheng and Xiang, Xing and Li, Jian},
  journal={IEEE Transactions on Dielectrics and Electrical Insulation}, 
  title={Design of Honeycomb-Inspired Metamaterial Skeleton for Constructing Highly Thermally Conductive Epoxy Composite}, 
  year={2026},
  volume={},
  number={},
  pages={1-1},
  abstract={Engineering applications such as high-power electronic converters, high-voltage transmission, and aerospace are significantly attracted by high thermal conductivity electrical epoxy resin. Adding inorganic high-thermal-conductivity fillers is a traditional method to improve thermal conductivity (TC). However, excessive addition increases raw material viscosity excessively, complicates processing, and introduces defects, revealing the limitation that material properties become overly dependent on composition control. Metamaterials, with their artificially designed structural characteristics, can break through the performance limitations of traditional materials that rely on component control. Therefore, to address the aforementioned limitations, this study applies metamaterials to composite material design. With inspiration from honeycomb, we architect a 3D honeycomb metamaterial skeleton via 3D printing, enabling oriented arrangement of boron nitride (hBN) flakes within the metamaterial skeleton to yield a composite resin featuring an oriented metamaterial structure. Thus, a macroscopic skeleton network and a microscopic filler orientation are constructed to form a cross-dimensional continuous heat conduction path at a low filler content, significantly enhancing the TC at a low filler amount.Characterisation confirms that hBN exhibits highly oriented alignment within the framework. Benefiting from the oriented metamaterial structure, the composites exhibit excellent thermal conductivity and stability at low filler loadings. At the loading of 20 wt% hBN within the skeleton, the in-plane TC of the structured composites is 1.628 W m-1 K-1, substantially exceeding both pure resin and control specimens (20 wt% loading, full coverage 3D printing on every layer， no skeletal structure). The surface temperature measurement demonstrates that structured materials have superior thermal management applications with high heat absorption and dissipation rates compared to pure resin and the control specimens. Thermogravimetric analysis and dynamic thermal mechanical analysis indicate that the composites have excellent heat resistance and thermal stability. This study demonstrates that the strategy of constructing oriented metamaterial skeleton composite structures via 3D printing to enhance thermal conductivity under low filler loading offers a highly promising approach for developing high-performance thermally conductive materials.},
  keywords={Thermal conductivity;Metamaterials;Skeleton;Three-dimensional printing;Epoxy resins;Conductivity;X-ray diffraction;Diffraction;Curing;Thermal stability;Metamaterial skeleton;orientation;3D printing;thermal conductivity(TC)},
  doi={10.1109/TDEI.2026.3654028},
  ISSN={1558-4135},
  month={},}@ARTICLE{10989518,
  author={Weng, Luoxuan and Wang, Xingbo and Lu, Junyu and Feng, Yingchaojie and Liu, Yihan and Feng, Haozhe and Huang, Danqing and Chen, Wei},
  journal={IEEE Transactions on Visualization and Computer Graphics}, 
  title={InsightLens: Augmenting LLM-Powered Data Analysis With Interactive Insight Management and Navigation}, 
  year={2025},
  volume={31},
  number={6},
  pages={3719-3732},
  abstract={The proliferation of large language models (LLMs) has revolutionized the capabilities of natural language interfaces (NLIs) for data analysis. LLMs can perform multi-step and complex reasoning to generate data insights based on users’ analytic intents. However, these insights often entangle with an abundance of contexts in analytic conversations such as code, visualizations, and natural language explanations. This hinders efficient recording, organization, and navigation of insights within the current chat-based LLM interfaces. In this paper, we first conduct a formative study with eight data analysts to understand their general workflow and pain points of insight management during LLM-powered data analysis. Accordingly, we introduce InsightLens, an interactive system to overcome such challenges. Built upon an LLM-agent-based framework that automates insight recording and organization along with the analysis process, InsightLens visualizes the complex conversational contexts from multiple aspects to facilitate insight navigation. A user study with twelve data analysts demonstrates the effectiveness of InsightLens, showing that it significantly reduces users’ manual and cognitive effort without disrupting their conversational data analysis workflow, leading to a more efficient analysis experience.},
  keywords={Data analysis;Data visualization;Navigation;Oral communication;Recording;Codes;Natural languages;Semantics;Organizations;Manuals;Large language model;interactive data analysis;natural language interface;conversational contexts},
  doi={10.1109/TVCG.2025.3567131},
  ISSN={1941-0506},
  month={June},}@INPROCEEDINGS{10915019,
  author={Appavu, Narenthirakumar},
  booktitle={2025 3rd International Conference on Intelligent Data Communication Technologies and Internet of Things (IDCIoT)}, 
  title={Oral Cancer Histopathological Detection and Diagnosis Using Hybrid AI Deep Learning Methods}, 
  year={2025},
  volume={},
  number={},
  pages={2061-2067},
  abstract={This study introduces a novel deep learning-based approach for the early detection and classification of oral cancer using medical images. The rapid progression of oral cancer to critical regions such as the lips, gums, and inner cheeks underscores the importance of early diagnosis, as delayed detection can lead to severe consequences, including mortality. To address this challenge, we leveraged computer-aided diagnostic (CAD) technologies, integrating convolutional neural networks (CNNs) with an advanced Deep Convolutional Neural Network (DCNN) optimized through an evolutionary algorithm to enhance diagnostic accuracy. Our proposed approach underwent rigorous evaluation against established models, including Digital Network, Bayesian, and Artificial Neural Network (ANN) frameworks. Using the ‘Oral Disease (Lips and Tongue) Images' dataset, the method achieved an impressive accuracy of 97.71%, a sensitivity of 92.37%, and an F1-score of 94.65%. These results highlight the method's capability for reliable and precise classification of oral cancer, offering a promising tool for early diagnosis and improved clinical outcomes.},
  keywords={Deep learning;Solid modeling;Accuracy;Tongue;Sensitivity;Computational modeling;Lips;Transfer learning;Convolutional neural networks;Cancer;VGG-16;deep learning;plant leaf disease;disease of leaves detection;object identification;darknet},
  doi={10.1109/IDCIOT64235.2025.10915019},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11086060,
  author={B, Moulya K. and Sebastiao, Bernardo and Kakupa, Milton and Chigateri, Keerthana B.},
  booktitle={2025 6th International Conference on Intelligent Communication Technologies and Virtual Mobile Networks (ICICV)}, 
  title={Review of Group Formalism for Automated Formalization in Mechanical Engineering}, 
  year={2025},
  volume={},
  number={},
  pages={1744-1753},
  abstract={This work aims to enhance mechanical engineering design by integrating advanced group formalism with Conditional Generative Adversarial Networks (CGANs) within a unified framework. The proposed methodology formalizes and rationalizes complex engineering information for CAD environments through the systematic application of Design-for-X principles while leveraging CGANs to generate domain-specific data—such as improved navigation in confined spaces, defect detection in components, and tactile stimulus for ultrasonic displays. The process involves the systematic creation, verification, and validation of knowledge representations, thus facilitating automated analysis and early-stage design optimization. Experimental simulations further demonstrate that this cohesive strategy streamlines design processes by effectively bridging the gap between theoretical rigor and practical, data-driven implementations. Significantly, our approach reinforces the reliability, efficiency, and scalability of computer-aided design, establishing a robust foundation for future advancements in automated manufacturing analysis. Overall, the results advocate strongly for integrating data-driven techniques into traditional workflows, thereby propelling measurable improvements in performance, adaptability, and design innovation across various industrial applications.},
  keywords={Solid modeling;Design automation;Systematics;Reviews;Scalability;Generative adversarial networks;Manufacturing;Mechanical engineering;Optimization;Defect detection;Group Formalism;Design-for-X (DfX);CAD;Conditional Generative Adversarial Networks (CGANs);Mechanical Engineering;Automated Formalization;Cross-modal Reproduction},
  doi={10.1109/ICICV64824.2025.11086060},
  ISSN={},
  month={June},}@INPROCEEDINGS{9761433,
  author={Podobnik, Gašper and Ibragimov, Bulat and Strojan, Primož and Peterlin, Primož and Vrtovec, Tomaž},
  booktitle={2022 IEEE 19th International Symposium on Biomedical Imaging (ISBI)}, 
  title={Segmentation of Organs-At-Risk from Ct and Mr Images of the Head and Neck: Baseline Results}, 
  year={2022},
  volume={},
  number={},
  pages={1-4},
  abstract={For the head and neck (HaN) cancer, radiotherapy is a mainstay treatment modality that aims to deliver a high radiation dose to the targeted cancerous cells while sparing the nearby healthy organs-at-risk (OARs). A precise three-dimensional segmentation of OARs from computed tomography (CT) images is required for optimal radiation dose distribution calculation, however, so far there has been no evaluation about the impact of the combined analysis of multiple imaging modalities, such as CT and magnetic resonance (MR). For this purpose, we have devised a database of 56 CT and MR images of the same patients with 31 manually delineated OARs, and in this paper we present the baseline segmentation results that were obtained by applying the nnU-Net framework. The resulting average Dice coefficient of 68% and average 95-percentile Hausdorff distance of 8.2mm on a subset of 14 images indicate that nnU-Net serves as a solid baseline method.},
  keywords={Training;Image segmentation;Head;Shape;Databases;Computed tomography;Magnetic resonance;head and neck radiotherapy planning;organs-at-risk;automated segmentation;computed tomography;magnetic resonance},
  doi={10.1109/ISBI52829.2022.9761433},
  ISSN={1945-8452},
  month={March},}@INPROCEEDINGS{10150137,
  author={Wang, Di and Shi, Boqiang and Gao, Yin and Wang, Shuo},
  booktitle={2023 9th International Conference on Electrical Engineering, Control and Robotics (EECR)}, 
  title={A Method for Robot to Detect the Facial Landmarks with Masks}, 
  year={2023},
  volume={},
  number={},
  pages={1-4},
  abstract={As the epidemic intensifies aroun d the world, more and more people are wearing masks, which also makes it more difficult for robots to recognize key points of faces. Because of the distribution of face data with masks is completely different from the distribution of face data without masks, the accuracy of existing face points detection algorithms in academia and business is greatly reduced. Inthis paper, we present a facial keypoints detection algorithm with masks, which is as accuracy as the keypoints detection algorithm without masks. We propose 1) a low-cost facial landmark detection method with masks. 2) a realtime network that enhances the cognitive ability of each layer’s receptive field. This solution can be implemented at low-cost and has high accuracy, contributing to the epidemic prevention and control work.},
  keywords={Electrical engineering;Epidemics;Face recognition;Detection algorithms;Faces;Robots;Business;perception;deep-learning;3Dreconstruction;lowcost;faci al land marks dete ctor},
  doi={10.1109/EECR56827.2023.10150137},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11459607,
  author={Begum, M. Faritha and Umamageswari, A.},
  booktitle={2025 6th International Conference on Smart Electronics and Communication (ICOSEC)}, 
  title={A Novel Approach for Automatic Prediction of Canine Impaction using Deep Learning Algorithms}, 
  year={2025},
  volume={},
  number={},
  pages={2061-2066},
  abstract={Canine impaction is a common dental anomaly with significant implications for orthodontic treatment planning and patient outcomes. Early and accurate prediction of impacted canines is essential for minimizing complications such as root resorption, prolonged treatment duration, and surgical interventions. This paper proposes a novel deep learning-based framework for the automatic prediction of canine impaction using panoramic radiographs (orthopantomograms, OPGs). A convolutional neural network (CNN) architecture enhanced with transfer learning and attention mechanisms was developed to detect morphological and positional anomalies of the maxillary canines. The proposed model was trained on a curated dataset of annotated OPG images and evaluated against conventional diagnostic approaches and baseline machine learning methods. Experimental results demonstrate that the model achieves superior performance with accuracy of 95.4%, sensitivity of 94.2%, and specificity of 96.1%. Furthermore, the integration of Grad-CAM attention visualization provides interpretability, enabling clinicians to understand the model’s diagnostic focus. This study highlights the potential of deep learning algorithms in dental radiology for assisting orthodontists in early, precise, and automated canine impaction prediction.},
  keywords={Filtering;Filters;Circuits and systems;Pixel;Protocols;HTTP;Digital images;Artificial intelligence;Convolutional neural networks;Deep learning;Deep learning;Convolutional Neural Networks (CNN);Canine impaction;Orthodontics;Medical image analysis},
  doi={10.1109/ICOSEC67334.2025.11459607},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11407757,
  author={S, Jeevidha and V, Subasree and D, SujhiPriya. and S, Suvashree.},
  booktitle={2026 9th International Conference on Computational Intelligence in Data Science (ICCIDS)}, 
  title={Sign Lingo: Live Sign Language Interpretation using AI}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={Sign language serves as the primary mode of communication for deaf and mute individuals, enabling the expression of needs and emotions. However, the widespread lack of sign language knowledge among hearing individuals creates significant communication barriers in both social and professional environments. Speech impairments further restrict oral and auditory interactions, highlighting the urgent need for effective assistive technologies. This research proposes an advanced speech- and text-to-Indian Sign Language (ISL) conversion system utilizing 3D modelling techniques to generate realistic sign gestures. A lightweight Convolutional Neural Network (CNN) was developed for sign recognition, achieving a high accuracy of 95.6%. Additionally, the system employs 3D-modeled videos to visually render ISL gestures, reaching a gesture rendering accuracy of 99.2%. The system demonstrates wide range of applications in many fields including daily communication, business meetings, classroom education, and speech-based interactions. The paper ends with recommendations for future work, recommending algorithm optimization, the expansion and diversification of datasets, and a user-centric approach to design to further improve usability and drive broader adoption of such assistive communication technologies.},
  keywords={Hands;Sign language;Accuracy;Three-dimensional displays;Assistive technologies;Real-time systems;Communications technology;Convolutional neural networks;Usability;Videos;Speech-to-Sign Conversion;Text-to-Sign Conversion;Convolutional Neural Network (CNN);3D Gesture Modeling;Sign Language Recognition;Deaf and Mute Communication},
  doi={10.1109/ICCIDS69108.2026.11407757},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{11009532,
  author={Cheng, Qiang and Liu, Jie and Sun, Ting and Xu, Jingjing and Wang, Yi},
  booktitle={2025 7th International Conference on Software Engineering and Computer Science (CSECS)}, 
  title={A Soft Body Actuator Position Measurement Method Based on OpenCV Library}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={The inherent deformability of soft body robots renders the conventional rigid measurement techniques inapplicable to the assessment of their structural integrity. Consequently, the investigation of appropriate measurement methodologies for soft body structures has emerged as a prominent area of research. This paper proposes a visual processing algorithm based on the OpenCV library for the measurement of the position of soft robots. By affixing a defined number of marker points to the soft body robot, the bending contour can be extracted with precision and efficiency through the recognition of the marker points and the subsequent extraction of the overall contour. This method requires a minimal number of marker points and the algorithm is highly efficient. The location of the marker points is not a strict requirement, and the method is highly practical as it can be applied to the position measurement of a wide range of soft-body robots with varying structures. This research provides a valuable reference for the field of soft-body measurement.},
  keywords={Computer science;Visualization;Actuators;Area measurement;Measurement techniques;Position measurement;Soft robotics;Bending;Libraries;Software engineering;Soft Body Robot;OpenCV;Marker Points;Contour Extraction},
  doi={10.1109/CSECS64665.2025.11009532},
  ISSN={},
  month={March},}@INPROCEEDINGS{10239865,
  author={Wang, Xudong and Xu, Weiliang and Dhupia, Jaspreet and Bronlund, John and Han, Jianda},
  booktitle={2023 42nd Chinese Control Conference (CCC)}, 
  title={Compliance Control and Simulation of a Next-Generation Chewing Robot}, 
  year={2023},
  volume={},
  number={},
  pages={4232-4236},
  abstract={The aim of the development of the chewing robots is to study the biomechanics of chewing process or produce the bolus for further research by in vitro experiments. Some chewing robots are open loop controlled and couldn't behave like a human. However, to make the chewing robots more bin-mimic, force feedback based closed loop control is required. To improve the efficiency of the in-vitro chewing experiments, a next generation chewing robot with cam-follower based multi-chambers was developed previously, which can be used test the effect of different chewing parameters on the chewing performance and food texture changes simultanously. In this paper, modified admittance control based on the force feedback was applied to the chewing robot. At first, to improve food particle size reduction to a distribution which closely matches that produced by human and protect the components of the robot from breakage or impact damage, a spring mass based system, called remote center compliance (RCC), was developed and applied to the robot to control the chewing force. Then, based on the knowledge of human chewing process, power-based algorithm, and modified admittance control method were used as the feedback to adjust the angular velocity of the motor and corresponding chewing velocity of the teeth. The performance of the control model was also simulated, results showed that the model is reliable to control the robot and make it bio-mimic.},
  keywords={Biological system modeling;Force feedback;Force;Process control;Robot sensing systems;Mathematical models;Springs;chewing robot;admittance control;remote center compliance;chewing velocity},
  doi={10.23919/CCC58697.2023.10239865},
  ISSN={1934-1768},
  month={July},}@ARTICLE{11080228,
  author={Pham, Thanh Tuan and Suh, Young Soo},
  journal={IEEE Sensors Journal}, 
  title={Toothbrushing Monitoring Using an RGB-D Camera and Smart Toothbrush-Integrated IMU}, 
  year={2025},
  volume={25},
  number={16},
  pages={31254-31265},
  abstract={Accurate tracking of toothbrush position and identifying brushing regions are critical challenges in developing effective oral hygiene monitoring systems. This article presents a novel approach that integrates an inertial measurement unit (IMU) and an orange ball marker attached to a toothbrush with an external red–green–blue-depth (RGB-D) camera. The proposed method consists of two primary components: a toothbrush position estimation algorithm and a toothbrushing region classification method. By leveraging sensor fusion from the IMU and the RGB-D camera, the orientation and position of the toothbrush are accurately estimated. The brushing direction vector is then computed from the relative positions of the toothbrush head and the user’s mouth. This direction vector, combined with acceleration and orientation data, is used as input for a transformer encoder-based classification model, which categorizes brushing activity into 16 distinct regions. Experimental results demonstrate that our classification method outperforms existing approaches, achieving an  ${F}1$ -score of 94.85% in the all-subjects evaluation and 81.56% in the leave-one-subject-out scenario. Additionally, the toothbrush position estimation algorithm achieves an average root-mean-square error (RMSE) of 1.4 cm. These results highlight the effectiveness and reliability of the proposed method, positioning it as a promising solution for toothbrushing assessment and real-time feedback systems.},
  keywords={Cameras;Estimation;Vectors;Monitoring;Three-dimensional displays;Inertial sensors;Sensors;Magnetic sensors;Accelerometers;Transformers;Brushing region classification;inertial sensors;red–green–blue-depth (RGB-D) camera;smart toothbrush;toothbrush position estimation;transformer encoder},
  doi={10.1109/JSEN.2025.3587247},
  ISSN={1558-1748},
  month={Aug},}@INPROCEEDINGS{9755455,
  author={Arustamyan, Irina G. and Stancheva, Olga A. and Karpishchenko, Sergei A. and Tselobanov, Nikita B. and Efimenko, Georgy A. and Kaplun, Dmitrii I.},
  booktitle={2022 Conference of Russian Young Researchers in Electrical and Electronic Engineering (ElConRus)}, 
  title={A Software Package «Apnea» for the Diagnosis and Treatment of Obstructive Sleep Apnea}, 
  year={2022},
  volume={},
  number={},
  pages={1462-1465},
  abstract={According to the international classification of sleep disorders ICSD-3, sleep disorders are grouped into 7 different groups, one of which is "Obstructive Sleep Apnea" (OSA). In order to improve the quality of sleep, a mobile application "Apnea" was developed. It helps users in self-diagnosis and treatment of snoring and OSA. This will have a positive effect on many areas of life in the future: the number of accidents due to falling asleep while driving will decrease; the working capacity of the population will increase due to the improvement of people, since inadequate sleep increases the risk of many diseases, including sudden death. The software complex analyzes many patient data: name, age, gender, height and weight of the user, neck circumference, waist circumference, patient complaints, recording of the sound phenomenon of the client's snoring, processing of user's photographs to construction of a 3D model and determine the pathology of the dentition, heart rate data processing and activity results during the day. Based on the results of the assessment, users are offered various recommendations compiled by a team of doctors to improve the quality of sleep (smart alarm clock, soothing music, breathing techniques, myofunctional exercises, recommendations for diet therapy, sleep hygiene, etc.).},
  keywords={Solid modeling;Three-dimensional displays;Software packages;Sociology;Surgery;Sleep apnea;Recording;obstructive sleep apnea (OSA);snoring;otorhinolaryngology;mobile application;technology;diseases;precision medicine},
  doi={10.1109/ElConRus54750.2022.9755455},
  ISSN={2376-6565},
  month={Jan},}@INPROCEEDINGS{9282721,
  author={Shih, Chihhsiong and Lai, Quanen and Ho, Huanran and Chu, WillIam Cheng-Chung},
  booktitle={2020 IEEE 20th International Conference on Software Quality, Reliability and Security Companion (QRS-C)}, 
  title={Smart Feeder Robot for Severely Disabled Patients}, 
  year={2020},
  volume={},
  number={},
  pages={603-608},
  abstract={As Taiwan enters an aging society, the number of disabled people increases accordingly, resulting in a growing burden for longterm care and family care managements. We propose an eye-hand integration system with an infrared sensor attached to the end of the arm. Not only can the accuracy of feeding be controlled, but also the position of the spoon/claw can be micro-controlled while picking up food as cleanly as possible. It is more intelligent than other feeding robot arms. It can automatically adjust the position of the head and face of users of different sizes and orientations. As long as the base of the arm is placed close to the head of the bed, feeding the arm can serve the user without special posture adjustment. At the same time, the users' head are mounted with a laser light and a camera which serves as a lighting sources on multiple dark areas on the food table. Given the lighted instructions, the robot arm is guided to different food plate. Disabled patients can then freely choose the order of eating and enjoy the quality of life. We report the details of constructing such system and presents the image processing algorithms for laser light selection operations.},
  keywords={Three-dimensional displays;Mouth;Software quality;Aging;Robot sensing systems;Manipulators;Software reliability;smart feeder;intelligent sensing;eye in hand system;food pick selection},
  doi={10.1109/QRS-C51114.2020.00103},
  ISSN={},
  month={Dec},}@ARTICLE{10384880,
  author={Rao, Divya and Singh, Rohit and Kamath, Sudiksha Kottachery and Pendekanti, Sanjeev Kushal and Pai, Divya and Kolekar, Sucheta V. and Holla, M. Raviraja and Pathan, Sameena},
  journal={IEEE Access}, 
  title={OTONet: Deep Neural Network for Precise Otoscopy Image Classification}, 
  year={2024},
  volume={12},
  number={},
  pages={7734-7746},
  abstract={Otoscopy is a diagnostic procedure to visualize the external ear canal and eardrum, facilitating the detection of various ear pathologies and conditions. Timely otoscopy image classification offers significant advantages, including early detection, reduced patient anxiety, and personalized treatment plans. This paper introduces a novel OTONet framework specifically tailored for otoscopy image classification. It leverages octave 3D convolution and a combination of feature and region-focus modules to create an accurate and robust classification system capable of distinguishing between various otoscopic conditions. This architecture is designed to efficiently capture and process the spatial and feature information present in otoscopy images. Using a public otoscopy dataset, OTONet has reached a classification accuracy of 99.3% and an F1 score of 99.4% across 11 classes of ear conditions. A comparative analysis demonstrates that OTONet surpasses other established machine learning models, including ResNet50, ResNet50v2, VGG16, Dense-Net169, and ConvNeXtTiny, across various evaluation metrics. The research’s contribution to improved diagnostic accuracy reduced human error, expedited diagnostics, and its potential for telemedicine applications.},
  keywords={Image classification;Medical diagnostic imaging;Biomedical imaging;Media;Measurement;Analytical models;Artificial intelligence;Biomedical image processing;Convolutional neural networks;Ontologies;Medical services;Ear;Artificial intelligence;medical image analysis;diagnosis;convolutional neural networks;otology;applied engineering;healthcare},
  doi={10.1109/ACCESS.2024.3351668},
  ISSN={2169-3536},
  month={},}@ARTICLE{11278804,
  author={Ma, Xinghua and Fang, Xinyan and Luo, Gongning and Qiu, Xingyu and Liu, Xin and Huang, Chao and Wang, Kuanquan and Qiu, Zhaowen and Zhang, Tong and Li, Yue and Wei, Lei and Gao, Xin},
  journal={IEEE Transactions on Medical Imaging}, 
  title={Interference-Free Causality Learning Promotes Cross-Level, Fine-Grained Diagnosis of Coronary Artery Disease in Coronary CT Angiography}, 
  year={2026},
  volume={45},
  number={5},
  pages={1832-1846},
  abstract={With the growing global threat of coronary artery disease (CAD), automated CAD diagnosis techniques based on coronary CT angiography (CCTA) have been developed. However, their clinical applicability remains limited due to the heterogeneity of stenosis and plaque attributes, as well as confounders within the causal relationships of CAD diagnosis. This work introduces the Attribute-Decoupled Intervention Network (ADI-Net), a confounder-free CAD diagnosis framework designed for fine-grained analysis at both the artery and patient levels, aligning with real-world clinical practice. ADI-Net employs an attribute-decoupled representation that effectively captures the heterogeneous features of stenosis and plaque with differential constraints, enabling precise, fine-grained classification. Additionally, the dynamic-updating causal intervention continuously refines confounder banks and applies the Do-expression within a complete causality, ensuring comprehensive, cross-level assessments. Experiments on CCTA datasets from three clinical centers demonstrate that ADI-Net outperforms state-of-the-art methods in cross-level, fine-grained CAD diagnosis, exhibiting superior robustness, domain adaptability, and data efficiency.},
  keywords={Arteries;Cause effect analysis;Solid modeling;Medical diagnostic imaging;Biomedical image processing;Computational modeling;Diseases;Computed tomography;Coronary arteriosclerosis;Angiography;Coronary artery disease;coronary CT angiography;causality learning;cross-level;fine-grained},
  doi={10.1109/TMI.2025.3640646},
  ISSN={1558-254X},
  month={May},}@ARTICLE{10845152,
  author={Tarigopula, Neha and Tornay, Sandrine and Sincan, Ozge Mercanoglu and Bowden, Richard and Magimai.-Doss, Mathew},
  journal={IEEE Open Journal of Signal Processing}, 
  title={Posterior-Based Analysis of Spatio-Temporal Features for Sign Language Assessment}, 
  year={2025},
  volume={6},
  number={},
  pages={284-292},
  abstract={Sign Language conveys information through multiple channels composed of manual (handshape, hand movement) and non-manual (facial expression, mouthing, body posture) components. Sign language assessment involves giving granular feedback to a learner, in terms of correctness of the manual and non-manual components, aiding the learner's progress. Existing methods rely on handcrafted skeleton-based features for hand movement within a KL-HMM framework to identify errors in manual components. However, modern deep learning models offer powerful spatio-temporal representations for videos to represent hand movement and facial expressions. Despite their success in classification tasks, these representations often struggle to attribute errors to specific sources, such as incorrect handshape, improper movement, or incorrect facial expressions. To address this limitation, we leverage and analyze the spatio-temporal representations from Inflated 3D Convolutional Networks (I3D) and integrate them into the KL-HMM framework to assess sign language videos on both manual and non-manual components. By applying masking and cropping techniques, we isolate and evaluate distinct channels of hand movement, and facial expressions using the I3D model and handshape using the CNN-based model. Our approach outperforms traditional methods based on handcrafted features, as validated through experiments on the SMILE-DSGS dataset, and therefore demonstrates that it can enhance the effectiveness of sign language learning tools.},
  keywords={Sign language;Hidden Markov models;Hands;Production;Videos;Manuals;Visualization;Signal processing;Feature extraction;Context modeling;Deep learning;explainability;hidden Markov models;sign language assessment;sign language recognition},
  doi={10.1109/OJSP.2025.3531781},
  ISSN={2644-1322},
  month={},}@INPROCEEDINGS{11205170,
  author={Oral, Okyanus and Feuillen, Thomas and Murtada, Ahmed and Rao, Bhavani Shankar Mysore Rama},
  booktitle={2025 IEEE Radar Conference (RadarConf25)}, 
  title={Fast Sparsity-Based 3D Near-Field MIMO Imaging Using b-SAGA with a Batch Size Selection Strategy}, 
  year={2025},
  volume={},
  number={},
  pages={751-756},
  abstract={Near-field imaging with multiple-input multiple-output (MIMO) arrays suffers from high computational cost. This hinders the practicality of conventional optimization techniques for large-scale sparsity-based imaging. In this paper, we address this issue and reduce the total runtime using a stochastic gradient strategy with variance reduction. Specifically, we utilize the Batch-Stochastic-Average-Gradient-Ameliore algorithm, which retains the convergence rate of the full proximal gradient method while reducing per-iteration cost. To our knowledge, this is the first time stochastic gradients with variance reduction have been applied to near-field MIMO radar imaging. In parallel, we provide a practical batch size selection strategy to improve runtime, which can also be used with other batch-based optimization methods for various radar image formation problems. We demonstrate using real-world measurements and total variation regularization that, compared to full and standard stochastic proximal gradient methods, the developed approach achieves speedups of over 5x and 23x, respectively, reducing runtime from the order of minutes to tens of seconds while maintaining high image quality.},
  keywords={Image quality;Gradient methods;Runtime;Three-dimensional displays;MIMO radar;Imaging;Total variance;Radar;Radar imaging;Standards;MIMO radar imaging;near-field;variance reduction technique;stochastic gradient;proximal algorithm},
  doi={10.1109/RadarConf2559087.2025.11205170},
  ISSN={2375-5318},
  month={Oct},}@INPROCEEDINGS{11292326,
  author={Ahmed, Saadaldeen Rashid and Hadi, Ali and Baddour, Leena Sameer and Ali, Haider Alaa Mohammed and Asaad, Ameer Yalmaz Asaad and Fashakh, Abdulnaser M. and Khames, Qudama and Nassrullah, Aymen Hasan Ali and Miah, Abu Saleh Musa},
  booktitle={2025 3rd International Conference on Cyber Resilience (ICCR)}, 
  title={Alzheimer’s Disease Prediction Using MRI-PET Fusion Through Multi-Modal Deep Learning With Late Fusion Techniques}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={This research presents an advanced deep learning framework for Alzheimer’s Disease prediction through multimodal MRI-PET fusion, integrating modality-specific encoders and late-stage attention-guided fusion. Utilizing dual-stream 3D CNN architectures—3D-ResNet for structural MRI and a custom PET-CNN for metabolic imaging—the model applies gated attention to maintain modality integrity and enhance semantic alignment at the decision level. Evaluation across large-scale neuroimaging cohorts including ADNI, AIBL, and OASIS-3 yielded classification accuracies up to 98.7%, with peak F1-scores of 0.894 and AUC values ranging from 0.92 to 0.96, confirming reliable stage differentiation among CN, MCI, and AD groups. Against unimodal and early fusion baselines, the proposed system achieved a 5.1–6.2% accuracy increase and reduced false positive rates by 25–28%, particularly in early MCI detection scenarios. Through domain-adaptive regularization and cohort-invariant training, the framework generalizes robustly across external datasets without retraining. The low-latency inference pipeline ( ≤ 160ms per subject) enables clinical integration, while its modular encoder architecture supports scalable extension to new imaging modalities and neurodegenerative markers with minimal reconfiguration.},
  keywords={Deep learning;Neuroimaging;Training;Solid modeling;Accuracy;Three-dimensional displays;Magnetic resonance imaging;Semantics;Logic gates;Alzheimer's disease;Alzheimer’s Disease;Deep Learning;MRI-PET Fusion;Late Fusion;Cognitive Decline Prediction;Neuroimaging Biomarkers;Multi-Modal Networks;Medical AI},
  doi={10.1109/ICCR67387.2025.11292326},
  ISSN={},
  month={July},}@INPROCEEDINGS{10923473,
  author={O.F.Ibrahim and Fadhil, Sabeeh Thamer and Kareem, Zaid Hikmat and Manea, Maryam Jamal and Almusawi, Muntather and Ahmed, Abeer and Attiwi, Madi Hashem},
  booktitle={2024 International Conference on IoT, Communication and Automation Technology (ICICAT)}, 
  title={AI Diagnosis of Mild Cognitive Impairment in Neurodegenerative Diseases from FDG Pet Images}, 
  year={2024},
  volume={},
  number={},
  pages={687-692},
  abstract={Objective This study aimed to develop and validate a deep learning FDG-PET scanning algorithm that may differentiate between patients who have developed moderate cognitive decline compared to the patients having been diagnosed with one of the following neuronal diseases: frontotemporal degeneration and dementia with lewy bodies, and both. A 3D Convolutional brain network that was proposed and trained using images from the Brain scans Institute for Alzheimer’s collection. It contained a dataset used in training and testing the model: the ADNI, which holds data of 822 participants. Also, a dataset from Technological Institute and La Fe Institute was used for the evaluation, which consisted of 91 participants with MCI, of which 71 acquired neurologic condition afterward, while the remaining 19 do not. The model, when tested on the 10% ADNI dataset, identified neurologic illness in patients with an accuracy of 79%, an awareness of 88%, and a specificity of 71%. It further achieved an area around the receiver operating curves of 0.90. Moreover, the model retained its 80% balance accuracy, 75% awareness, 84% specificity, and 0.86 AUC in the external verification. With an overall accuracy of 80% for its balanced classification, this binary classifier algorithm developed through deep learning in PET scan images can become instrumental for the early findings of a neurologic disease in patients with MCI under a standard clinical setting. Definition of Mild Cognitive Impairment MCI is the transitional stage between normal cognitive ageing and dementia, most commonly caused by neurodegenerative diseases such as Alzheimer’s disease. Successful and early identification of patients with MCI at risk for converting their disorder into a neurodegenerative condition is mandatory for timely intervention and management.},
  keywords={Deep learning;Accuracy;Three-dimensional displays;Hospitals;Brain modeling;Convolutional neural networks;Alzheimer's disease;Positron emission tomography;Biological neural networks;Diseases;Artificial Intelligence;FDG PET;Mild Cognitive Impairment;Neurodegenerative Disease;Deep Learning;Alzheimer’s Disease;Dementia;Convolutional Neural Networks;Early Diagnosis;Brain Imaging},
  doi={10.1109/ICICAT62666.2024.10923473},
  ISSN={},
  month={Nov},}@ARTICLE{10552290,
  author={Asif, Sohaib and Zhao, Ming and Li, Yangfan and Tang, Fengxiao and Zhu, Yusen},
  journal={IEEE Journal of Biomedical and Health Informatics}, 
  title={CFI-Net: A Choquet Fuzzy Integral Based Ensemble Network With PSO-Optimized Fuzzy Measures for Diagnosing Multiple Skin Diseases Including Mpox}, 
  year={2024},
  volume={28},
  number={9},
  pages={5573-5586},
  abstract={In the domain of medical diagnostics, precise identification of various skin and oral diseases is vital for effective patient care. In particular, Mpox is a potentially dangerous viral disease with zoonotic origins, capable of human-to-human transmission, underscoring the urgency of precise diagnostic methods for timely intervention. This paper introduces a novel approach named the Choquet Fuzzy Integral-based Ensemble (CFI-Net) for accurate classification of skin diseases, with a specific emphasis on detecting Mpox, foot ulcers, and various mouth and oral diseases. Our methodology begins with Transfer Learning, enhancing the classification capabilities of base classifiers (DenseNet169, MobileNetV1 and DenseNet201) by incorporating additional layers. Subsequently, we aggregate the prediction scores from each base classifier using the Choquet fuzzy integral (CFI) to derive the final predicted labels, thus ensuring dynamic and robust predictions. Fuzzy measures, a crucial component of this fuzzy integral-based ensemble method, are typically determined through manual experimentation in previous approaches. However, in our study, we have tackled the challenge of manual tuning by employing meta-heuristic optimization algorithm to precisely configure the fuzzy measures for optimal performance. A rigorous evaluation is conducted on four publicly available datasets, encompassing two Mpox datasets, a foot ulcer dataset, and a mouth and oral disease dataset. The experiments reveal the remarkable effectiveness of CFI-Net in significantly improving disease classification accuracy. Additionally, we employ Grad-CAM analysis to provide insights into the decision-making processes of our models. Our findings underscore the exceptional performance of CFI-Net, achieving accuracy rates of 98.06% and 94.81% for Mpox detection, 99.06% for foot ulcer detection, and an impressive 99.61% for mouth and oral disease classification. This research not only contributes to the advancement of disease diagnosis but also demonstrates the effectiveness of ensemble learning techniques coupled with fuzzy integral-based fusion in enhancing diagnostic accuracy.},
  keywords={Diseases;Skin;Medical diagnosis;Ensemble learning;Medical diagnostic imaging;Fuzzy logic;Transfer learning;Particle swarm optimization;Mpox;choquet fuzzy integral-based ense- mble;fuzzy logic;disease classification;transfer learning},
  doi={10.1109/JBHI.2024.3411658},
  ISSN={2168-2208},
  month={Sep.},}@INPROCEEDINGS{9219698,
  author={Shaafi, Aymen and Salem, Osman and Mehaoua, Ahmed},
  booktitle={2020 IEEE Symposium on Computers and Communications (ISCC)}, 
  title={Improving the Recognition of Sign Language from Acquired Data by Wireless Body Area Network}, 
  year={2020},
  volume={},
  number={},
  pages={1-6},
  abstract={Accurate and fast recognition of sign language would greatly improve communications between the deaf and the hearers using hand-held devices. We used Myo armband as our wireless data measurement device, which is wearable technology equipped with on-board 3D Accelerometer, 3D Gyroscope and 8 channel Electromyogram acquisition system. The main objective of this paper is to provide a lightweight approach for American Sign Language recognition by reducing the dimensionality of inputs using a novel method. Data from each sensors are aggregated into one dimension to reduce the required time for data processing, as well as the amount of required memory for storage. Afterward, we extract features from aggregated data and we proceed to classification using Support Vector Machine (SVM). We compare the performance of SVM with and without our aggregation approach. Our experimental results prove that our proposed approach improves the speed of model derivation (four times faster than existing methods) and reduces the size of input data with the same accuracy.},
  keywords={Support vector machines;Wireless communication;Wireless sensor networks;Three-dimensional displays;Computational modeling;Memory management;Gesture recognition;3D Accelerometer;3D Gyroscope;Surface EMG;ASL;SVM;IMU},
  doi={10.1109/ISCC50000.2020.9219698},
  ISSN={2642-7389},
  month={July},}@INPROCEEDINGS{9291618,
  author={de Lima, Edirlei Soares and Gheno, Felipe João and Viseu, Ana},
  booktitle={2020 19th Brazilian Symposium on Computer Games and Digital Entertainment (SBGames)}, 
  title={Sketch-Based Interaction for Planning-Based Interactive Storytelling}, 
  year={2020},
  volume={},
  number={},
  pages={154-162},
  abstract={Drawings have been used for thousands of years as a visual complement to oral and written storytelling. The evolution of technology and the advent of interactive narratives brings the possibility of exploring drawings and storytelling in new ways. This paper presents a new sketch-based interaction method for planning-based interactive storytelling systems, which uses a deep learning model based on a Convolutional Neural Network to recognize digital hand-drawn sketches. By combining real time sketch recognition with a planning-based plot generation algorithm, the proposed system allows users to interact with narratives by sketching objects on smartphones or tablet computers, which are then recognized by the system and converted into virtual objects in the story world, thereby affecting the plot of the narrative. Preliminary results show that the sketch recognition model has a remarkable accuracy for small sets of sketch classes (accuracy of 95.1 % for 14 classes), which are sufficient to provide a good variety of interaction options. In addition, it can also be extended to more complex scenarios while maintaining a considerable accuracy (87.4% for 172 classes and 71.6% for 345 classes).},
  keywords={Games;Three-dimensional displays;Visualization;Servers;Planning;Tablet computers;Solid modeling;interactive storytelling;sketch-based interaction;automated planning;sketch recognition;interactive narratives},
  doi={10.1109/SBGames51465.2020.00029},
  ISSN={2159-6662},
  month={Nov},}@INPROCEEDINGS{11390252,
  author={Suganya, S. and Banupriya, B.K and Vadivu, N. and Babu, J. Jagan and Shankar, T.A. Sathish and Krishnamoorthy, Rajaram},
  booktitle={2025 International Conference on Intelligent Computing, Information and Control Systems (ICOIICS)}, 
  title={Multi-Resolution Transformer-Augmented Efficientnet for Explainable Breast Cancer Histopathology Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={1395-1403},
  abstract={Diagnosis of breast cancer based on the histopathology images requires clinical reliability that is based on accurate and interpretable models. The proposed study is Multi-Resolution Transformer-Augmented EfficientNet (MRTAE) framework, a framework that combines EfficientNet to extract scale-wise features with a transformer layer to resolve long-range spatial relationships across scales. The model improves contextual perception and offers explainable predictions by use of Grad-CAM++ visualization. Architecture tests on benchmark datasets like BreakHis and Camelyon17 show excellent performance in accuracy, F1-score and interpretability over the traditional CNN-based ones. The suggested MR-TAE can be considered a good compromise between diagnostic accuracy and transparency as a high-tech tool that can help pathologists in the detection and classification of breast cancer.},
  keywords={Accuracy;Histopathology;Computational modeling;Transforms;Transformers;Feature extraction;Breast cancer;Reliability;Spatial resolution;Context modeling;Breast cancer detection;EfficientNet;Transformer;Explainable AI;Histopathology images},
  doi={10.1109/ICOIICS67115.2025.11390252},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10395597,
  author={Mauryan, K. S. Chandragupta and Nishat, Humaira and Arunkumar, U. and Megaladevi, P.},
  booktitle={2023 7th International Conference on Electronics, Communication and Aerospace Technology (ICECA)}, 
  title={Earlier Detection of Pancreatic Cancer Using Neural Network Based Optimization Technique}, 
  year={2023},
  volume={},
  number={},
  pages={1014-1022},
  abstract={Medical healthcare systems are being extensively studied, giving computer technology lots of space to innovate. The most important medical research is predicting cancer, which may take numerous forms and affect many body parts. One of the most common fatal diseases is pancreatic cancer, which cannot be cured once identified and is sometimes unexpected since it is placed in the abdomen beyond the stomach. CT and MRI often give CAD, quantitative evaluations, and automated pancreatic cancer segmentation. These cancer classification methods might identify, predict, and assist personalized medicine to cure cancer without malignant invasions. Flying Squirrel optimization segments, extracts, and classifies features. CNN coupled with Frog Leap optimization. The proposed approach uses frog leap optimization to identify picture normalcy and abnormality. The suggested method minimizes errors for correct classification. Segmenting the aberrant picture with an adaptive flying squirrel algorithm determines cancer size and severity. The more efficient CNN-FLFS method predicts pancreatic cancer with 99% accuracy.},
  keywords={Image segmentation;Stomach;Space technology;Pancreatic cancer;Feature extraction;Prediction algorithms;Tumors;MRI;Convolutional Neural Network;Frog Leap optimization;Fly Squirrel Optimization},
  doi={10.1109/ICECA58529.2023.10395597},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11479202,
  author={S, Narendra kumar and G, Sanjeevi and Gopalakrishnan, Uma and K, Subramania Iyer},
  booktitle={2026 Twelfth International Conference on Bio Signals, Images, and Instrumentation (ICBSII)}, 
  title={Optimal Temporal Window Selection for 3D CNN-Based VFSS Swallowing Phase Classification}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={The Videofluoroscopic Swallowing Study (VFSS) is the gold standard for assessing swallowing. The swallowing process has three phases: oral, pharyngeal, and esophageal. Identifying these swallowing phases is essential for dysphagia assessment, but this process is currently done manually by clinicians, which is time-consuming and prone to inter-rater variability. This study proposes a deep learning framework for automatic detection of swallowing phases for VFSS video analysis. In this study, the VFSS sequences are pre-processed into fixed-length clips and are trained and validated using three 3D Convolutional Neural Network (3D CNN) models: 3D ResNet-18, Mixed Convolution 3D (MC3), and R2plus1D-18. Each model is trained under two settings: (i). with pretrained weights, (ii). without pretrained weights and with various temporal lengths ranging from 2 frames to 9 frames per window. A patient-wise 5-fold validation is performed to prevent data leakage across subjects and to verify the model's performance. The best models from 5-fold validation with the best average validation accuracy are used to build a decision-making model using soft voting based on class probability. The R2plus1D-18 model with a temporal length of 4 frames per window has the best performance with validation accuracy, precision, and f1-score of $95.46 \%, 95.4 \%$, 95.2%, respectively. The proposed system can provide accurate and automated swallowing phase classification, which has the potential to reduce subjectivity and time consumption and can also assist clinicians in VFSS analysis.},
  keywords={Videos;Protocols;Video equipment;Location awareness;Radio access networks;Regional area networks;HTTP;Mobile communication;Communication systems;Event detection;Videofluoroscopic Swallowing Study;Swallowing phase classification;Dysphagia;Deep learning;3D CNN},
  doi={10.1109/ICBSII69710.2026.11479202},
  ISSN={2768-6450},
  month={March},}@INPROCEEDINGS{11103660,
  author={Sherazi, Syed Ahsan Raza and Sherazi, Syed Sibtul Hassan and Butt, Nauman Zafar and Shakil, Marium and Engstrøm, Daniel Southcott and Hossain, Kazi Md Shahadat},
  booktitle={2025 IEEE International Conference on Electro Information Technology (eIT)}, 
  title={Minimally Invasive Micro Needle Sensors for Plant Growth Analysis in Agrivoltaic Fields}, 
  year={2025},
  volume={},
  number={},
  pages={350-355},
  abstract={A plant's physiology is constantly evolving depending on the environment it grows. The critical environmental factor for a plant is its exposure to sunlight. With the increase in the adoption of renewable energy, vast agricultural lands are subject to the mass deployment of solar panels, due to which plant growth is severely affected by the blockage of sunlight. To monitor the health of these plants and extract key growth factors, we need to develop wearable plant sensors. Our project aims to design and fabricate a micro needle array (MNA) based minimally invasive sensor which can observe minute changes in plant physiology. This MNA sensor should be capable of continuous data acquisition in real-time using electronic sensing of versatile physiological aspects, mainly electrical impedance. The MNA sensor would constitute MNA's serving as electrodes, an AD5933 impedance analyzer chip, an analog frontend circuit, and an Arduino Uno microcontroller unit for data processing. After the MNA sensor is designed and fabricated, we will test it on the agrivoltaic field. Categorization must be done on the acquired data to extract useful information regarding plant growth. Electrical impedance data can provide valuable insights like water content, ion concentration, and fluid movement, which can aid us in finding optimal health conditions for a plant to grow. We will first fabricate a high aspect ratio MNA while ensuring low fabrication cost and successfully implementing RF impedance spectroscopy for improved performance compared to biomass determination. The sensor circuit will help us analyze how nutrients, growth stage, water content, acclimation, and damage related to the impedance measurement. Our MNA sensor will be capable of providing distinguished data for a plant under normal conditions and under agrivoltaic settings. Using the MNA sensor on different plants under different conditions will allow us to find specific plants suited for shaded regions, which can help us utilize the agrivoltaic regions efficiently and effectively.},
  keywords={Spectroscopy;Minimally invasive surgery;Needles;Three-dimensional printing;Sensors;Impedance;Solar panels;Biomedical monitoring;Wearable sensors;Sensor arrays;Microneedle;Plants;Sensor;3D Printer;Impedance Analyzer},
  doi={10.1109/eIT64391.2025.11103660},
  ISSN={2154-0373},
  month={May},}@INPROCEEDINGS{10986615,
  author={Rouf, Muntaha and Jadon, Jitendra Singh},
  booktitle={2025 3rd International Conference on Disruptive Technologies (ICDT)}, 
  title={Generative AI for Text to Speech and Sign Language Translation}, 
  year={2025},
  volume={},
  number={},
  pages={1124-1129},
  abstract={This paper presents the development of an AI-powered platform designed to enhance real-time communication for individuals with speech and hearing impairments. The system integrates 3D animation, Natural Language Processing[15] (NLP), and Automatic Speech Recognition [1] [2] (ASR) to convert spoken words into sign language gestures. By utilizing advanced speech recognition models, natural language understanding, and dynamic 3D [6] gesture generation, the platform ensures a smooth and intuitive communication experience. To promote inclusivity, the system supports both multilingual and regional sign languages, making it accessible across diverse linguistic and cultural backgrounds. This solution bridges the gap in real-time communication tools by offering a scalable and accessible platform for both web and mobile applications. Ultimately, the goal is to empower individuals with disabilities, enhance their interaction with digital environments, and foster greater social inclusion.},
  keywords={Sign language;Three-dimensional displays;Translation;Auditory system;Speech enhancement;Real-time systems;Natural language processing;Multilingual;Text to speech;Noise measurement;generative AI;sign language;text to speech;natural language processing},
  doi={10.1109/ICDT63985.2025.10986615},
  ISSN={},
  month={March},}@INPROCEEDINGS{11275344,
  author={Kondo, Tsubasa and Inoue, Michiko and Yoneda, Shunsuke and Nishiyama, Masashi},
  booktitle={2025 IEEE 14th Global Conference on Consumer Electronics (GCCE)}, 
  title={Reducing Computational Cost in Pedestrian Conversation Activity Recognition through Skeleton Spatiotemporal Graphs}, 
  year={2025},
  volume={},
  number={},
  pages={808-811},
  abstract={The existing method for recognizing conversation activity in walking pedestrian groups uses heavy three-dimensional mesh reconstruction and rendering, which significantly increases the computational cost. We investigate a lightweight framework that replaces skinned multi-person linear model mesh structures using skeleton spatiotemporal graphs extracted from general color video sequences to recognize the conversation activity labels. Compared with the existing method, our approach reduces inference time and graphics processing unit memory while maintaining equal or higher accuracy, which makes low computational cost conversation activity recognition feasible.},
  keywords={Pedestrians;Accuracy;Video sequences;Graphics processing units;Oral communication;Color;Activity recognition;Skeleton;Spatiotemporal phenomena;Computational efficiency;Recognition;Conversation activity;Computational cost;Skeleton;Spatiotemporal graphs},
  doi={10.1109/GCCE65946.2025.11275344},
  ISSN={2693-0854},
  month={Sep.},}@INPROCEEDINGS{10958134,
  author={Dababo, Razan and Wang, Ming-Hwa},
  booktitle={2024 International Conference on Image Processing, Computer Vision and Machine Learning (ICICML)}, 
  title={Speech2Sign with ASL-Transformers and SL-GAN}, 
  year={2024},
  volume={},
  number={},
  pages={965-971},
  abstract={Sign language is an essential means of communication for the deaf and hard-of-hearing, yet its translation and production are uniquely challenging due to its multimodality and the ambiguity of aligning spoken language sentences with visual signs. The objective of automatic Sign Language Production (SLP) is to transform speech into sign language videos that closely match the accuracy and expressiveness of a human interpreter, facilitating communication between the deaf community and the predominantly speaking world. Many prior SLP works have taken a gloss-free approach at the expense of accuracy, or have produced low-quality 2D sign poses as the final output, failing to convey the intricacies of sign language. Contrary to these approaches, we demonstrate the merits of gloss, a well-crafted loss function, and a multi-scale Generative Adversarial Network (GAN) in the production of accurate and photorealistic sign language videos. Our approach is a multistage SLP framework that begins with translating transcribed speech to its written sign language notation (gloss) using our ASL-Transformers model. We then map the gloss to its dictionary sign frames through a database query and generate the corresponding 2D pose sequence with DWPose, a pretrained pose estimator. Finally, we synthesize a photorealistic sign language video from the 2D pose sequence using our SL-GAN, a pose-conditioned image generation model. We evaluate our ASL-Transformers on the ASLG-PC12 dataset, reporting a BLEU-4 score of 89.58, and our SL-GAN on the ASLLVD dataset, reporting a mean SSIM value of 0.921.},
  keywords={Sign language;Visualization;Translation;Accuracy;Dictionaries;Image synthesis;Production;Assistive technologies;Generative adversarial networks;Videos;Sign Language Production;Transformers;Generative Adversarial Network;American Sign Language;Gloss;Pose Estimation;Sign Language Video},
  doi={10.1109/ICICML63543.2024.10958134},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11467021,
  author={Pan, Yunping and Zhang, Wen and He, Lizhe and Wu, Changquan and Liao, Lieping},
  booktitle={2025 9th International Conference on Electrical, Mechanical and Computer Engineering (ICEMCE)}, 
  title={Research on Gear Fault Feature Extraction of Electric Drive Axle Main Reducer based on ADAMS}, 
  year={2025},
  volume={},
  number={},
  pages={281-287},
  abstract={To address the challenge of accurately identifying gear faults in the main reducer of electric drive axles, this paper proposes a fault feature extraction method that integrates multi-body dynamic simulation with adaptive signal processing. First, a 3D model of the gear reducer is built using UG, and a rigid-flexible coupled dynamic model is constructed by combining ANSYS and ADAMS. The dynamic responses of the gears under four conditions–healthy, broken teeth, pitting, and wear–are simulated and analyzed. Then, vibration signals from the reducer housing are extracted, and the Variational Mode Decomposition (VMD) parameters are adaptively optimized using the Sparrow Search Algorithm (SSA), which enables effective signal decomposition and mode selection. Subsequently, Hilbert envelope spectral analysis is performed on representative intrinsic mode functions to extract fault features under different gear conditions. The results demonstrate that the proposed method can effectively isolate gear fault signatures, enhance the distinguishability of fault modes, and provide a theoretical foundation and methodological reference for intelligent fault diagnosis of electric drive axle reducers.},
  keywords={Contacts;Circuits and systems;Modulation;Protocols;Communications technology;HTTP;Particle swarm optimization;Cognitive systems;Swarm intelligence;Artificial intelligence;electric drive axle main reducer;Adams;VMD;sparrow search algorithm;gear;feature extraction},
  doi={10.1109/ICEMCE68156.2025.11467021},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10042654,
  author={Khatri, Ajeeta and Butler, Zachary and Nwogu, Ifeoma},
  booktitle={2023 IEEE 17th International Conference on Automatic Face and Gesture Recognition (FG)}, 
  title={Analyzing Interactions in Paired Egocentric Videos}, 
  year={2023},
  volume={},
  number={},
  pages={1-7},
  abstract={As wearable devices become more popular, ego-centric information recorded with these devices can be used to better understand the behaviors of the wearer and other people the wearer is interacting with. Data such as the voice, head movement, galvanic skin responses (GSR) to measure arousal levels, etc., obtained from such devices can provide a window into the underlying affect of both the wearer and his/her conversant. In this study, we examine the characteristics of two types of dyadic conversations. In one case, the interlocutors discuss a topic on which they agree, while the other situation involves interlocutors discussing a topic on which they disagree, even if they are friends. The range of topics is mostly politically motivated. The egocentric information is collected using a pair of wearable smart glasses for video data and a smart wristband for physiological data, including GSR. Using this data, various features are extracted including the facial expressions of the conversant and the 3D motion from the wearer's camera within the environment - this motion is termed as egomotion. The goal of this work is to investigate whether the nature of a discussion could be better determined either by evaluating the behavior of an individual in the conversation or by evaluating the pairing/coupling of the behaviors of the two people in the conversation. The pairing is accomplished using a modified formulation of the dynamic time warping (DTW) algorithm. A random forest classifier is implemented to evaluate the nature of the interaction (agreement versus disagreement) using individualistic and paired features separately. The study found that in the presence of the limited data used in this work, individual behaviors were slightly more indicative of the type of discussion (85.43% accuracy) than the paired behaviors (83.33% accuracy).},
  keywords={Training;Three-dimensional displays;Heuristic algorithms;Hidden Markov models;Oral communication;Feature extraction;Skin},
  doi={10.1109/FG57933.2023.10042654},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{11251975,
  author={Nevedida, M. and Mahalakshmi, P. and Patel, Mehulkumar Surendrabhai and Abozibid, Hassan Khalid and Ali, Abd and Mohammed, Nada Qasim},
  booktitle={2025 International Conference on Recent Innovation in Science Engineering and Technology (ICRISET)}, 
  title={Computer Vision-Based Consumer Behavior Analysis Framework for Retail Store Layout Optimization}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={In this digital age, where the world of retail is characterized as smart, visual data has become more relevant as customers tend to be better served in retail stores in enhancing their customer experiences and pushing sales. The presented research offers the prospect of an innovative computer vision-based method of analyzing consumer behavior to optimize the layout of retail stores using the recent advances in the deep learning models and real-time video analytics. The system combines object detector (YOLOv8), human pose (OpenPose) and action recognition models to track the movements, dwell times, and interactions with products in the store. Machine learning and your space data come together to provide the spatial analytics for the system by cross-referencing patterns of space and time, resulting in prescriptive solutions as to how to get more traffic in some areas, how to improve performance in underutilized spaces, and what locations are hotspots of customer activity. As an implementation, the framework leverages NVIDIA DeepStream SDK that allows effective edge processing and deployment at scale. The potential of the system to produce high levels of accuracy in the tracking of behavior and impact assessment of a layout have been established through experimental analyses in a simulated retail setting.},
  keywords={Deep learning;Technological innovation;Consumer behavior;Tracking;Computational modeling;Visual analytics;Layout;Information age;Real-time systems;Optimization;Computer Vision;Deep Learning;Retail Analytics;Consumer Behavior;Store Layout Optimization;DeepStream SDK},
  doi={10.1109/ICRISET64803.2025.11251975},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11485625,
  author={G, Janani V and S, Vasuki and R, Alagu Udhayashree and S, Indhu and R, Harini and S, Subashini},
  booktitle={2026 6th International Conference on Expert Clouds and Applications (ICOECA)}, 
  title={Attention-based Multiple Instance Learning for Cancer Diagnosis using Histopathology Image}, 
  year={2026},
  volume={},
  number={},
  pages={1594-1599},
  abstract={Oral cancer diagnosis using histopathology whole-slide images (WSIs) presents significant challenges due to their high-resolution and a large-scale, Inconsistent staining patterns and the lack of granular labeling. To solve these issues, we introduce an efficient Multiple Instance Learning (MIL)-based framework for automated oral cancer classification that Integrates smart preprocessing, compact neural networks, and graph-enhanced MIL techniques a lightweight deep learning backbone, and explainable artificial intelligence. During the preprocessing, WSIs are to be segmented to eliminate background regions and then divided into non-overlapping patches of 224×224 pixels and to mitigate staining inconsistencies, the Macenko normalization method is employed for followed by data augmentation techniques such as flipping, rotation, Color variation augmentation improve model by stability generalization and minimize overfitting. For patch-level feature extraction, we need to utilize ResNet50, a widely adopted convolutional neural network (CNN) capable of capturing fine-grained textural and morphological details of oral tissue. This are the backbone achieves a Designed to maximize feature richness while minimizing computational load, making it well-suited for large-scale histopathology tasks and the extracted patch embeddings are aggregated through attention-based MIL pooling, enabling the model to automatically highlight diagnostically relevant regions—such as epithelial dysplasia, keratin pearl formation, and nuclear abnormalities without a requiring patch-level labels. To further proceed boost efficiency, the framework which integrates self-supervised pretraining for domain adaptation, Knowledge distillation enables the compression of high-capacity teacher models into lightweight student architectures and advanced optimizers for stable convergence. Post-training quantization is applied to reduce a model size and accelerate inference, facilitating deployment in clinical environments and the system outputs both cancer classification results (benign, precancerous, malignant) and interpretability maps via attention visualization and Grad-CAM, which emphasize the most discriminative tissue patches. These explainability tools assist can pathologists in validating model predictions, thereby strengthening trust and clinical adoption. Experimental findings demonstrate that the proposed approach outperforms that conventional CNN-based methods. In summary, this ResNet50-MIL framework delivers a scalable, interpretable, and resource-efficient solution for oral cancer diagnosis in digital pathology.},
  keywords={Radio broadcasting;Frequency modulation;Pixel;Protocols;Modulation;Radio broadcasting;HTTP;Frequency modulation;Digital images;Convolutional neural networks;Cancer;Artificial Intelligence;Multiple Instance Learning (MIL);Attention-based Deep Learning;ResNet50;Swin Transformer;Stain Normalization;Digital Cancer Diagnosis;Explainable AI (XAI)},
  doi={10.1109/ICOECA68095.2026.11485625},
  ISSN={},
  month={March},}@INPROCEEDINGS{11088410,
  author={Majeed, Hassan Mazen and Jarjees, Mohammed Sabah},
  booktitle={2nd International Conference on Emerging Trends and Applications in Artificial Intelligence (ICETAI 2024)}, 
  title={Reduce metal artifact (MAR) on CBCT image}, 
  year={2024},
  volume={2024},
  number={},
  pages={630-636},
  abstract={Modern dentistry has greatly benefited from the major advancements in diagnostic accuracy and treatment planning brought about by key technology like intraoral scanners and Cone-Beam Computed Tomography (CBCT). In order to improve the CBCT dental-maxillofacial images, several image processing approaches have been suggested. This study means to explore different picture handling methods to work on the nature of CBCT pictures. Twofold covering and Gaussian obscuring are utilized to increment picture lucidity and relic end. Measurements for assessing quality incorporate commotion levels, entropy, mean squared blunder (MSE), and top sign to-clamor proportion (PSNR). As indicated by the discoveries, the subsequent picture has the most noteworthy PSNR of 42.16 dB, the least MSE of 1.6 dB, and the greatest entropy of 6.8 dB. Moderate levels of commotion and intricacy were found in the third photo. These discoveries show that the proposed picture handling techniques effectively improve the nature of the CBCT pictures, and they can be applied in clinical settings such 3D dental models. This work opens another heading in the utilization of estimation hypothesis to down to earth biomedical imaging issues and sets the way for future examination into the improvement of picture handling methods for clinical imaging.},
  keywords={},
  doi={10.1049/icp.2025.0153},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11168648,
  author={Soma Sundari, V. and Fallahhusein, Muhamed and N, Ramesh Babu. and R, Varsha. and Naga Saranya, N.},
  booktitle={2025 3rd International Conference on Data Science and Network Security (ICDSNS)}, 
  title={Translation of Sign Language into Nepali Speech Using a Context-Aware Neural Network Framework}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={In recent years, communication between hearing-impaired individuals and the general public has remained a major challenge, especially in Nepal where assistive technologies are limited. The existing convolutional neural network (CNNs) model for sign language translation is often restricted to static gesture recognition, lacks sentence-level comprehension, and provides a minimal contextual understanding. To overcome these challenges, this research proposes the Translation of Sign Language using a Context-Aware Neural Network Framework (TransSign-Net) designed to translate American Sign Language (ASL) into context-aware Nepali speech. Initially, the ASL dataset comprising 68,400 gesture images was preprocessed using min-max normalization. The system then employs a Multimodal Feature Fusion Network (MFF-Net) that integrates the Red-Green-Blue (RGB) frames, MediaPipe extracted hand, and pose keypoints. These features are passed through a Context-Aware Neural Network (CANN) that has both 3D CNN and Temporal Convolutional Network (TCN) layers to capture spatiotemporal dimensions. A Transformer-based Contextual Language Reasoning Module (CLRM) converts glosses into semantically accurate Nepali sentences. Finally, Google Text-to-Speech (gTTS) synthesizes the output as natural speech, and a PyQt-based Graphical User Interface (GUI) enables seamless real-time interaction. The experimental results show that TransSign-Net model achieves 99.9\% classification accuracy and over 95% sentence-level translation accuracy over the existing CNN model.},
  keywords={Sign language;Translation;Accuracy;Neural networks;Feature extraction;Transformers;Text to speech;Spatiotemporal phenomena;Convolutional neural networks;Graphical user interfaces;context-aware neural network;google text-to-speech;multimodal feature fusion network;nepali speech;translation of sign language},
  doi={10.1109/ICDSNS65743.2025.11168648},
  ISSN={},
  month={July},}@INPROCEEDINGS{9928488,
  author={Yang, Yicheng and Bai, Weibang and Lo, Benny},
  booktitle={2022 IEEE-EMBS International Conference on Wearable and Implantable Body Sensor Networks (BSN)}, 
  title={A Customized Artificial Ear Based on Vibrotactile Feedback: A Pilot Study}, 
  year={2022},
  volume={},
  number={},
  pages={1-4},
  abstract={Hearing aid devices have been around for decades, while most of them focus on sound amplification and SNR improvement. This paper proposes an artificial ear based on the vibrotactile feedback. The speech signal is converted into the vibrotactile devices placed around the subject’s ear through the speech recognition algorithm and pattern coding method. Preliminary experiments on the prototype consisting of six motors which has shown that the recognition accuracy of letters and daily sentences reached 90%. The learning time of interpreting the vibrotactile signals could be less than four times that in real-time conversation, proving the feasibility of the proposed device for real-life application.},
  keywords={Speech coding;Prototypes;Speech recognition;Ear;Oral communication;Hearing aids;Real-time systems;hearing aid;artificial ear;vibrotactile},
  doi={10.1109/BSN56160.2022.9928488},
  ISSN={2376-8894},
  month={Sep.},}@INPROCEEDINGS{11039390,
  author={Sangolgi, Vijay A and Patil, Mithun B and Bhosale, Omkar Nagnath and Deshmukhe, Anurag Vivek and Jawalgi, Pallavi Bhimrao and Katwe, Srushti Prabhakar},
  booktitle={2025 7th International Conference on Signal Processing, Computing and Control (ISPCC)}, 
  title={A Unified Deep Learning Framework for Lip Reading and Deep Fake Audio Classification}, 
  year={2025},
  volume={},
  number={},
  pages={34-40},
  abstract={This study proposes a multimodal framework designed to enhance deepfake detection by integrating visual lip-reading analysis and audio signal processing for real-time applications. Leveraging LipNet—a deep learning model pre-trained on the GRID dataset—the system employs 3D convolutional neural networks (CNNs) combined with bidirectional long short-term memory (Bi-LSTM) layers to interpret lip movements and decode spoken words from visual inputs. Simultaneously, audio analysis modules evaluate acoustic features to detect synthetic or manipulated speech. By independently training these components and combining their outputs, the framework identifies inconsistencies between visual and auditory modalities, such as mismatched lip-audio synchronization or unnatural speech patterns. Experimental results demonstrate robust performance in both word-level lip-reading accuracy and deepfake detection reliability, achieving high precision in flagging fraudulent content. The system’s effectiveness in detecting audiovisual anomalies positions it as a practical tool for digital forensics and security applications, with potential to foster trust in digital media. Future work will expand the model’s adaptability to diverse datasets, including multilingual contexts, and refine its integration into real-world media authentication and accessibility tools.},
  keywords={Deep learning;Deepfakes;Visualization;Accuracy;Lips;Media;Feature extraction;Synchronization;Reliability;Long short term memory;cnn;bi-lstm;mfccs;audio authenticity;lip – reading;deep fake audio classification},
  doi={10.1109/ISPCC66872.2025.11039390},
  ISSN={2643-8615},
  month={March},}@INPROCEEDINGS{11484947,
  author={P.N.S.V.Tejaswini and Srinivasarao, T and Reddy, P.Neha and S.Harshith and Ramana, V. Bala Venkata},
  booktitle={2025 IEEE International Conference on Communication Networks and Computing (CNC)}, 
  title={Deep Learning Framework for Indian Sign Language Communication}, 
  year={2025},
  volume={},
  number={},
  pages={521-524},
  abstract={This research presents a deep learning-based framework for the real-time recognition and translation of Indian Sign Language (ISL) gestures into both text and spoken words. The goal is to improve communication between individuals who are deaf or hard-of-hearing and those who can hear. The framework uses a combined computer vision pipeline, integrating image preprocessing, keypoint extraction, and data augmentation to improve model performance. We collected a curated ISL dataset, which includes both isolated signs and continuous gesture sequences. Data collection followed standardized guidelines on lighting, background uniformity, signer variability, and class balance to ensure effectiveness in real-world conditions. For recognition, we created a hybrid neural network that uses Convolutional Neural Networks (CNNs) to extract important spatial features from hand shapes and body postures, along with temporal models like Long Short-Term Memory (LSTM) and 3D Convolutional Neural Networks (3D-CNNs) to capture motion dynamics. The training strategy includes transfer learning, adaptive learning rates, early stopping, and dropout methods to reduce overfitting and enhance model performance. We used accuracy, precision, recall, F1-score, and confusion matrix analysis as evaluation metrics for isolated and continuous sign recognition tasks. Experimental results on our dataset show high accuracy (over 98%) for isolated sign recognition and competitive performance for continuous sign sequences. This highlights the model's ability to handle both static and dynamic gestures. We implemented a prototype application for both desktop and mobile platforms, achieving real-time speeds and smooth translation from ISL to text and speech. These results suggest the system can serve as a practical communication tool with potential use in education, accessibility, and public services.},
  keywords={Activity recognition;Human activity recognition;Videos;Communication networks;Pixel;Smart phones;Video equipment;Protocols;HTTP;Communication systems;Indian Sign Language;Deep Learning;Convolutional Neural Network;Recurrent Neural Network;Transformer;Computer Vision;Assistive Technology},
  doi={10.1109/CNC68716.2025.11484947},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11484312,
  author={Pandey, Abhinav and Mizal, Kamal Sahib and Ali, Amina and Farhan, Mohsen Aued and Hisham, Ghasan and Zorah, Sajjad Mohammed},
  booktitle={2026 Innovations in Machine, Engineering, and Digital Conference (IMED)}, 
  title={Deep Learning-Based Pattern Recognition for Automated Medical Imaging}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Medical imaging is key to diagnosing and planning the treatment of diseases, but medical imaging analysis is generally not automated, requiring manual interpretation, which can take time, especially as such efforts typically involve variations in interpretation from observer to observer. This paper describes a deep learning-based framework for pattern recognition to facilitate automated medical imaging analysis. By employing convolutional neural networks (CNNs) and attention-based models, our framework, in collaboration with medical imaging, can accurately identify and classify abnormal radiology images, including X-rays, MRIs, CT scans, etc. The framework also incorporates explainable AI (XAI) approaches for establishing transparency, including Grad-CAM and LIME. Results indicated statistically significant improvements in detection accuracy, false positive reductions, and trust in clinician judgment. Unlike traditional and computerized contexts of computer-aided diagnosis (CAD), our model detects abnormal regions and explains the reasoning for a diagnosis, making it far more suited for a high-stakes medical decision-making environment. This framework partially resolves the disparity between AI-identified accuracy and human interpretations, ensuring any AI-based automated medical imaging analysis framework deployed in a medical clinician environment is deployed consistently and responsibly.},
  keywords={Payloads;MODIS;Feedback;Filtering;Circuits;Filters;MIMICs;Millimeter wave integrated circuits;Monolithic integrated circuits;Internet of Things;Deep Learning;Medical Imaging;Pattern Recognition;CNN;Image Classification;Diagnostic Support Systems;Computer-Aided Diagnosis (CAD)},
  doi={10.1109/IMED68921.2026.11484312},
  ISSN={},
  month={March},}@INPROCEEDINGS{9530911,
  author={Razali, Noor Fadzilah and Isa, Iza Sazanita and Sulaiman, Siti Noraini and Karim, Noor Khairiah A. and Osman, Muhammad Khusairi},
  booktitle={2021 11th IEEE International Conference on Control System, Computing and Engineering (ICCSCE)}, 
  title={High-level Features in Deeper Deep Learning Layers for Breast Cancer Classification}, 
  year={2021},
  volume={},
  number={},
  pages={170-175},
  abstract={Early detection of breast cancer is crucial when treating than cure in later mammogram screening processes. To date, researchers extensively proposed the implementation of artificial intelligence to develop a computer-aided system (CAD) to determine types of breast tumour lesion, whether benign or malignant. This approach is significant to minimise the rate of misinterpretation in false positive and false negative diagnosis results among radiologists. Lack of established medical datasets publicly available has become the main reason why the system is not fully implemented in clinical settings yet. This study is aimed to investigate the performance of a convolutional neural network (CNN) to detect cancerous lesion types. The pre-trained CNN networks are tested on two established public datasets, CBIS-DDSM and INbreast. Pre-processing using denoising and contrast limited adaptive histogram equalisation (CLAHE) and augmented to lessen the effect of overfitting. The pre-trained CNNs AlexNet and InceptionV3 represent shallow and deeper neural networks respectively, trained using the transfer learning method. Performance of the system is tested and its accuracy, losses, sensitivity, specificity, and receiver operating characteristic curve (ROC) are evaluated. The InceptionV3 network performs better with the highest testing and area under the curve (AUC) at 99.93% compared to shallower AlexNet at 98.92% using INbreast dataset. Training the system using augmented data is proven to improve testing accuracy at 86.7% from 60.26% using a non-augmented dataset in low-quality input images. Meanwhile, using a shallower network for transfer learning produces high accuracy results without compromising computational cost. This study serves as the platform to improve the system’s performance by varying the pretrained networks used and getting different features from each convolutional layer to be trained in the future.},
  keywords={Training;Solid modeling;Transfer learning;Generative adversarial networks;Mammography;Breast cancer;Convolutional neural networks;Breast cancer;mammogram;convolutional neural network;augmentation;computer-aided system (CAD)},
  doi={10.1109/ICCSCE52189.2021.9530911},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11293256,
  author={Buccellato, Federico and Natale, Davide and De Sio, Corrado and Azimi, Sarah},
  booktitle={2025 IEEE International Smart Cities Conference (ISC2)}, 
  title={Bridging Communication Gaps: A Low-Cost, Real-Time Sign Language Recognition Platform}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The communication gap between deaf and hearing individuals remains a persistent challenge, limiting participation in daily life and access to essential services. The difficulty of learning sign language and the lack of dedicated tools for translating between signed and spoken languages create barriers to full inclusion in social, educational, and healthcare settings. This paper presents a low-cost, real-time mobile application to facilitate smooth, natural bidirectional communication between spoken and signed language during video calls. The platform incorporates two dedicated translation pipelines: one that converts user gestures captured by the smartphone camera into synthesized speech, and another that transforms spoken input into animated sign language. The mobile application is powered by a backend system built on Node.js and Mediasoup for media management, with Python microservices responsible for running the translation models. Experimental results confirm that the proposed solution achieves real-time responsiveness and translation accuracy, offering a practical and scalable tool to support inclusive communication between deaf and hearing individuals.},
  keywords={Sign language;Translation;Smart cities;Pipelines;Microservice architectures;Auditory system;Transforms;Real-time systems;Mobile applications;Videos;Artificial Intelligence;Real-Time Communication;Sign Language Translation;Smart Cities},
  doi={10.1109/ISC266238.2025.11293256},
  ISSN={2687-8860},
  month={Oct},}@ARTICLE{10017272,
  author={Massey, Roslyn S. and Prakash, Ravi},
  journal={IEEE Journal on Flexible Electronics}, 
  title={System-on-Board Integrated Flexible OEGFET Aptasensor for Multianalyte Testing in Saliva}, 
  year={2023},
  volume={2},
  number={2},
  pages={71-76},
  abstract={The need for oral health monitoring point-of-care (PoC) systems is ever growing. We have recently reported a novel, aptamer-based flexible biosensor for detection of a high impact hormone—cortisol—in saliva samples using organic electrolyte-gated FET (OEGFET) technology. In this work, we are reporting a system-on-board (SoB) level integration of an improved flexible OEGFET aptasensor, which was previously reliant on a bench-top measurement setup. The reported flexible OEGFET aptasensor has integrated soft microfluidics and a low-power (< 300 mW) customized printed circuit board. The interfacing of flexible aptasensor to the circuit board was achieved using a low-temperature extrusion printing technique. The system was assessed using spiked saliva supernatants, which established comparable detection threshold for the miniaturized, board-based configuration. In this expanded article, we furthermore demonstrate improvements to device structure and the integration process, which improves the signal-to-noise resolution. By implementing 3-D printing technology, the interconnects between the flexible sensor and conventional printed circuit board (PCB) are more durable and possess better conductivity. The optimized transistor pattern allows for multiple analytes to be tested concurrently. A side-by-side analysis of a device that is specific to cortisol biomolecules and a nonspecific device shows that the SoB is capable of distinguishing between binding and nonbinding device behavior. The portable oral biosensor has the potential to be transformed into a multianalyte sensing platform and is therefore a promising prototype for future clinical validation.},
  keywords={Biosensors;Microchannels;Logic gates;Electrolytes;Testing;Biomarkers;Substrates;Flexible electrolyte-gated FET (EGFET) biosensor;point-of-care (PoC) device;saliva testing;system-on-board (SoB) integration},
  doi={10.1109/JFLEX.2023.3237182},
  ISSN={2768-167X},
  month={March},}
