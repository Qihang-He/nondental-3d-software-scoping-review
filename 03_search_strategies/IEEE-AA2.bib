  journal={IEEE Transactions on Image Processing}, 
  title={PWD-3DNet: A Deep Learning-Based Fully-Automated Segmentation of Multiple Structures on Temporal Bone CT Scans}, 
  year={2021},
  volume={30},
  number={},
  pages={739-753},
  abstract={The temporal bone is a part of the lateral skull surface that contains organs responsible for hearing and balance. Mastering surgery of the temporal bone is challenging because of this complex and microscopic three-dimensional anatomy. Segmentation of intra-temporal anatomy based on computed tomography (CT) images is necessary for applications such as surgical training and rehearsal, amongst others. However, temporal bone segmentation is challenging due to the similar intensities and complicated anatomical relationships among critical structures, undetectable small structures on standard clinical CT, and the amount of time required for manual segmentation. This paper describes a single multi-class deep learning-based pipeline as the first fully automated algorithm for segmenting multiple temporal bone structures from CT volumes, including the sigmoid sinus, facial nerve, inner ear, malleus, incus, stapes, internal carotid artery and internal auditory canal. The proposed fully convolutional network, PWD-3DNet, is a patch-wise densely connected (PWD) three-dimensional (3D) network. The accuracy and speed of the proposed algorithm was shown to surpass current manual and semi-automated segmentation techniques. The experimental results yielded significantly high Dice similarity scores and low Hausdorff distances for all temporal bone structures with an average of 86% and 0.755 millimeter (mm), respectively. We illustrated that overlapping in the inference sub-volumes improves the segmentation performance. Moreover, we proposed augmentation layers by using samples with various transformations and image artefacts to increase the robustness of PWD-3DNet against image acquisition protocols, such as smoothing caused by soft tissue scanner settings and larger voxel sizes used for radiation reduction. The proposed algorithm was tested on low-resolution CTs acquired by another center with different scanner parameters than the ones used to create the algorithm and shows potential for application beyond the particular training data used in the study.},
  keywords={Image segmentation;Bones;Computed tomography;Shape;Biomedical imaging;Training;Three-dimensional displays;Temporal bone CT;fully-automated segmentation;multi-structure;patch-wise;balanced-weighting;PWD-3DNet},
  doi={10.1109/TIP.2020.3038363},
  ISSN={1941-0042},
  month={},}@INPROCEEDINGS{10774894,
  author={Rathi, Snehal and Puranik, Atharva and Pratham, Shaantanu and Kulkarni, Vibhav and Chincholkar, Harshvardhan},
  booktitle={2024 8th International Conference on Computing, Communication, Control and Automation (ICCUBEA)}, 
  title={Comparative Analysis of CNN Architectures for Enhancing Oral Cancer Detection Using Advanced Image Processing Techniques}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={To effectively diagnose oral cancer, sophisticated technologies like deep learning must be investigated. This is still a significant difficulty in medical diagnostics. To assess Convolutional Neural Network (CNN) architectures' efficacy in oral cancer detection, we compare and contrast them in this research. Specifically, we compare the performance of VGG19, ResNet50, ResNet101, and a standard CNN model using a dataset of Oral Cancer (Lips and Tongue) images (OCI). We use sophisticated image processing methods including data augmentation, contrast improvement, and noise reduction to improve the quality of the supplied data. We use accuracy, precision rate, recall rate, and F1-score as our assessment measures. Our findings show that the suggested CNN design outperforms VGG19 (72.97%), ResNet50 (79.73%), and ResNet101 (71.62%) in terms of accuracy, with a maximum of 87.10%. Moreover, our approach shows excellent recall, F1score, and accuracy, highlighting its efficacy in correctly detecting malignant areas in oral pictures. Through this comparative analysis, we provide valuable insights into the suitability of different CNN architectures for oral cancer detection, without the integration of specific optimization algorithms. Our findings highlight the potential of deep learning techniques to improve treatment outcomes and early diagnosis for patients with oral cancer, ultimately leading to the advancement of computer-aided cancer detection (CAD) systems.},
  keywords={Deep learning;Solid modeling;Accuracy;Computational modeling;Cancer detection;Data models;Convolutional neural networks;Cancer;Residual neural networks;Testing;Oral Cancer;Deep Learning;Convolutional Neural Networks;CNN Architectures;VGG19;ResNet50;ResNet101;Computer-Aided Cancer Detection;CAD Systems;Medical Diagnostics;Image Processing;Data Augmentation;Accuracy;Precision;Recall;F1-score},
