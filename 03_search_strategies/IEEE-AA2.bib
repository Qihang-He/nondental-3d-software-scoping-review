  doi={10.1109/EMBC44109.2020.9175364},
  ISSN={2694-0604},
  month={July},}@INPROCEEDINGS{10987535,
  author={Zhang, Dan},
  booktitle={2025 IEEE International Conference on Electronics, Energy Systems and Power Engineering (EESPE)}, 
  title={Construction of Immersive English Listening and Speaking Training Platform in Virtual Reality Environment and Its Effect Evaluation System}, 
  year={2025},
  volume={},
  number={},
  pages={1162-1166},
  abstract={This paper aims to explore the application of virtual reality (VR) technology in building an immersive English listening and speaking training platform. An English listening and speaking training system combining virtual reality technology and maximum information coefficient (MAF) algorithm is proposed to improve learners' language communication ability by simulating real scenes. This paper first introduces the design concept and technical framework of immersive English listening and speaking training platform, including 3D modeling and interaction design in virtual reality environment. Then, this paper elaborates on how to use the maximum information coefficient algorithm to analyze learners' speech input to quantify learners' pronunciation accuracy and fluency. Through this method, the system can identify the subtle differences in pronunciation and intonation of learners, thereby helping them improve and optimize their oral expression. The experimental results show that compared with traditional English listening and speaking training methods, immersive training platform based on virtual reality can significantly improve learners' learning motivation and effect.},
  keywords={Training;Microwave integrated circuits;Power engineering;Electric potential;Three-dimensional displays;Accuracy;Buildings;Virtual reality;Aerospace electronics;Virtual reality;English training;maximum information coefficient algorithm;evaluation system},
