  number={3},
  pages={2312-2328},
  abstract={4D head capture aims to generate dynamic facial meshes in the same topology with corresponding UV maps, which requires temporal correspondence between 3D head models. Existing pipelines either involve manual processing of artists or employ constraints such as landmark tracking and optical flow, failing to achieve a trade-off between accuracy and efficiency. To enhance this process, we propose Topo4D++, a novel framework for automatic geometry and texture reconstruction that optimizes densely aligned 4D heads and 8 K BRDF maps directly from calibrated multi-view videos. Our key insight is to represent facial models as a set of dynamic 3D Gaussians with fixed topology, where the Gaussian centers are bound to the mesh vertices. This enables tracking all vertices rather than sparse vertices on the face accurately by leveraging the inverse rendering capabilities of 3D Gaussian Splatting (3DGS), while also enabling ultra-high-resolution texture generation. To maintain face structure during dynamic 3DGS optimization, we propose to optimize geometry and texture alternatively under physical and topological constraints frame-by-frame and employ blendshape-based expression priors to address extreme expressions. Then, we propose to extract dynamic facial meshes in a regular wiring arrangement and high-fidelity textures with pore-level details from the learned Gaussians. Finally, we train a diffusion-based model to generate BRDF texture maps to achieve physically based rendering. Given the absence of a universal benchmark, we construct JHead, a novel benchmark for the comprehensive evaluation of 4D head capture methods. Extensive experiments on different datasets demonstrate that our method is generalized to different capture systems, identities, and expressions, outperforming current state-of-the-art head reconstruction methods in both mesh and texture qualitatively and quantitatively.},
  keywords={Image reconstruction;Rendering (computer graphics);Three-dimensional displays;Faces;Topology;Magnetic heads;Benchmark testing;Solid modeling;Pipelines;Optimization;4D head reconstruction;high-resolution BRDF texture generation;3D Gaussian splatting},
  doi={10.1109/TPAMI.2025.3627431},
  ISSN={1939-3539},
  month={March},}@INPROCEEDINGS{10981089,
  author={Sameh, Youssef and Bekhit, Adham and Salama, Mohamed and Hany, Ahmed and Elbattawy, Mohamed and Kotp, Yousef and Torki, Marwan},
  booktitle={2025 IEEE 22nd International Symposium on Biomedical Imaging (ISBI)}, 
  title={Generative Chained Label Propagation: A Semi-Supervised Approach for Enhanced 3D Segmentation of the Inferior Alveolar Nerve}, 
  year={2025},
  volume={},
  number={},
  pages={01-05},
  abstract={Manual voxel-level annotation of 3D medical images in dental radiology is a time-consuming process, particularly for intricate structures like the inferior alveolar nerve (IAN). As a result, many institutions rely on sparse annotations, sacrificing accuracy for efficiency, which limits the performance of deep learning models for dense segmentation. In this work, we address the problem of dense label scarcity as well as dense segmentation. We introduce Generative Chained Label Propagation (GCLP), a novel semi-supervised algorithm that generates and iteratively refines high-quality dense labels from sparse annotations utilizing PosPadUNet and our new architecture, ARP-UNet, both using a new training regime we propose. By training the dense segmentation model on a hybrid set comprising ground truth labels and the highest-quality dense labels generated by GCLP, our method achieves an IoU score of 0.715, surpassing the previous state-of-the-art of 0.642. Code and checkpoints are available on Github.},
  keywords={Training;Image segmentation;Three-dimensional displays;Annotations;Manuals;Semisupervised learning;Radiology;Hybrid power systems;Biomedical imaging;Software development management;3D Segmentation;Semi-Supervised Learning;Label Propagation;Inferior Alveolar Nerve},
  doi={10.1109/ISBI60581.2025.10981089},
  ISSN={1945-8452},
  month={April},}@INPROCEEDINGS{11445527,
  author={Lei, Changsong and Liang, Yaqian and Wang, Shaofeng and Dai, Jiajia and Liu, Yong-Jin},
  booktitle={2025 IEEE/CVF International Conference on Computer Vision (ICCV)}, 
  title={TeethGenerator: A Two-Stage Framework for Paired Pre- and Post-Orthodontic 3D Dental Data Generation}, 
  year={2025},
  volume={},
  number={},
  pages={25872-25881},
  abstract={Digital orthodontics represents a prominent and critical application of computer vision technology in the medical field. So far, the labor-intensive process of collecting clinical data, particularly in acquiring paired 3D orthodontic teeth models, constitutes a crucial bottleneck for developing tooth arrangement neural networks. Although numerous general 3D shape generation methods have been proposed, most of them focus on single-object generation and are insufficient for generating anatomically structured teeth models, each comprising $24-32$ segmented teeth. In this paper, we propose TeethGenerator, a novel two-stage framework designed to synthesize paired 3D teeth models pre- and post-orthodontic, aiming to facilitate the training of downstream tooth arrangement networks. Specifically, our approach consists of two key modules: (1) a teeth shape generation module that leverages a diffusion model to learn the distribution of morphological characteristics of teeth, enabling the generation of diverse post-orthodontic teeth models; and (2) a teeth style generation module that synthesizes corresponding pre-orthodontic teeth models by incorporating desired styles as conditional inputs. Extensive qualitative and quantitative experiments demonstrate that our synthetic dataset aligns closely with the distribution of real orthodontic data, and promotes tooth alignment performance significantly when combined with real data for training. The code and dataset are available at https://github.com/lcshhh/teeth_generator.},
  keywords={Feeds;Antennas;Filtering;Filters;Videos;Protocols;Electronic mail;Video equipment;HTTP;Communication networks},
  doi={10.1109/ICCV51701.2025.02400},
  ISSN={2380-7504},
  month={Oct},}@INPROCEEDINGS{11453128,
  author={Shyni, I Domilin and Herobin Rani C, Sheeja and D R, Sheena Daphne and M, Swetha},
  booktitle={2025 1st International Conference on Advancement in Futuristic Technologies (ICAFT)}, 
  title={Explainable Deep Learning for Age Estimation in Forensic Disaster Victim Identification}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Accurate estimation of age from dental radiographs plays a vital role in forensic identification, medical diagnostics, and legal proceedings, particularly when conventional approaches are not feasible due to incompleteness of data or post-mortem scenarios. This paper describes a deep learning framework for automatically estimating age from images of orthopantomogram (OPG). We collected more than 2,000 clinical OPG images covering a large range of ages for training and testing the model. We employed two up-to-date architectures: ResNet-50 and Vision Transformer (ViT). These architectures output chronological age as a regression task and discriminatively classify people into specific age bands for both regression and classification analyses. The architectures incorporate attention modules for emphasizing regions of teeth that are highly correlated with age, for instance, third molars, root appearance, and mandibular cortical thickness. For transparency and validation purposes during forensic analysis, we employed gradient-weighted class activation mapping (Grad-CAM) for visualizing the regions contributing to predictions. The results of experiments demonstrate high capabilities, obtaining a mean absolute error (MAE) of 2.8 years for predictions of ages and 84.5 percent accuracy for classification of ages into bands. This proves that there is a reliable estimation of ages from dental radiograph images using the proposed model. The presented framework contributes towards transparent automatic estimation of ages. It provides meaningful information for forensic analysis, medical diagnostics, and opens up future trends for dental image explainability analysis.},
  keywords={Deep learning;Training;Accuracy;Forensics;Disasters;Estimation;Transformers;Dentistry;Reliability;Medical diagnosis;Explainable AI;forensic science;deep learning;age estimation;dental radiography;and disaster victim identification},
  doi={10.1109/ICAFT66710.2025.11453128},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10169273,
  author={Ajay, S and Sabarinathan, K S and Santhosh Sudhaan, N G and Uma Maheswari, P and Mohamed Mansoor Roomi, S and Sithi Shameem Fathima, S.M.H},
  booktitle={2023 International Conference on Artificial Intelligence and Applications (ICAIA) Alliance Technology Conference (ATCON-1)}, 
  title={Automatic Segmentation of Mandibular Condylar in Dental OPG Images Using Modified Mask RCNN}, 
  year={2023},
  volume={},
  number={},
  pages={1-5},
  abstract={Proper segmentation of the maxillofacial bones in OPG (OrthoPantomoGram) is vital for identification and prediagnosis planning for maxillofacial surgery. Traditional segmentation is time - consuming and demanding due to inherent properties of bones in the maxillofacial regions. Nevertheless, due to the large consistent dataset requirements of data driven segmentation techniques, such as deep learning, there is an impediment in their clinical applications. In this study, we proposed a modified Mask RCNN based Framework for the automatic and accurate segmentation of the condylar regions in Dental (OPG) images with limited datasets. This proposed technique comprises of three stages namely pre-processing, mask creations and segmentation. Initially the edges of the condylar region in dental (OPG) images are enhance using pre-processing filter subsequently the mask regions of the condylar has been created using polynomial approach then the mask images along with the original images are trained by the proposed deep network architecture finally the segmented condylar region is compared with the ground tooth images created by dental experts and achieves an accuracy of 87.24%. The results suggested that Modified Mask RCNN has segmentation performance that is comparable to other models and has better data compatibility.},
  keywords={Image segmentation;Image edge detection;Surgery;Teeth;Learning (artificial intelligence);Network architecture;Bones;Segmentation;Mandible;Craniomaxillofacial bone;Deep learning},
  doi={10.1109/ICAIA57370.2023.10169273},
  ISSN={},
  month={April},}@ARTICLE{10048497,
  author={Zhao, Shuwen and Wang, Xinming and Zhang, Dinghuang and Zhang, Gongyue and Wang, Zhiyong and Liu, Honghai},
  journal={IEEE Transactions on Cybernetics}, 
  title={FM-3DFR: Facial Manipulation-Based 3-D Face Reconstruction}, 
  year={2024},
  volume={54},
  number={1},
  pages={209-218},
  abstract={3-D Morphable model (3DMM) has widely benefited 3-D face-involved challenges given its parametric facial geometry and appearance representation. However, previous 3-D face reconstruction methods suffer from limited power in facial expression representation due to the unbalanced training data distribution and insufficient ground-truth 3-D shapes. In this article, we propose a novel framework to learn personalized shapes so that the reconstructed model well fits the corresponding face images. Specifically, we augment the dataset following several principles to balance the facial shape and expression distribution. A mesh editing method is presented as the expression synthesizer to generate more face images with various expressions. Besides, we improve the pose estimation accuracy by transferring the projection parameter into the Euler angles. Finally, a weighted sampling method is proposed to improve the robustness of the training process, where we define the offset between the base face model and the ground-truth face model as the sampling probability of each vertex. The experiments on several challenging benchmarks have demonstrated that our method achieves state-of-the-art performance.},
  keywords={Solid modeling;Image reconstruction;Face recognition;Data models;Computational modeling;Three-dimensional displays;Facial animation;3-D dense face alignment;3-D face reconstruction;expression synthesis;facial manipulation},
  doi={10.1109/TCYB.2023.3242368},
  ISSN={2168-2275},
  month={Jan},}@INPROCEEDINGS{11037898,
  author={Mukai, Nobuhiko and Mori, Kimie and Takei, Yoshiko},
  booktitle={2024 7th Asia Conference on Cognitive Engineering and Intelligent lnteraction (CEII)}, 
  title={Investigation on Learning Accuracy for Tongue Surface Extraction from Ultrasound Image}, 
  year={2024},
  volume={},
  number={},
  pages={41-45},
  abstract={Lateral misarticulation (LM) is a speech sound disorder in which air flows laterally out of the mouth, resulting in distorted speech sounds. The primary cause is incorrect tongue movement, necessitating clinical treatment by speech-language-hearing therapists for correction. Since tongue movement during speech is invisible, three-dimensional (3D) tongue models have been generated using medical imaging data, such as magnetic resonance imaging (MRI), computed tomography (CT), or ultrasound (US), to track and analyze tongue movement. US is relatively easier to use than MRI since the device is compact although the images are a little bit blurred in comparison with those filmed by MRI. Then, we developed a tool for 3D tongue models based on US images; and confirmed that the tool is very useful for clinical treatment of LM patients. However, tongue surface extraction from US images requires much effort since surface feature points should be manually selected. We are now investigating how to extract the feature points by using deep-learning-based methods. In this paper, the relationship between the teacher images for learning and the accuracy of the results is described based on the evaluation criterion from the subjective and objective viewpoints.},
  keywords={Solid modeling;Tongue;Accuracy;Ultrasonic imaging;Three-dimensional displays;Magnetic resonance imaging;Computed tomography;Feature extraction;Data models;Splines (mathematics);tongue model;speech sound disorder;ultrasound image;deep learning},
  doi={10.1109/CEII65291.2024.00017},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10895799,
  author={Nandeesh, M and Naveen, B and Srividya, C N},
  booktitle={2024 International Conference on Recent Advances in Science and Engineering Technology (ICRASET)}, 
  title={Tooth Enamel segmentation from dental x-ray using MASK R-CNN Algorithm}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={In order to detect cavities on teeth, dentists analyse dental x-rays. Initially, dental cavities develop on the delicate surface of the teeth, known as enamel, and subsequently progress to the pulp and the root of the teeth. The reconstruction of three-dimensional dentition models for use in a variety of clinical applications is contingent upon the precise segmentation of teeth. Nevertheless, performing manual segmentation is time-consuming and susceptible to intra- and inter-observer variability. Convolutional neural network (CNN) algorithms can automatically segment teeth; however, the majority of CNN algorithms necessitate manual marking on a vast training database and extreme computational capacity. Theoretical Orientation and Methodology: This investigation assesses the feasibility of employing a transfer-learning algorithm, “Mask R-CNN,” which necessitates a modest training database and minimal computational resources. This work is designed to accomplish our objective of segmenting the enamel region of the teeth from dental x -rays using an algorithm such as Mask renn. The extraction of the enamel region is essential in the process of cavity detection using deep learning, as the cavity initially develops on the enamel region. The “Mask R-CNN” method is implemented with a standard computational capacity and a minimal training database to accomplish high-quality dental recognition within a reasonable train duration. This has the potential to promote more precise treatment planning and diagnosis by eliminating subjective errors.},
  keywords={Training;Deep learning;Databases;Transfer learning;Teeth;X-rays;Manuals;Dentistry;Partitioning algorithms;Convolutional neural networks;Teeth Caries;Image Separation;Teeth X-Ray;RCNN Mask},
  doi={10.1109/ICRASET63057.2024.10895799},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9879780,
  author={Luo, Jiahao and Khan, Fahim Hasan and Mori, Issei and de Silva, Akila and Ruezga, Eric Sandoval and Liu, Minghao and Pang, Alex and Davis, James},
  booktitle={2022 IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)}, 
  title={How much does input data type impact final face model accuracy?}, 
  year={2022},
  volume={},
  number={},
  pages={18963-18972},
  abstract={Face models are widely used in image processing and other domains. The input data to create a 3D face model ranges from accurate laser scans to simple 2D RGB photographs. These input data types are typically deficient either due to missing regions, or because they are underconstrained. As a result, reconstruction methods include embedded priors encoding the valid domain of faces. System designers must choose a source of input data and then choose a reconstruction method to obtain a usable 3D face. If a particular application domain requires accuracy X, which kinds of input data are suitable? Does the input data need to be 3D, or will 2D data suffice? This paper takes a step toward answering these questions using synthetic data. A ground truth dataset is used to analyze accuracy obtainable from 2D landmarks, 3D landmarks, low quality 3D, high quality 3D, texture color, normals, dense 2D image data, and when regions of the face are missing. Since the data is synthetic it can be analyzed both with and without measurement error. This idealized synthetic analysis is then compared to real results from several methods for constructing 3D faces from 2D photographs. The experimental results suggest that accuracy is severely limited when only 2D raw input data exists.},
  keywords={Solid modeling;Measurement errors;Three-dimensional displays;Image coding;Image analysis;Image color analysis;Face recognition;Face and gestures; Scene analysis and understanding},
  doi={10.1109/CVPR52688.2022.01841},
  ISSN={2575-7075},
  month={June},}@INPROCEEDINGS{9995187,
  author={Anantharaman, Rajaram and Bhandary, Anwika and Nandakumar, Raveesh and Rajesh Kumar, R and Vajapeyam, Pranav},
  booktitle={2022 IEEE International Conference on Bioinformatics and Biomedicine (BIBM)}, 
  title={Utilizing Deep Learning to Opportunistically Screen for Osteoporosis from Dental Panoramic Radiographs}, 
  year={2022},
  volume={},
  number={},
  pages={2969-2976},
  abstract={Osteoporosis, a chronic disease, can be managed through medication and lifestyle changes if detected early. Therefore, there is need for a cost effective method of screening for osteoporosis. In this paper, we propose a deep learning based implementation for developing an automated computer aided diagnostic (CAD) system that harnesses additional information contained in dental panoramic radiographs to detect a person’s risk for developing osteoporosis. Our proposed method follows a two-step approach. First, we apply deep convolutional neural networks (CNNs) to segment key areas of a panoramic radiograph including the mandible, mental foramen, and the mandibular cortical bone. Second, we follow it up with image processing techniques using OpenCV to calculate the ratio of pixels to help arrive at a key ratio called the Panoramic Mandibular Index (PMI). This ratio is instrumental in determining the risk of bone loss in individuals. When compared to the dental clinicians, our model achieved an F1 score of 0.943 on the test set, whereas the performance of dental clinicians was regarded as the standard with a perfect score. Our paper focuses on automating the measurement of PMI to create a CAD system suitable for routine screening of osteoporosis.},
  keywords={Deep learning;Osteoporosis;Solid modeling;Image segmentation;Design automation;Biological system modeling;Dentistry;Deep Learning;Dental Panoramic Images;Osteoporosis;U-Net},
  doi={10.1109/BIBM55620.2022.9995187},
  ISSN={},
  month={Dec},}@ARTICLE{11202909,
  author={Jang, Seoyeon and Choi, Seungpil and Jeon, Byunghwan},
  journal={IEEE Access}, 
  title={Reinforcement Learning-Based Centerline Tracking With Cross-Sectional Similarity for Enhancing Mandibular Canal Segmentation}, 
  year={2025},
  volume={13},
  number={},
  pages={175468-175478},
  abstract={The mandibular canal (MC) is an anatomical structure surrounding inferior alveolar nerves (IAN) that deliver sensory information to the teeth, gums, and lips. The position of the MC is a critical factor for planning dental procedures and orthodontic surgery. Tracking the centerline of the MC can assist not only in surgical planning but also enhance segmentation performance. This study aims to accurately track the centerline of the MC from the mental foramen to the end of the MC in three-dimensional computed tomography images. To this end, we propose a deep reinforcement learning (DRL) framework utilizing cross-sections generated along the progression direction of the DRL agent. In our approach, we design a novel reward function with penalty factors for guiding the agent to smoothly track the curvature and centerline of the MC, which helps ensure both accuracy and robustness against the local minima. The proposed method is compared with other existing approaches for centerline extraction, using both tracking and segmentation metrics. Experimental results based on 480 public cone-beam computed tomography (CBCT) scans demonstrate that our method is highly robust and accurate relative to existing approaches across all evaluated metrics.},
  keywords={Image segmentation;Irrigation;Three-dimensional displays;Accuracy;Teeth;Surgery;Arteries;Trajectory;Shape;Planning;Mandibular canal;reinforcement learning;centerline tracking;cross-sectional similarity;segmentation},
  doi={10.1109/ACCESS.2025.3621529},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{9433999,
  author={Hatvaniy, J. and Michetti, J. and Basarab, A. and Gyöngy, M. and Kouamé, D.},
  booktitle={2021 IEEE 18th International Symposium on Biomedical Imaging (ISBI)}, 
  title={Single Image Super-Resolution Of Noisy 3d Dental Ct Images Using Tucker Decomposition}, 
  year={2021},
  volume={},
  number={},
  pages={1673-1676},
  abstract={Tensor decomposition has proven to be a strong tool in various 3D image processing tasks such as denoising and superresolution. In this context, we recently proposed a computationally effective, canonical polyadic decomposition (CPD) based algorithm for single image super-resolution. In this work, we investigated the added value brought by Tucker decomposition. While CPD allows a joint implementation of the denoising and deconvolution steps, with Tucker decomposition the denoising is followed by the deconvolution. This way the ill-posedness of the deconvolution caused by noise is partially mitigated. The results achieved using the two different tensor decomposition techniques were compared, and the robustness against noise was investigated. For validation, dental images were used. The superiority of the proposed method is shown in terms of peak signal-to-ratio, structural similarity index, the root canal segmentation accuracy, and runtime.},
  keywords={Three-dimensional displays;Deconvolution;Tensors;Runtime;Noise reduction;Superresolution;Tools;3D single image super-resolution;tensor factorization;Tucker decomposition;dental CT},
  doi={10.1109/ISBI48211.2021.9433999},
  ISSN={1945-8452},
  month={April},}@INPROCEEDINGS{11291817,
  author={Jawad, Mahmoud Mussleh and Nassrullah, Hassan Ali Abood and Hussain, Hussain Ali and Kazem Abd, Mohammad and Asaad Asaad, Ameer Yalmaz and Mohammed, Zainab I. and Hussein, Rawezh Mohammed and Miah, Abu Saleh Musa},
  booktitle={2025 3rd International Conference on Cyber Resilience (ICCR)}, 
  title={Semantic Segmentation of Fetal Thoracic and Abdominal Organs in Prenatal Ultrasound Volumes Using Swin Transformer Networks}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={This research proposes a high-accuracy Transformer-based segmentation framework for fetal thoracic and abdominal organ delineation in prenatal ultrasound volumes, utilizing Swin Transformer architecture, multi-scale hierarchical attention, and deep supervision techniques. The model ingests volumetric ultrasound data encoded as 3D spatial patches and processes them through shifted window attention layers to capture both local texture and global anatomical context. Benchmarked across clinically annotated datasets, the framework achieved average Dice scores exceeding 89.2% and IoU scores above 85.6% across key fetal organs including the lungs, liver, stomach, and heart. Compared to traditional CNN-based models such as U-Net and V-Net, the proposed method improved segmentation precision by 4.5–5.2%, particularly in challenging regions with occlusions, shadow artifacts, or low contrast. Integration of boundary-aware loss functions and positional attention embedding’s enhanced boundary adherence and organ separability. With inference times under 500ms per 3D volume and generalization maintained across gestational weeks 20-36, the model supports real-time clinical deployment. Its scalable architecture and robust anatomical encoding present a strong foundation for advanced prenatal diagnostics and organ-specific fetal biometrics.},
  keywords={Solid modeling;Stomach;Ultrasonic imaging;Three-dimensional displays;Accuracy;Semantic segmentation;Lungs;Biological systems;Transformers;Encoding;Fetal Ultrasound;Semantic Segmentation;Swin Transformer;Hierarchical Attention;Prenatal Imaging;3D Volumes;Deep Supervision;Medical Image Analysis},
  doi={10.1109/ICCR67387.2025.11291817},
  ISSN={},
  month={July},}@ARTICLE{11556109,
  author={Shim, Jiyong and Yang, Hyesun and Park, Chulkyu and Kim, Yousuk and Cho, Hyosung},
  journal={IEEE Access}, 
  title={Patient-Specific Panoramic Reconstruction From Spiral MDCT Data via Projection-Domain CT-Style Backprojection}, 
  year={2026},
  volume={14},
  number={},
  pages={90708-90725},
  abstract={Dental panoramic radiography is widely used in oral and maxillofacial imaging; however, conventional panoramic reconstruction relies on manufacturer-defined focal trajectories and shift-and-add (SAA) compositing, which limits patient-specific adaptability and geometric consistency. This study presents a patient-specific panoramic reconstruction framework in which a curved panoramic manifold is initialized from an FBP-reconstructed CT volume, and the final panoramic image is subsequently generated from spiral multidetector computed tomography (MDCT) projection data using a projection-domain curved-manifold backprojection approach guided by spiral CT geometry. By explicitly modeling individual dental-arch geometry, the proposed method reconstructs panoramic images through geometry-guided projection-domain mapping of selected spiral MDCT data onto the curved panoramic manifold. This formulation provides consistent geometric mapping along the dental arch and exploits the redundancy in the projection domain inherent to spiral CT acquisition, enabling improved structural consistency and reduced geometric distortion, particularly under sampling insufficiency and metal-induced artifact conditions. Simulation studies and phantom experiments demonstrate improved structural consistency and reduced geometric distortion compared with conventional panoramic reconstruction. Furthermore, the framework supports flexible view selection, enabling projection-usage-efficient reconstruction while maintaining image continuity across varying spiral pitch conditions. The proposed framework is intended as a supplementary post-processing approach for cases in which spiral MDCT data are already available, providing a patient-adaptive and geometrically consistent panoramic overview without requiring an additional panoramic scan.},
  keywords={Dentistry;Spirals;Geometry;Phantoms;Beams;Reconstruction algorithms;Detectors;Educational institutions;Simulation;Imaging;Projection-domain reconstruction;curved-manifold reconstruction;panoramic imaging;patient-specific reconstruction;spiral MDCT;geometry-guided reconstruction},
  doi={10.1109/ACCESS.2026.3701760},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11292228,
  author={Abdelabbas, Alaa Muhammad and Nassrullah, Aymen Hasan Ali and Ismael, Thulfiqar Zuhair and Ibrahim, Ibrahim Khalil and Hussein, Ahmed Ali and Abdulwahab, Emad N and Mohammed, Zainab I. and Hashim, Wasan Adnan and Shin, Jungpil},
  booktitle={2025 3rd International Conference on Cyber Resilience (ICCR)}, 
  title={Robust Brain Tumor Segmentation in Multi-Sequence MRI Using Multi-Scale Attention U-Net Architectures}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={This research proposes a high-precision, multiscale attention-guided U-Net architecture for robust brain tumor segmentation in multi-sequence MRI, leveraging adaptive modality fusion, spatial-channel attention, and hierarchical feature extraction. Utilizing a dual-encoder framework with modality-specific branches and attention gates, the system was evaluated on standardized datasets including BraTS 2020–2024 under varying modality combinations (T1, T1c, T2, FLAIR). The model consistently achieved Dice scores up to 97.3%, with Hausdorff95 distances remaining below 5.2 mm and sub-region sensitivity notably improved for core and enhancing tumors. Compared to conventional U-Net and CNN-based models, the proposed architecture yielded a 4.8–5.2% performance gain in boundary accuracy and demonstrated enhanced resilience to modality dropout and inter-site variability. The inclusion of dual attention blocks and deep supervision enabled robust voxel-level discrimination even in low-contrast regions and heterogeneous tumor morphologies. With inference times below 1.5 seconds per 3D volume and compatibility with real-time PACS workflows, the model is deployable in clinical settings with minimal tuning. Its modular design ensures adaptability to new imaging protocols, making it suitable for large-scale neuro-oncological diagnostics, radiotherapy planning, and surgical navigation.},
  keywords={Image segmentation;Adaptation models;Accuracy;Three-dimensional displays;Magnetic resonance imaging;Brain tumors;Surgery;Brain modeling;Tuning;Resilience;Brain Tumor Segmentation;Multi-Sequence MRI;Attention U-Net;Dice Coefficient;Modality Fusion;Spatial-Channel Attention;Deep Learning;Medical Image Analysis},
  doi={10.1109/ICCR67387.2025.11292228},
  ISSN={},
  month={July},}@INPROCEEDINGS{11092382,
  author={Lin, Jing and Feng, Yao and Liu, Weiyang and Black, Michael J.},
  booktitle={2025 IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR)}, 
  title={ChatHuman: Chatting about 3D Humans with Tools}, 
  year={2025},
  volume={},
  number={},
  pages={8150-8161},
  abstract={Numerous methods have been proposed to detect, estimate, and analyze properties of people in images, including 3D pose, shape, contact, human-object interaction, and emotion. While widely applicable in vision and other areas, such methods require expert knowledge to select, use, and interpret the results. To address this, we introduce ChatHuman, a language-driven system that integrates the capabilities of specialized methods into a unified framework. ChatHuman functions as an assistant proficient in utilizing, analyzing, and interacting with tools specific to 3D human tasks, adeptly discussing and resolving related challenges. Built on a Large Language Model (LLM) framework, ChatHuman is trained to autonomously select, apply, and interpret a diverse set of tools in response to user inputs. Our approach overcomes significant hurdles in adapting LLMs to 3D human tasks, including the need for domain-specific knowledge and the ability to interpret complex 3D outputs. The innovations of ChatHuman include leveraging academic publications to instruct the LLM on tool usage, employing a retrieval-augmented generation model to create in-context learning examples for managing new tools, and effectively discriminating between and integrating tool results by transforming specialized 3D outputs into comprehensible formats. Experiments demonstrate that ChatHuman surpasses existing models in both tool selection accuracy and overall performance across various 3D human tasks, and it supports interactive chatting with users. ChatHuman represents a significant step toward consolidating diverse analytical methods into a unified, robust system for 3D human tasks. Code and data are available at chathuman.github.io.},
  keywords={Solid modeling;Technological innovation;Computer vision;Adaptation models;Three-dimensional displays;Codes;Shape;Large language models;Retrieval augmented generation;Pattern recognition;llm; 3d humans; agents},
  doi={10.1109/CVPR52734.2025.00763},
  ISSN={2575-7075},
  month={June},}@INPROCEEDINGS{11471358,
  author={Elbadry, Elbadry and Gamal, Mahmoud and Baraka, Marwa and Torki, Marwan},
  booktitle={2025 International Conference on Machine Learning and Applications (ICMLA)}, 
  title={Enhancing 3D Semi-Supervised Teeth Segmentation with Voxel Entropy-Guided Self-Learning}, 
  year={2025},
  volume={},
  number={},
  pages={269-274},
  abstract={Teeth segmentation is crucial for the analysis of maxillofacial diseases, with Cone Beam Computed Tomography (CBCT) scans offering superior 3D imaging compared to conventional Computed Tomography (CT). We propose a semi-supervised framework based on a multi-iterative self-learning approach, introducing a novel ranking technique for pseudo-label selection and a post-processing algorithm to eliminate false positives and ensure mask consistency. Pseudo-label ranking is guided by average voxel-level entropy, which quantifies uncertainty between foreground and background classes. High-confidence labels are then selected to refine training in subsequent iterations. Our post-processing algorithm enhances segmentation fidelity by identifying connected components, retaining the largest within a defined radius, and filtering out extraneous voxels. Additionally, expert-refined pseudo-labels are incorporated to assess their impact on performance. To further validate our approach, we established a baseline model and conducted a comprehensive evaluation on both the private test set of the STS-3D Challenge and our self-collected out-of-set data. The framework employs nnUNetV2 with the ResEnc M preset, optimizing feature extraction and dataset adaptation. Our approach achieves a Dice score of 0.8244 and an IoU of 0.851 on the private test set of the STS-3D Challenge, outperforming previous published methods on the same benchmark and demonstrating the effectiveness of our semi-supervised teeth segmentation strategy.},
  keywords={Payloads;MODIS;Filtering;Filters;Central Processing Unit;Circuits and systems;Pixel;HTTP;Protocols;Amplitude shift keying;Tooth Segmentation;CBCT;Semi-supervised;Self-learning;Entropy Ranking},
  doi={10.1109/ICMLA66185.2025.00042},
  ISSN={1946-0759},
  month={Dec},}@INPROCEEDINGS{10781901,
  author={Flotho, Philipp and El-Tabbal, Mohamed and Lever, Teresa E. and Takahashi, Kazutaka},
  booktitle={2024 46th Annual International Conference of the IEEE Engineering in Medicine and Biology Society (EMBC)}, 
  title={Rat Tongue Kinematics with Markerless XROMM Using DeepLabCut and Marker Masking}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={X-ray Reconstruction of Moving Morphology (XROMM) enables 3D tracking of implanted radiopaque markers in animals to study biomechanics. In recent years, DeepLabCut (DLC) has emerged as an important tool for markerless pose estimation in areas of the biological sciences such as neuroscience or behavioral research. While the XROMM markers can be detected and tracked using traditional image processing, DLC has been proven to improve XMALab-based workflows. However, those methods are prone to the exact marker positions and are not robust concerning missing markers.We propose to use XMALab results to reconstruct camera calibrations for the prediction of DLC-guided 3D XROMM markers in videofluoroscopic data. Additionally, we propose a marker masking augmentation to enable tracking with incomplete marker sets and demonstrate that XROMM pose estimation is possible with subsets of visible beads and even without any visible markers without sacrificing accuracy. we further show an implementation of this method to extract tongue kinematic patterns, resulting in a novel insight into rodent tongue behavior during natural feeding behavior.},
  keywords={Tongue;Three-dimensional displays;Neuroscience;Pose estimation;Rodents;Morphology;Kinematics;Rats;Cameras;Image reconstruction;Deep learning;DeepLabCut;Masking augmentation;XROMM;XMALab;Tongue movements;Kinematics},
