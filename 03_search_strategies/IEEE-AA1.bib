  ISSN={1558-3783},
  month={},}@INPROCEEDINGS{11336817,
  author={Zhuang, Jiafu and Chen, Lanxiang and Liu, Xiaofeng and Shi, Zhenchuan and Su, Zhicong},
  booktitle={2025 6th International Conference on Machine Learning and Computer Application (ICMLCA)}, 
  title={Skip Mask with Graph Neural Network for 3D Dental Segmentation in Intra-Oral Scan}, 
