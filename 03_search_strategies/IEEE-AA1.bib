@INPROCEEDINGS{10291865,
  author={Lu, Pengfei and Luo, Wenhui},
  booktitle={2023 IEEE 7th Information Technology and Mechatronics Engineering Conference (ITOEC)}, 
  title={Research and development of the 3D printing system for clinical diagnosis of jaw cyst}, 
  year={2023},
  volume={7},
  number={},
  pages={643-647},
  abstract={A jaw cyst is a common disease in the oral cavity, and the treatment is usually carried out by surgery. We study the clinical significance of converting 2D CT images of jaw cysts into 3D physical models. Currently, surgeons rely solely on 2D images to determine the shape and size of cysts before surgical intervention, which can lead to inaccuracies in diagnosis and surgical planning. The article describes the development of a system that utilizes the Marching Cubes algorithm for 3D reconstruction and STL format output, allowing for the creation of 3D printed models. The system is tested using CT data from patients with jaw cysts, and the resulting physical models could accurately depict the cysts in a 1:1 ratio. This technology is a new approach to diagnosing and treating jaw cysts in oral medicine and has significant potential to improve patient understanding and surgical planning.},
  keywords={Solid modeling;Surface reconstruction;Three-dimensional displays;Computed tomography;Surgery;Three-dimensional printing;Rendering (computer graphics);Medical CT;Three Dimensional Image Reconstruction;MC Algorithm;3D Printing},
  doi={10.1109/ITOEC57671.2023.10291865},
  ISSN={2693-289X},
  month={Sep.},}@ARTICLE{10464289,
  author={Bhat, Shreenidhi H. and Hareesha, K. S. and Kamath, Abhay T. and Kudva, Adarsh and Vineetha, Ravindranath and Nair, Ananya},
  journal={IEEE Access}, 
  title={A Framework to Enhance the Experience of CBCT Data in Real-Time Using Immersive Virtual Reality: Impacting Dental Pre-Surgical Planning}, 
  year={2024},
  volume={12},
  number={},
  pages={45442-45455},
  abstract={Dental surgery has undergone a significant evolution with the advent of cone-beam computed tomography (CBCT), offering intricate 3D imagery vital for surgical planning, interventions, and diagnostics. Nonetheless, the comprehension of the extensive and intricate CBCT data remains a persistent challenge. To address this, virtual reality (VR) has emerged as a promising solution, empowering dental professionals to engage with CBCT data in real-time. This study introduces a VR framework meticulously designed for interactive and immersive visualization of CBCT data, enhancing the understanding of complex dental structures and pre-operative planning in dentistry. The proposed VR framework is developed by leveraging ray-marching volume rendering in the Unity platform with VR technologies for seamless interactions and to create an improvised immersive visualization environment. user-friendly interface supports intuitive CBCT volume manipulation through hand gestures and handheld controllers using an Oculus Quest 2 VR head-mounted device. A comprehensive evaluation involving 12 medical experts demonstrated the framework’s effectiveness, with an impressive overall mean rating of 4.4 out of 5, emphasizing its favorable reception. Participants were awarded a mean score of 4.3 out of 5 for the VR experience and a remarkable 4.5 out of 5 for performance and interactions, highlighting its robustness. The high System Usability Scale (SUS) scores of 87% for VR experience and its impact and 91% for performance and interaction unequivocally indicate the exceptional acceptance of the Unity-based VR framework for CBCT image visualization among experienced medical experts. Therefore, this study illuminates how the proposed VR framework has the potential to revolutionize pre-surgical planning and decision-making processes in dental surgery, particularly in the realm of oral and maxillofacial surgery, promising improved patient outcomes.},
  keywords={Dentistry;Data visualization;Surgery;Real-time systems;Planning;Three-dimensional displays;Rendering (computer graphics);Computed tomography;Virtual reality;Immersive experience;Cone-beam computed tomography;virtual reality;volume rendering;GPU-based ray marching technique;immersive visualization;dental surgical planning},
  doi={10.1109/ACCESS.2024.3375770},
  ISSN={2169-3536},
  month={},}@ARTICLE{11111726,
  author={Lai, Yue and Chen, Huanhuan and Cui, Zhiming and Tan, Minhui and Xu, Tianmin and Zhang, Yanan and Han, Bing and Song, Guangying},
  journal={IEEE Transactions on Computational Social Systems}, 
  title={Automated Dental Landmarks Recognition in Special Models via Neural Network}, 
  year={2026},
  volume={13},
  number={1},
  pages={382-392},
  abstract={Background: Accurate dental landmark recognition is essential in orthodontics and prosthodontics applications but can be challenged by malocclusion and tooth wear. This study expends automated landmark recognition to include such complex cases, aiming to improve anatomical analysis and establish a treatment evaluation framework for Chinese patients. Methods: The study incorporated a dataset of 919 pairs of pretreatment intraoral scan (IOS) models. Initially, a subset of 100 IOS models was segmented and labeled using MeshLab software to generate 3-D dental grid data. Subsequently, 500 IOS models were meticulously labeled by three researchers to train and develop a neural network termed multiscale automated landmark recognition. This network reformulates the task of dental landmark recognition as a geodesic distance field problem on the tooth surface, effectively capturing both local and global geometric features essential for precise detection. The remaining 319 IOS models were then subjected to both manual labeling and automated recognition using the trained network, and the consistency between the two methods was evaluated. Finally, arch width measurements were compared between the two recognition approaches. Results: The neural network shows high concordance with manual labeling, with a mean Euclidean distance discrepancy of 0.375 mm, and no significant difference in arch width measurements between the two methods (P $>$ 0.05). Conclusion: Based on the 0.500 mm clinically acceptable difference standard defined by the ABO objective grading system, the neural network developed in this study demonstrates superior performance in the automated recognition of IOS models exhibiting malocclusion and tooth wear.},
  keywords={Teeth;Dentistry;Neural networks;Manuals;Computational modeling;Three-dimensional displays;Solid modeling;Hospitals;Accuracy;Software;Anatomic landmarks;artificial intelligence;dental model;malocclusion;tooth wear;orthodontics},
  doi={10.1109/TCSS.2025.3590442},
  ISSN={2329-924X},
  month={Feb},}@INPROCEEDINGS{11270148,
  author={Selamet, Rabia Şimal and Pişkin, Şenol},
  booktitle={2025 Medical Technologies Congress (TIPTEKNO)}, 
  title={Comparative Error Analysis of 3D-Modeling, -Printing and - Scanning Methods Used in Orthodontics}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={The use of additive manufacturing in dentistry has exponentially increased, with dental model construction being the most common use of the technology. [1] This requires knowledge of the precision of these models. This is especially important for images used in clinical settings. This project proposal aims to conduct a comparative error analysis of 3D modeling, 3D printing, and 3D scanning methods used in orthodontics to measure the accuracy of 3D images and models used in dentistry and jaw surgery. Anonymized patient images (without identifying information) will be used in the project. The scanned images will be processed to create 3D anatomical models, which will then be printed using a 3D printer. The generated anatomies will then be scanned with a 3D scanner to create a new 3D model. The two resulting models (image processing and scanning results) will be compared by superimposing their axes. This mapping will enable quantitative and qualitative error analysis.},
  keywords={Solid modeling;Three-dimensional displays;Biomedical optical imaging;Accuracy;Error analysis;Image processing;Three-dimensional printing;Optical imaging;Adaptive optics;Dentistry;Orthodontics;Clinical Image Processing;3D Modeling;3D Printing;3D Scanning},
  doi={10.1109/TIPTEKNO68206.2025.11270148},
  ISSN={2687-7783},
  month={Oct},}@INPROCEEDINGS{10597249,
  author={Zhao, Guangye and Hou, Yepo and Xu, Meiyu and Xiao, Chan and Shu, Qun and Wang, Chunfeng},
  booktitle={2024 Asia-Pacific Conference on Software Engineering, Social Network Analysis and Intelligent Computing (SSAIC)}, 
  title={A Systematic Study of Oral Clinical Therapy Based on Computer 3D Modeling Technology}, 
  year={2024},
  volume={},
  number={},
  pages={745-749},
  abstract={This paper introduces the repair algorithm based on computer 3D modeling. The algorithm is used to realize automatic repair of the model and finally get a completely closed tooth model. Secondly, a chamfer filling method based on normal vector was proposed, and the chamfer region of the crown data was identified by judging the Angle between the normal vector and the demolding direction. This reduces the manual chamfer filling workload; Then a template - based Laplacian model editing algorithm is proposed to realize the mapping from two - dimensional template to three dimensional model. Smooth editing effect is ensured by Laplace deformation. Finally, through the modular design of the above three algorithms into the data processing pipeline to develop a digital oral prototype system. The broad spectrum, accuracy and efficiency of the correlation algorithm are verified by different sample examples.},
  keywords={Solid modeling;Three-dimensional displays;Computational modeling;Prototypes;Maintenance engineering;Data processing;Vectors;Computer;3D modeling;oral clinical;digital oral cavity;mesh segmentation},
  doi={10.1109/SSAIC61213.2024.00151},
  ISSN={},
  month={Jan},}@ARTICLE{9079472,
  author={Xiao, Deqiang and Lian, Chunfeng and Wang, Li and Deng, Hannah and Lin, Hung-Ying and Thung, Kim-Han and Zhu, Jihua and Yuan, Peng and Perez, Leonel and Gateno, Jaime and Shen, Steve Guofang and Yap, Pew-Thian and Xia, James J. and Shen, Dinggang},
  journal={IEEE Transactions on Biomedical Engineering}, 
  title={Estimating Reference Shape Model for Personalized Surgical Reconstruction of Craniomaxillofacial Defects}, 
  year={2021},
  volume={68},
  number={2},
  pages={362-373},
  abstract={Objective: To estimate a patient-specific reference bone shape model for a patient with craniomaxillofacial (CMF) defects due to facial trauma. Methods: We proposed an automatic facial bone shape estimation framework using pre-traumatic conventional portrait photos and post-traumatic head computed tomography (CT) scans via a 3D face reconstruction and a deformable shape model. Specifically, a three-dimensional (3D) face was first reconstructed from the patient's pre-traumatic portrait photos. Second, a correlation model between the skin and bone surfaces was constructed using a sparse representation based on the CT images of training normal subjects. Third, by feeding the reconstructed 3D face into the correlation model, an initial reference shape model was generated. In addition, we refined the initial estimation by applying non-rigid surface matching between the initially estimated shape and the patient's post-traumatic bone based on the adaptive-focus deformable shape model (AFDSM). Furthermore, a statistical shape model, built from the training normal subjects, was utilized to constrain the deformation process to avoid overfitting. Results and Conclusion: The proposed method was evaluated using both synthetic and real patient data. Experimental results show that the patient's abnormal facial bony structure can be recovered using our method, and the estimated reference shape model is considered clinically acceptable by an experienced CMF surgeon. Significance: The proposed method is more suitable to the complex CMF defects for CMF reconstructive surgical planning.},
  keywords={Face;Bones;Shape;Surface reconstruction;Surgery;Three-dimensional displays;Image reconstruction;Adaptive-focus deformable shape model (AFDSM);craniomaxillofacial (CMF) surgical planning;sparse representation;statistical shape model (SSM);three-dimensional (3D) face reconstruction},
  doi={10.1109/TBME.2020.2990586},
  ISSN={1558-2531},
  month={Feb},}@ARTICLE{10669588,
  author={Jiang, Yikun and Pei, Yuru and Xu, Tianmin and Yuan, Xiaoru and Zha, Hongbin},
  journal={IEEE Transactions on Medical Imaging}, 
  title={Toward Semantically-Consistent Deformable 2D-3D Registration for 3D Craniofacial Structure Estimation From a Single-View Lateral Cephalometric Radiograph}, 
  year={2025},
  volume={44},
  number={2},
  pages={685-697},
  abstract={The deep neural networks combined with the statistical shape model have enabled efficient deformable 2D-3D registration and recovery of 3D anatomical structures from a single radiograph. However, the recovered volumetric image tends to lack the volumetric fidelity of fine-grained anatomical structures and explicit consideration of cross-dimensional semantic correspondence. In this paper, we introduce a simple but effective solution for semantically-consistent deformable 2D-3D registration and detailed volumetric image recovery by inferring a voxel-wise registration field between the cone-beam computed tomography and a single lateral cephalometric radiograph (LC). The key idea is to refine the initial statistical model-based registration field with craniofacial structural details and semantic consistency from the LC. Specifically, our framework employs a self-supervised scheme to learn a voxel-level refiner of registration fields to provide fine-grained craniofacial structural details and volumetric fidelity. We also present a weakly supervised semantic consistency measure for semantic correspondence, relieving the requirements of volumetric image collections and annotations. Experiments showcase that our method achieves deformable 2D-3D registration with performance gains over state-of-the-art registration and radiograph-based volumetric reconstruction methods. The source code is available at https://github.com/Jyk-122/SC-DREG.},
  keywords={Three-dimensional displays;Diagnostic radiography;Deformation;Semantics;Image reconstruction;Computational modeling;Deformable models;3D craniofacial structure estimation;deformable 2D-3D registration;lateral cephalometric radiograph;semantic consistency},
  doi={10.1109/TMI.2024.3456251},
  ISSN={1558-254X},
  month={Feb},}@ARTICLE{10129853,
  author={Chen, Yizhou and Gao, Shuojie and Tu, Puxun and Chen, Xiaojun},
  journal={IEEE Transactions on Visualization and Computer Graphics}, 
  title={Automatic 3D Teeth Reconstruction From Five Intra-Oral Photos Using Parametric Teeth Model}, 
  year={2024},
  volume={30},
  number={8},
  pages={4780-4791},
  abstract={Orthodontic treatment is a lengthy process that requires regular in-person dental monitoring, making remote dental monitoring a viable alternative when face-to-face consultation is not possible. In this study, we propose an improved 3D teeth reconstruction framework that automatically restores the shape, arrangement, and dental occlusion of upper and lower teeth from five intra-oral photographs to aid orthodontists in visualizing the condition of patients in virtual consultations. The framework comprises a parametric model that leverages statistical shape modeling to describe the shape and arrangement of teeth, a modified U-net that extracts teeth contours from intra-oral images, and an iterative process that alternates between finding point correspondences and optimizing a compound loss function to fit the parametric teeth model to predicted teeth contours. We perform a five-fold cross-validation on a dataset of 95 orthodontic cases and report an average Chamfer distance of 1.0121 $mm^{2}$mm2 and an average Dice similarity coefficient of 0.7672 on all the test samples in the cross-validation, demonstrating a significant improvement compared with the previous work. Our teeth reconstruction framework provides a feasible solution for visualizing 3D teeth models in remote orthodontic consultations.},
  keywords={Teeth;Three-dimensional displays;Shape;Solid modeling;Image reconstruction;Dentistry;Image restoration;Statistical shape modeling;parametric teeth model;teeth contour extraction;teeth reconstruction},
  doi={10.1109/TVCG.2023.3277914},
  ISSN={1941-0506},
  month={Aug},}@INPROCEEDINGS{10805678,
  author={Dimitriu, Florin},
  booktitle={2024 E-Health and Bioengineering Conference (EHB)}, 
  title={Research on Advances in Production of Human Dentition and Dental Bridges Using Additive Manufacturing (Metal 3D Printing)}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={The paper presents an overview of different parts of the human dentition as well as dental bridges produced through metal additive manufacturing. Until now, the most commonly used materials in dentition and bridge prosthetics include combinations as ceramics, resins, and both precious and non-precious metals due to their specific properties. This field has advanced significantly in dental technology. In addition to traditional wax modeling, teeth and bridges were digitally designed using software like 3 Shape and Exocad. Scanners digitally capture models or receive them directly from intraoral scans. Milling and laser-melting processes ensure precise and safe production, with a wide range of materials available, such as zirconium and other metals. An alternative technology, Additive Manufacturing of metal, also known as metal 3D printing, is the newest process where material is added layer by layer to form three-dimensional components. This process has revolutionized various industries, including medical and dental fields, enabling high precision and flexibility in design and production. The use of metallic materials such as titanium alloys is ideal for creating parts that can be safely implanted in the human body. The use of metallic materials such as titanium alloys is ideal for creating parts that can be safely implanted in the human body.},
  keywords={Bridges;Industries;Titanium alloys;Zirconium;Metallic materials;Metals;Production;Teeth;Three-dimensional printing;Dentistry;additive manufacturing;laser;biocompa-tibility;Dentistry},
  doi={10.1109/EHB64556.2024.10805678},
  ISSN={2575-5145},
  month={Nov},}@INPROCEEDINGS{10075269,
  author={Dong, Chenbo and Zhou, Ya and Han, Jiacheng},
  booktitle={2022 4th International Conference on Frontiers Technology of Information and Computer (ICFTIC)}, 
  title={3D Registration Method Based On MVFNet And Super4PCS For Nonhomologous Face Pointclouds}, 
  year={2022},
  volume={},
  number={},
  pages={887-892},
  abstract={To find an economical and accurate reconstruction method for face efficacy evaluation in the medical field, especially for clinics environment can be a challenge because the comparison before and after operation is always involved. In this paper, a MVFNet-based 3D face reconstruction for efficacy evaluation is proposed. However, it is not practical yet since the MVFNet reconstructed pointcloud is far different from accurate pointcloud reconstructed by professional equipment. Therefore, the Super4PCS algorithm is used, which can be used to register nonhomologous pointclouds with high difference. The registration experiments are designed and conducted to evaluate the performance of Super4PCS, and we analyze the accuracy of MVFNet reconstructed pointcloud. The results show that MVFNet reconstructed pointcloud is accurate enough and Super4PCS can register two pointclouds well.},
  keywords={Solid modeling;Three-dimensional displays;Instruments;Surgery;Medical services;Reconstruction algorithms;Registers;3D face reconstruction;3D morphable face model;pointcloud registration},
  doi={10.1109/ICFTIC57696.2022.10075269},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10891058,
  author={},
  booktitle={2024 IEEE Central America and Panama Student Conference (CONESCAPAN)}, 
  title={Enhancing Maxillofacial Surgery: 3D-Printed Models from CT Scans for Improved Surgical Planning}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Traditional two-dimensional images, such as CT scans and panoramic radiographs, have significant limitations in that they do not provide detailed three-dimensional representations of the patient's anatomy for planning maxillofacial surgeries. This can negatively affect surgical efficiency and clinical outcomes. The objective of this research is to develop an accurate protocol for converting CT scans of the mandible into high-fidelity three-dimensional models, which will be printed in resin to improve the planning of maxillofacial surgeries. The method used includes the development of a DICOM image segmentation algorithm, the conversion of these images into 3D models, and the printing of patient-specific surgical guides. The creation of accurate 3D models, validated by maxillofacial surgeons, significantly improved the accuracy of surgical cuts and reduced operating time. In addition, the ability to customize surgical guides reduced the incidence of postoperative complications. In conclusion, the implementation of these 3D models in maxillofacial surgical planning significantly optimizes clinical outcomes, increasing the accuracy and safety of procedures, and marking an important advance in the customization of complex surgical treatments.},
  keywords={Solid modeling;Image segmentation;Accuracy;Computed tomography;Software algorithms;Surgery;Three-dimensional printing;Planning;Resins;DICOM;3D Printing;Clinical Outcomes Optimization;DICOM Image Segmentation;Patient-Specific Surgical Guides;Surgical Planning},
  doi={10.1109/CONESCAPAN62181.2024.10891058},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10708021,
  author={Xing, Yang and Liao, Peixi and Alasleh, Reem AwdhE and Khampatee, Vissuta and Alizadeh-Shabdiz, Farshid},
  booktitle={2024 IEEE 7th International Conference on Multimedia Information Processing and Retrieval (MIPR)}, 
  title={Dental X-ray Segmentation and Auto Implant Design Based on Convolutional Neural Network}, 
  year={2024},
  volume={},
  number={},
  pages={243-246},
  abstract={Panoramic radiographs serve as valuable resources in terms of dental diagnostics and implant planning and require dedicated and time-consuming analysis. Lots of studies applying panoramic radiographs on segmentation tasks using deep learning methods have been conducted. However, few works consider the post-processing part after getting the output of the segmentation. This paper introduces a pipeline that provides end-to-end application of segmenting tooth and other oral structures from X-rays and uses an edge detection algorithm to extract the contours of the tooth and use PCA and linear regression to predict implant planning locations based on the contours. The methodology presented in this article entails the development of a CNN model based on ResUNet designed for segmentation tasks from both panoramic and tangential oral images. These segmented images including teeth, restorations, and other oral structures are used to locate two adjacent teeth that contain a missing area where an implant is suggested. Then based on the main axes of these two adjacent teeth, the main axis of a potential implant is predicted. The model's performance is evaluated using Intersection over Union (IoU) and pixel accuracy metrics, while the precision of implant placement is gauged by measuring distances and angles relative to actual implant locations. The dataset, consisting of images from 100 patients, illustrates the model's high efficacy, achieving an accuracy rate of 0.9785 and an IoU of 0.8483. The predicted implant locations exhibit an average deviation of 0.360 mm and a maximum deviation of 0.795 mm from those determined by dental professionals.},
  keywords={Image segmentation;Accuracy;Implants;Teeth;X-rays;Planning;Dentistry;Convolutional neural networks;Diagnostic radiography;X-ray imaging;Image Segmentation;Dental X-ray;Teeth Seg-mentation;Dental Implant Planning},
  doi={10.1109/MIPR62202.2024.00046},
  ISSN={2770-4319},
  month={Aug},}@INPROCEEDINGS{11431055,
  author={Ismail, Maram H. and Ebrahim, Mazen and Saad, Mohammed Gamal and Nassef, Tamer M.},
  booktitle={2025 International Conference on Computer and Applications (ICCA)}, 
  title={An AI-Based 3D Dental Modeling Framework for Digital Twin Dentistry}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper presents an artificial intelligence (AI) based framework for three-dimensional (3D) dental modeling from cone-beam computed tomography (CBCT) scans. The proposed system automates preprocessing, volumetric segmentation, and 3D reconstruction using deep learning architectures such as 3D U-Net and nnU-Net within a unified and reproducible pipeline. The framework enables the generation of precise digital twins of the dentomaxillofacial complex, supporting applications such as implant planning, orthodontic treatment, and surgical simulation. On a dataset of 102 CBCT volumes collected in collaboration with a university dental faculty, the proposed system achieves mean Dice scores of 94.3% for teeth and 95.1% for jawbone structures while reducing manual annotation time from approximately 45 minutes to under 3 minutes per scan. The resulting watertight 3D models exhibit high geometric fidelity and are readily integrated into digital dentistry workflows. Future work will extend this modeling pipeline with lesion detection and diagnostic modules to complete a fully AI-driven digital twin ecosystem.},
  keywords={Solid modeling;Three-dimensional displays;Computational modeling;Pipelines;Surgery;Teeth;Dentistry;Digital twins;Planning;Artificial intelligence;CBCT;Digital Twin;Deep Learning;Dentistry;Segmentation;3D Modeling},
  doi={10.1109/ICCA66035.2025.11431055},
  ISSN={},
  month={Dec},}@ARTICLE{11511823,
  author={Ma, Lei and Ji, Zongrui and Jiang, Yi and Liu, Yunbi and Zhang, Guangming and Li, Na and Wang, Ningyu and Qi, Peng and Dong, Yi and Xue, Peng},
  journal={IEEE Transactions on Radiation and Plasma Medical Sciences}, 
  title={Estimating Patient-specific Tooth Reference Model from CBCT Images for Precise Dental Implant Planning via Point Cloud Diffusion Model}, 
  year={2026},
  volume={},
  number={},
  pages={1-1},
  abstract={Dental implantation necessitates comprehensive preoperative planning to achieve optimal implant positioning and surgical efficiency, owing to the intricate three-dimensional (3D) oral anatomy and confined surgical field. A fundamental challenge in current implant planning is the absence of patient-specific 3D reference models for missing teeth. This compels dentists to rely on empirical decisions and labor-intensive manual adjustments during virtual planning, resulting in significant variability in positioning accuracy and planning efficiency. To address this limitation, we propose a point cloud deep learning framework that generates patient-specific 3D tooth reference models of missing teeth from cone-beam computed tomography (CBCT) images. Our approach begins by accurately reconstructing a complete dentition model from CBCT image and automatically identifying the adjacent teeth of a given missing tooth. We then introduce a conditional shape generation network based on point cloud diffusion model, leveraging geometric features of neighboring teeth to synthesize the missing tooth’s shape in point cloud. Finally, a three-stage post-processing pipeline converts the predicted tooth in point cloud into a clinical-grade surface mesh. Experimental results demonstrate significant superiority over competing volumetric methods, achieving a mean Chamfer distance of 1.16 mm, Hausdorff distance of 2.15 mm, and angular deviation of 3.63°. Qualitative validation on actual tooth-loss cases confirms seamless anatomical integration, with predicted teeth exhibiting natural continuity in crown morphology and occlusal alignment with adjacent dentition.},
  keywords={Teeth;Modeling;Clouds;Dentistry;High definition video;Shape;Planning;Implants;Training;Surfaces;Digital dentistry;dental implantation;deep learning;reference model;point cloud;diffusion model},
  doi={10.1109/TRPMS.2026.3691137},
  ISSN={2469-7303},
  month={},}@INPROCEEDINGS{10261857,
  author={Han, Runzhe and Yuan, Mengning and Jie, Bimeng and He, Yang and Zhu, Jiayu and Zhang, Runshi and Wang, Junchen},
  booktitle={2023 WRC Symposium on Advanced Robotics and Automation (WRC SARA)}, 
  title={Acoustic 3D Shape Reconstruction of Zygomatic Bone for Non-Invasive Spatial Registration}, 
  year={2023},
  volume={},
  number={},
  pages={45-51},
  abstract={Image-to-patient registration is an essential step in the overall image-guided surgery and determines the accuracy of precise surgery. Currently used registration methods, such as implanting titanium nails in the patient’s face, using occlusal splints or surface registration techniques based on soft tissues, etc., have their own problems such as invasiveness, high cost, or poor stability. Ultrasound imaging has the advantages of non-invasiveness and low cost, and facial bones are usually considered to have minimal deformation. Therefore, we hope to use ultrasound to non-invasively obtain facial bone surface features to complete the preoperative image-patient registration process. Therefore, we propose a technology for craniomaxillofacial surgery that segments and reconstructs 3D images from 2D ultrasound images obtained by ultrasound scanning of the zygomatic bone surface. In the segmentation module, we use nnU-Net with improved loss function and learning rate strategy to segment the zygomatic bone, achieving a Dice score of 0.8405. In the 3D reconstruction module, we propose a PNN algorithm with image downsampling that can quickly process data and a DSBezier algorithm that adds Bezier curves to fill voxels. The reconstruction results are registered with the head CBCT data, and the average residual can reach within 0.6 mm. The experimental results show that this system can accurately segment and reconstruct the zygomatic bone in three dimensions from ultrasound images.},
  keywords={Image segmentation;Surface reconstruction;Ultrasonic imaging;Three-dimensional displays;Costs;Surgery;Titanium;deep learning;segmentation;3D reconstruction;ultrasound;cranio-maxillofacial},
  doi={10.1109/WRCSARA60131.2023.10261857},
  ISSN={2835-3358},
  month={Aug},}@INPROCEEDINGS{10230557,
  author={Liu, Jiaxiang and Hu, Tianxiang and Feng, Yang and Ding, Wanghui and Liu, Zuozhu},
  booktitle={2023 IEEE 20th International Symposium on Biomedical Imaging (ISBI)}, 
  title={Toothsegnet: Image Degradation Meets Tooth Segmentation in CBCT Images}, 
  year={2023},
  volume={},
  number={},
  pages={1-5},
  abstract={In computer-assisted orthodontics, three-dimensional tooth models are required for many medical treatments. Tooth segmentation from cone-beam computed tomography (CBCT) images is a crucial step in constructing the models. However, CBCT image quality problems such as metal artifacts and blurring caused by shooting equipment and patients’ dental conditions make the segmentation difficult. In this paper, we propose ToothSegNet, a new framework which acquaints the segmentation model with generated degraded images during training. ToothSegNet merges the information of high and low quality images from the designed degradation simulation module using channel-wise cross fusion to reduce the semantic gap between encoder and decoder, and also refines the shape of tooth prediction through a structural constraint loss. Experimental results suggest that ToothSegNet produces more precise segmentation and outperforms the state-of-the-art medical image segmentation methods.},
  keywords={Degradation;Training;Image segmentation;Visualization;Solid modeling;Shape;Computational modeling;Tooth Segmentation;CBCT;Orthodontics;Tooth Models;Image Degradation},
  doi={10.1109/ISBI53787.2023.10230557},
  ISSN={1945-8452},
  month={April},}@INPROCEEDINGS{9991701,
  author={Chifor, Radu and Arsenescu, Tudor and Marita, Tiberiu and Santoma, Andrei and Badea, Alexandru Florin and Duma, Daniel and Vacaras, Vitalie and Lebovici, Andrei},
  booktitle={2022 E-Health and Bioengineering Conference (EHB)}, 
  title={Carotid Artery and Thyroid Gland Artificial Intelligence Based Automatic Segmentation from Ultrasound Images - Qualitative Evaluation of the Segmentation Results using 3D Ultrasound Reconstructions: A Preliminary Study}, 
  year={2022},
  volume={},
  number={},
  pages={1-4},
  abstract={The aim of our study is finding an efficient artificial intelligence (AI) model for automatic segmentation of carotid artery from ultrasound images which may save time and lower the operator dependency during diagnosis process. A secondary objective is to provide a method also for lowering the operator dependency in carotid artery ultrasound imaging by qualitative mask evaluation and anatomy better understanding using 3D ultrasound reconstructions. A 3D ultrasound prototype based on a high frequency standard ultrasound machine and a pose reading sensor was used to acquire carotid artery and thyroid gland 2D ultrasound images. In-house-developed software applications were used for 2D image manual and automatic segmentation, 3D ultrasound reconstructions and for the 3D visualization of the scanned area. Using the 3D ultrasound reconstructions, for spatial orientation, an experienced operator created the masks remotely from the 2D ultrasound original images for three types of anatomic elements: the carotid artery wall, the lumen of the blood vessel and the thyroid gland. U-Net, U-Net++ and MultiResU-Net models were tested for automatic segmentation on a 2931 images data set. The best segmentation results in terms of IoU (Intersection over Union) and Dice metrics were obtained for the MultiResU-Net architecture: 0.9146 respectively 0.8578. The results from our preliminary study confirmed the future potential of automatic segmentation for the chosen AI models and the fact that 3D reconstructions based on 2D ultrasound images and pose reading sensors information helped the operator to obtain good quality remotely annotated ground truth (GT) masks of the carotid artery and thyroid gland.},
  keywords={Image segmentation;Solid modeling;Ultrasonic imaging;Three-dimensional displays;Software;Artificial intelligence;Carotid arteries;carotid artery ultrasound imaging;3D ultrasound reconstructions;artificial intelligence;lowering operators dependency;medical imaging},
  doi={10.1109/EHB55594.2022.9991701},
  ISSN={2575-5145},
  month={Nov},}@INPROCEEDINGS{9630750,
  author={Deleat-Besson, Romain and Le, Celia and Al Turkestani, Najla and Zhang, Winston and Dumont, Maxime and Brosset, Serge and Carlos Prieto, Juan and Cevidanes, Lucia and Bianchi, Jonas and Ruellas, Antonio and Gurgel, Marcela and Massaro, Camila and Aliaga-Del Castillo, Aron and Ioshida, Marcos and Yatabe, Marilia and Benavides, Erika and Rios, Hector and Soki, Fabiana and Neiva, Gisele and Fernando Aristizabal, Juan and Rey, Diego and Antonia Alvarez, Maria and Najarian, Kayvan and Gryak, Jonathan and Styner, Martin and Fillion-Robin, Jean-Christophe and Paniagua, Beatriz and Soroushmehr, Reza},
  booktitle={2021 43rd Annual International Conference of the IEEE Engineering in Medicine & Biology Society (EMBC)}, 
  title={Automatic Segmentation of Dental Root Canal and Merging with Crown Shape}, 
  year={2021},
  volume={},
  number={},
  pages={2948-2951},
  abstract={In this paper, machine learning approaches are proposed to support dental researchers and clinicians to study the shape and position of dental crowns and roots, by implementing a Patient Specific Classification and Prediction tool that includes RootCanalSeg and DentalModelSeg algorithms and then merges the output of these tools for intraoral scanning and volumetric dental imaging. RootCanalSeg combines image processing and machine learning approaches to automatically segment the root canals of the lower and upper jaws from large datasets, providing clinical information on tooth long axis for orthodontics, endodontics, prosthodontic and restorative dentistry procedures. DentalModelSeg includes segmenting the teeth from the crown shape to provide clinical information on each individual tooth. The merging algorithm then allows users to integrate dental models for quantitative assessments. Precision in dentistry has been mainly driven by dental crown surface characteristics, but information on tooth root morphology and position is important for successful root canal preparation, pulp regeneration, planning of orthodontic movement, restorative and implant dentistry. In this paper we propose a patient specific classification and prediction of dental root canal and crown shape analysis workflow that employs image processing and machine learning methods to analyze crown surfaces, obtained by intraoral scanners, and three-dimensional volumetric images of the jaws and teeth root canals, obtained by cone beam computed tomography (CBCT).},
  keywords={Irrigation;Image segmentation;Shape;Merging;Surface morphology;Teeth;Machine learning},
  doi={10.1109/EMBC46164.2021.9630750},
  ISSN={2694-0604},
  month={Nov},}@ARTICLE{10605800,
  author={Park, Hyoung Suk and Hyun, Chang Min and Lee, Sang-Hwy and Seo, Jin Keun and Jeon, Kiwan},
  journal={IEEE Access}, 
  title={Automatic 3D Registration of Dental CBCT and Face Scan Data Using 2D Projection Images}, 
  year={2024},
  volume={12},
  number={},
  pages={101289-101298},
  abstract={This paper presents a fully automatic registration method of dental cone-beam computed tomography (CBCT) and face scan data. Difficulties in accurately merging facial scans and CBCT images arise from the different image acquisition methods and limited area of correspondence between the two facial surfaces. In addition, it is difficult to use machine learning techniques because they use face-related 3D medical data with radiation exposure, which are difficult to obtain for training. The proposed method addresses these problems by reusing an existing machine-learning-based 2D landmark detection algorithm in an open-source library and developing a novel mathematical algorithm that identifies paired 3D landmarks from knowledge of the corresponding 2D landmarks. A main contribution of this study is that the proposed method does not require annotated training data of facial landmarks because it uses a pre-trained facial landmark detection algorithm that is known to be robust and generalized to various 2D face image models. Note that this reduces a 3D landmark detection problem to a 2D problem of identifying the corresponding landmarks on two 2D projection images generated from two different projection angles. Here, the 3D landmarks for registration were selected from the sub-surfaces with the least geometric change under the CBCT and face scan environments. For the final fine-tuning of the registration, the Iterative Closest Point method was applied, which utilizes geometrical information around the 3D landmarks. The proposed method achieved an averaged mean surface distance error of 0.74 mm for three pairs of CBCT and face scan datasets.},
  keywords={Three-dimensional displays;Dentistry;Computed tomography;Solid modeling;Machine learning;Deformable models;Face detection;Digital systems;Registration;dental computed tomography;face-scan data;machine learning;digital dentistry},
  doi={10.1109/ACCESS.2024.3431673},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{9301845,
  author={Li, Kang Rong and Hsung, Tai-Chiu and Yeung, Andy W.K. and Bornstein, Michael M.},
  booktitle={2020 IEEE International Conference on Visual Communications and Image Processing (VCIP)}, 
  title={On Segmentation of Maxillary Sinus Membrane using Automatic Vertex Screening}, 
  year={2020},
  volume={},
  number={},
  pages={108-111},
  abstract={The purpose of this study is to develop an automatic technique to segment the membrane of the maxillary sinus with morphological changes (e.g. thickened membrane and cysts) for the detection of abnormalities. The first step is to segment the sinus bone cavity in the CBCT image using fuzzy C-mean algorithm. Then, the vertices of inner bone walls of sinus in the mesh model are screened with vertex normal direction and angular based mean-distance filtering. The resulted vertices are then used to generate the bony sinus cavity mesh model by using Poisson surface reconstruction. Finally, the sinus membrane morphological changes are segmented by subtracting the air sinus segmentation from the reconstructed bony sinus cavity. The proposed method has been applied on 5 maxillary sinuses with mucosal thickening and has demonstrated that it can segment thin membrane thickening (<; 2 mm) successfully within 4.1% and 3.5% error in volume and surface area respectively. Existing methods have issues of leakages at openings and thin bones, and inaccuracy with irregular contours commonly seen in maxillary sinus. The current method overcomes these shortcomings.},
  keywords={Bones;Surface morphology;Surface reconstruction;Image segmentation;Three-dimensional displays;Mathematical model;Dentistry;maxillary sinus membrane segmentation;vertex screening;cone beam computed tomography},
  doi={10.1109/VCIP49819.2020.9301845},
  ISSN={2642-9357},
  month={Dec},}@ARTICLE{11351321,
  author={Guo, Yan and Li, Chenyao and Li, Haitao and Ge, Weiwen and Zeng, Bolun and Liu, Jiaxuan and Wan, Tianhao and Zhang, Shanyong and Chen, Xiaojun},
  journal={IEEE Transactions on Image Processing}, 
  title={Automated Orthognathic Surgery Planning Based on Shape-Aware Morphology Prediction and Anatomy-Constrained Registration}, 
  year={2026},
  volume={35},
  number={},
  pages={629-639},
  abstract={Orthognathic surgery demands precise preoperative planning to achieve optimal functional and aesthetic results, yet current practices remain labor-intensive and highly dependent on surgical expertise. To address these challenge, we propose OrthoPlanner, a novel two-stage framework for automated orthognathic surgical planning. In the first stage, we develop JawFormer, a shape sensitive transformer network that predicts postoperative bone morphology directly from preoperative 3D point cloud data. Built upon a point cloud encoder-decoder architecture, the network integrates anatomical priors through a region-based feature alignment module. This enables precise modeling of structural changes while preserving critical anatomical features. In the second stage, we introduce a symmetry-constrained rigid alignment algorithm that automatically outputs the precise translation and rotation of each osteotomized bone segment required to match the predicted morphology. This ensures bilateral anatomical consistency and facilitates interpretable surgical plans. Compared with existing approaches, our method achieves superior quantitative performance and enhanced visualization results, as demonstrated by 65 experiments on real clinical datasets. Moreover, OrthoPlanner significantly reduces planning time and manual workload, while ensuring reproducible and clinically acceptable outcomes.},
  keywords={Surgery;Planning;Bones;Shape;Morphology;Point cloud compression;Feature extraction;Transformers;Artificial intelligence;Predictive models;Surgical planning;orthognathic surgery;postoperative shape prediction},
  doi={10.1109/TIP.2026.3651981},
  ISSN={1941-0042},
  month={},}@INPROCEEDINGS{9371785,
