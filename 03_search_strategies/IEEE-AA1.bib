  booktitle={2023 IEEE 5th Eurasia Conference on IOT, Communication and Engineering (ECICE)}, 
  title={Partial Fixed Dental Prosthesis for Additive Manufacturing: Automated Build Orientation Selection and Optimization Based on Deep Learning}, 
