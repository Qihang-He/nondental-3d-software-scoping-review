  booktitle={2025 IEEE 21st International Conference on Intelligent Computer Communication and Processing (ICCP)}, 
  title={AI-Based Anatomical Landmark Recognition for Robot-Assisted Dynamic Dental Implant Surgery}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={This paper presents the development of an AI-based anatomical landmark recognition framework designed for robot-assisted dynamic dental implant surgery. The proposed framework integrates a YOLOv11 deep learning model with a RealSense D405 RGB-D (Red, Green, Blue and Depth) camera, mounted on a collaborative robot, to detect predefined dental landmarks in real time. These 2D detections are projected into 3D space using depth information and subsequently registered to a preoperative STL model derived from CBCT (Cone Beam Computed Tomography) scans using Unity. The implant position, defined in the planning phase relative to anatomical landmarks, is localized intraoperatively without the use of fiducial markers and projected on the STL model of the mandible/maxilla.},
  keywords={Solid modeling;Three-dimensional displays;Navigation;Computational modeling;Robot vision systems;Surgery;Implants;Real-time systems;Dentistry;Planning;AI-based recognition;Robot-assisted Oral Surgery;Vision-guided robotic navigation;Dental implant surgery},
  doi={10.1109/ICCP68926.2025.11427105},
  ISSN={2766-8495},
  month={Oct},}@INPROCEEDINGS{10288678,
  author={Song, Danni and Liu, Baolong},
  booktitle={2023 6th International Conference on Computer Network, Electronic and Automation (ICCNEA)}, 
  title={Research on Denture Feature Matching Point Cloud Data Based on Deep Learning}, 
  year={2023},
  volume={},
  number={},
  pages={391-394},
  abstract={With the vigorous development of modern science and technology, to effectively solve the shortcomings of traditional oral diagnosis and treatment, digital oral diagnosis and treatment models are based on three-dimensional reconstruction technology to restore the surface information of denture models, making it easier for doctors to accurately diagnose and treat patients' conditions. Deep learning provides new ideas for denture point cloud feature matching. In this paper, the EdgeConv structure is introduced to improve the network for denture point cloud matching. The experimental outcomes demonstrate that the improved network for matching features of denture point clouds performs well in comparison to the traditional ICP algorithm. Compared with the PCRNet network, the MSE_R is reduced by 0.716, and the MSE_t is reduced by 0.064. The improved network has stronger feature extraction capabilities for local features, resulting in point cloud registration outcomes that are closer to the actual point cloud registration. Additionally, the network's performance is more consistent and stable.},
  keywords={Point cloud compression;Deep learning;Solid modeling;Surface reconstruction;Surgery;Mean square error methods;Medical services;Artificial Tooth;3D Reconstruction;Pcrnet;Edgeconv},
  doi={10.1109/ICCNEA60107.2023.00089},
  ISSN={2770-7695},
  month={Sep.},}@ARTICLE{10043003,
  author={Qu, Zhiyuan and Jing, Hongyi and Bai, Guo and Gao, Zhongpai and Yu, Leilei and Zhang, Zhiyuan and Zhai, Guangtao and Yang, Chi},
  journal={IEEE Internet of Things Journal}, 
  title={Computed Tomography and 3-D Face Scan Fusion for IoT-Based Diagnostic Solutions}, 
  year={2023},
  volume={10},
  number={13},
  pages={11605-11618},
  abstract={In clinical diagnosis, multimodal medical image fusion is meaningful and necessary, for the reason that some diseases need to be diagnosed in combination with the situation of different tissues of patients. Spiral computed tomography (CT) realizes the high precision and smooth reconstruction of bone tissue, while it can not represent the color and texture information in soft tissue reconstruction with high accuracy. The face scan precisely records the color and shape of the maxillofacial region. The diagnosis of some diseases (like cavernous hemangioma and jaw deformity caused by idiopathic condylar resorption) needs to combine the information of maxillofacial soft tissue and bone, so it is of great significance to fuse spiral CT and face scan images. In this article, a novel intelligent Internet of Things scene is proposed: a multimodal medical images acquisition and fusion system, and by combining CT machine and face scan equipment, the CT and face scan of patients can be synchronously collected. Deep point neural networks are used to extract feature points and a threshold iterative closest point algorithm performing registration with deep feature points and contributed region segmentation is applied. Finally, high-precision fused modal data is output at the mobile terminal to facilitate diagnosis and analysis and improve the efficiency of doctor–patient communication. Quantitative experiments show promising results, and clinical experiments prove that our method enables patients and doctors to better understand the state of an illness and improves the efficiency of doctor–patient communication.},
  keywords={Faces;Computed tomography;Medical diagnostic imaging;Point cloud compression;Feature extraction;Three-dimensional displays;Diseases;Deep fusion;face scan;Internet of Things (IoT);multimodal registration;spital computed tomography (CT)},
  doi={10.1109/JIOT.2023.3244201},
  ISSN={2327-4662},
  month={July},}@ARTICLE{11186192,
  author={Jiang, Yuxian and Wang, Xiuying and Yang, Tao and Ji, Changkai and He, Lanshan and Liu, Yusheng and Wang, Wei and Liu, Min and Shi, Junyu and Guo, Huayan and Chen, Sheng and Wang, Lisheng},
  journal={IEEE Journal of Biomedical and Health Informatics}, 
  title={Morphology Prior Enhanced Teeth Segmentation for High-Resolution Oral Scans}, 
  year={2026},
  volume={30},
  number={4},
  pages={3344-3355},
  abstract={Deep learning methods have been proposed for tooth segmentation on high-resolution intra-oral scans (IOS) that plays a crucial role in clinical dental practice. However, they generally segment teeth in a low-resolution data with a fixed receptive field and generate final segmentation by up-sampling interpolation, and neglect teeth’s morphology priors: their similar dental arch structures and significantly different curvatures in different parts of each tooth. They thus lack adaptability to different parts of each tooth, and show less accurate segmentation of boundary points between teeth and gums due to the up-sampling computation. Further, cluttered poses of IOS limit their generalization and usability of teeth location and geometric information. To address these limitations, a morphology prior enhanced teeth segmentation framework is proposed in this paper. Firstly, a robust preprocessing is introduced to align poses of different IOS by computing their dental arch orientations, thereby improving segmentation generalization and usability of IOS geometric information. Secondly, a decomposition-merging strategy is designed to avoid the up-sampling limitation, which decomposes an IOS into multiple low-resolution data and merges their segmentation outcomes into a high-resolution result. Thirdly, an innovative module integrating semantic and geometric features is proposed to adaptively select deformable receptive fields. It geometrically samples within a variable probability space to construct receptive fields with varied graph relationships for different points, facilitating adaptive segmentation of different parts of each tooth. Experimental results on 6238 IOS from four centers demonstrate that our method significantly outperforms 11 state-of-the-art methods, achieving a 6.93% enhancement for cross-center testing.},
  keywords={Teeth;Dentistry;Three-dimensional displays;Morphology;Semantics;Surface morphology;Geometry;Convolution;Bioinformatics;Adaptation models;High-resolution intra-oral scan;teeth segmentation;pose standardization;decomposition-merging strategy;generalization ability},
  doi={10.1109/JBHI.2025.3616205},
  ISSN={2168-2208},
  month={April},}@INPROCEEDINGS{9098542,
  author={Wu, Xiyi and Chen, Huai and Huang, Yijie and Guo, Huayan and Qiu, Tiantian and Wang, Lisheng},
  booktitle={2020 IEEE 17th International Symposium on Biomedical Imaging (ISBI)}, 
  title={Center-Sensitive and Boundary-Aware Tooth Instance Segmentation and Classification from Cone-Beam CT}, 
  year={2020},
  volume={},
  number={},
  pages={939-942},
  abstract={Tooth instance segmentation provides important assistance for computer-aided orthodontic treatment. Many previous studies on this issue have limited performance on distinguishing adjacent teeth and obtaining accurate tooth boundaries. To address the challenging task, in this paper, we present a novel method achieving tooth instance segmentation and classification from cone beam CT (CBCT) images. The core of our method is a two-level hierarchical deep neural network. We first embed center-sensitive mechanism with global stage heatmap, so as to ensure accurate tooth centers and guide the localization of tooth instances. Then in the local stage, DenseASPP-UNet is proposed for fine segmentation and classification of individual tooth. Further, in order to improve the accuracy of tooth segmentation boundary and refine the boundaries of overlapped teeth, a boundary-aware dice loss and a novel label optimization are also applied in our method. Comparative experiments show that the proposed framework exhibits high segmentation performance and outperforms the state-of-the-art methods.},
  keywords={Teeth;Image segmentation;Heating systems;Dentistry;Optimization;Three-dimensional displays;Computed tomography;Tooth Instance Segmentation;Heatmap Regression;Boundary-aware;Label Optimization},
  doi={10.1109/ISBI45749.2020.9098542},
  ISSN={1945-8452},
  month={April},}@ARTICLE{9336225,
  author={Xiao, Deqiang and Lian, Chunfeng and Deng, Hannah and Kuang, Tianshu and Liu, Qin and Ma, Lei and Kim, Daeseung and Lang, Yankun and Chen, Xu and Gateno, Jaime and Shen, Steve Guofang and Xia, James J. and Yap, Pew-Thian},
  journal={IEEE Journal of Biomedical and Health Informatics}, 
  title={Estimating Reference Bony Shape Models for Orthognathic Surgical Planning Using 3D Point-Cloud Deep Learning}, 
  year={2021},
  volume={25},
  number={8},
  pages={2958-2966},
  abstract={Orthognathic surgical outcomes rely heavily on the quality of surgical planning. Automatic estimation of a reference facial bone shape significantly reduces experience-dependent variability and improves planning accuracy and efficiency. We propose an end-to-end deep learning framework to estimate patient-specific reference bony shape models for patients with orthognathic deformities. Specifically, we apply a point-cloud network to learn a vertex-wise deformation field from a patient's deformed bony shape, represented as a point cloud. The estimated deformation field is then used to correct the deformed bony shape to output a patient-specific reference bony surface model. To train our network effectively, we introduce a simulation strategy to synthesize deformed bones from any given normal bone, producing a relatively large and diverse dataset of shapes for training. Our method was evaluated using both synthetic and real patient data. Experimental results show that our framework estimates realistic reference bony shape models for patients with varying deformities. The performance of our method is consistently better than an existing method and several deep point-cloud networks. Our end-to-end estimation framework based on geometric deep learning shows great potential for improving clinical workflows.},
  keywords={Shape;Surgery;Bones;Three-dimensional displays;Faces;Deformable models;Convolution;Dentofacial deformity;orthognathic surgical planning;shape estimation;geometric deep learning;3D point cloud},
  doi={10.1109/JBHI.2021.3054494},
  ISSN={2168-2208},
  month={Aug},}@INPROCEEDINGS{10117196,
  author={Bhat, Shreenidhi H and Hareesha, K S and Kamath, Abhay T and Kudva, Adarsh and Shashank, H},
  booktitle={2023 10th International Conference on Signal Processing and Integrated Networks (SPIN)}, 
  title={Interactive Volume Rendering Module using Two-Dimensional Transfer Function on Cone-Beam Computed Tomography Data}, 
  year={2023},
  volume={},
  number={},
  pages={761-766},
  abstract={The transfer function’s design has a direct impact on the outcome of the medical image visualization. A well-designed transfer function can boost both image quality as well as visualization speed. In this paper, a new approach is proposed for developing an interactive ubiquitous volume rendering module using a 2D histogram-based transfer function on medical data. The set of direct manipulation widgets in VTK is used to demonstrate interactive and intuitive 2D transfer functions. Also, the interaction in the histogram was done by adding multiple control points, which act as the boundary-emphasizing function designed to identify regions of the transfer function. The CBCT dataset of the dentofacial images is used to evaluate the outcome of the proposed 2D transfer function by highlighting the required features in the dentofacial volume. By comparing with the 3D Slicer open-source software, the effectiveness and quality were much more accurate, and more detailed clear information can be visualized from the proposed approach.},
  keywords={Histograms;Three-dimensional displays;Software algorithms;Transfer functions;Data visualization;Surgery;Signal processing algorithms;Volume rendering;Transfer function;Medical visualization},
  doi={10.1109/SPIN57001.2023.10117196},
  ISSN={2688-769X},
  month={March},}@INPROCEEDINGS{9098602,
  author={Li, Peixin and Pei, Yuru and Guo, Yuke and Ma, Gengyu and Xu, Tianmin and Zha, Hongbin},
  booktitle={2020 IEEE 17th International Symposium on Biomedical Imaging (ISBI)}, 
  title={Non-Rigid 2D-3D Registration Using Convolutional Autoencoders}, 
  year={2020},
  volume={},
  number={},
  pages={700-704},
  abstract={In this paper, we propose a novel neural network-based framework for the non-rigid 2D-3D registration of the lateral cephalogram and the volumetric cone-beam CT (CBCT) images. The task is formulated as an embedding problem, where we utilize the statistical volumetric representation and embed the X-ray image to a code vector regarding the non-rigid volumetric deformations. In particular, we build a deep ResNet-based encoder to infer the code vector from the input X-ray image. We design a decoder to generate digitally reconstructed radiographs (DRRs) from the non-rigidly deformed volumetric image determined by the code vector. The parameters of the encoder are optimized by minimizing the difference between synthetic DRRs and input X-ray images in an unsupervised way. Without geometric constraints from multi-view X-ray images, we exploit structural constraints of the multi-scale feature pyramid in similarity analysis. The training process is unsupervised and does not require paired 2D X-ray images and 3D CBCT images. The system allows constructing a volumetric image from a single X-ray image and realizes the 2D-3D registration between the lateral cephalograms and CBCT images.},
  keywords={X-ray imaging;Strain;Three-dimensional displays;Two dimensional displays;Decoding;Training;Convolutional codes;Non-rigid 2D-3D registration;convolutional autoencoders;multi-scale feature pyramid},
  doi={10.1109/ISBI45749.2020.9098602},
  ISSN={1945-8452},
  month={April},}@INPROCEEDINGS{11113954,
  author={Rameshrao Deshpande, Prasanna and Santosh Pansare, Bhavana and Pawar, Hemlata Yashwant and Dash, Soumyakant},
  booktitle={2025 5th International Conference on Expert Clouds and Applications (ICOECA)}, 
  title={Exploring the Use of Neural Networks for Early Detection of Oral Cancer and Other Dental Pathologies}, 
  year={2025},
  volume={},
  number={},
  pages={764-769},
  abstract={Delayed diagnosis and restricted access to specialist evaluations are significant issues in the detection of oral cancer and other dental conditions, resulting in unfavorable treatment results. This work investigates the possibilities of neural networks for early diagnosis by comparing five deep learning algorithms: CNN, ResNet, InceptionV3, DenseNet, and a hybrid algorithm (InResNet). The models were experimented with and validated with a labeled image dataset of oral pathology, validating their accuracy, sensitivity, and specificity. Results of experiments are presented that reflect InResNet’s highest accuracy (96.7%), sensitivity (95.8%), and specificity (97.1%), surpassing those of CNN (92.5% accuracy), ResNet (94.3%), InceptionV3 (93.8%), DenseNet (95.1%), and VGG16 (90.2%). Results indicate the best feature extraction and classification performance by InResNet for early diagnosis. The research underscores the significance of sophisticated neural networks in enhancing diagnostic accuracy, but additional studies must be conducted to optimize models for real-time use, dataset variety, and integration with clinical practice.},
  keywords={Solid modeling;Pathology;Accuracy;Computational modeling;Telemedicine;Neural networks;Real-time systems;Dentistry;Artificial intelligence;Cancer;Dental pathologies;computer-aided diagnosis (CAD);oral health diagnosis;pathological image classification;oral lesions;artificial intelligence in healthcare;Oral Cancer},
  doi={10.1109/ICOECA66273.2025.00136},
  ISSN={},
  month={March},}@INPROCEEDINGS{11375631,
  author={Lee, Sena and Kim, Guenhye and Jin, YongKyu and Yang, Sejung},
  booktitle={2025 IEEE/CVF International Conference on Computer Vision Workshops (ICCVW)}, 
  title={Render2Seg: Landmark-Guided Patch-Wise Segmentation for Robust 3D Dental Mesh Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={1063-1072},
  abstract={Accurate and robust tooth segmentation in 3D dental meshes is essential for various clinical and diagnostic applications, yet existing multi-class segmentation models often suffer from label confusion, especially in cases involving missing, crowded, or misaligned teeth. To address these challenges, we propose Render2Seg, a modular two-stage segmentation framework that decouples object detection from segmentation. In the first stage, 3D dental meshes are rendered into 2D occlusal-view images, where a YOLO-based detector localizes and classifies individual teeth. Directional landmarks are then detected to guide anatomically aligned 3D patch extraction. In the second stage, each extracted patch is independently segmented using a binary segmentation network, avoiding inter-tooth label ambiguity. Our method demonstrates strong segmentation performance on the public Teeth3DS dataset, achieving high accuracy across diverse tooth types. Moreover, Render2Seg shows superior generalizability and robustness, making it a promising solution for real-world clinical integration. We also discuss current limitations in detection reliability and propose directions for future improvement.},
  keywords={Training;Image segmentation;Solid modeling;Three-dimensional displays;Accuracy;Pipelines;Teeth;Object detection;Detectors;Dentistry;3d dental mesh;2d rendering;multi-class segmentation;automated diagnosis;tooth classification;deep learning;medical image analysis},
  doi={10.1109/ICCVW69036.2025.00115},
  ISSN={2473-9944},
  month={Oct},}@ARTICLE{11271374,
  author={Wang, Yiming and Li, Xiangmin and Yang, Yang and Cheng, Mengjia and Zhang, Xu and Bao, Jiahao and Qian, Hongjun and Huang, Xinyi and Wu, Zhihan and Xiang, Suncheng and Wen, Yaofeng and Yu, Hongbo},
  journal={IEEE Journal of Biomedical and Health Informatics}, 
  title={Ortho-OPD: An Automatic Osteotomy Planes Design Model for Orthognathic Surgery Based on Deep Learning}, 
  year={2026},
  volume={30},
  number={6},
  pages={4759-4771},
  abstract={Orthognathic surgery is applied to restore esthetical facial profile and functional occlusion for patients with dentofacial deformity. Virtual surgical planning (VSP) is indispensable for precise and individualized treatment. Manually designing osteotomy planes is time-consuming and highly experience-dependent. This study aimed to develop and validate an automatic osteotomy plane design method based on deep learning. Methods: A deep learning model, Ortho-OPD (orthognathic osteotomy planes designer), was proposed, consisting of a segmentation network and the random sample consensus (RANSAC) algorithm. The segmentation network was based on a convolutional neural network (CNN), orthognathic segmenting the craniomaxillofacial (CMF) CT data. Osteotomy planes were then defined by the RANSAC algorithm. Ortho-OPD was trained on 71 samples and tested on 31 cases. The performance was evaluated quantitatively and qualitatively. Results: Ortho-OPD functioned smoothly and all cases were successfully performed. The 3D boundary-sensitive loss was employed to optimize precision. Evaluation metrics included accuracy and clinical efficiency.The mean dice similarity coefficient (DSC) was 0.92 $\pm$ 0.032 in CMF segmentation. Ortho-OPD showcased excellent productivity, taking an average of about 9 seconds to complete virtual bimaxillary osteotomy compared to manual work. The angular errors between the predicted planes and ground truth planes, plus the shortest distance from the neural tube or the adjacent apical points to predicted planes, were examined, indicating no significant difference and reliability for preserving vital anatomical structures. Overall, the automatic osteotomy plane design from raw CT data was realized using Ortho-OPD, composed of CNN and RANSAC, providing an efficient and ideal alternative in orthognathic osteotomy planning.},
  keywords={Surgery;Accuracy;Deep learning;Fitting;Three-dimensional displays;Bones;Image segmentation;Biomedical imaging;Feature extraction;Visualization;Artificial intelligence;convolutional neural network (CNN);deep learning;orthognathic surgery;random sample consensus (RANSAC);virtual surgical planning (VSP)},
  doi={10.1109/JBHI.2025.3638775},
  ISSN={2168-2208},
  month={June},}@INPROCEEDINGS{10276342,
  author={Kumar, K. Vijaya and Baskaran, Santhi},
  booktitle={2023 International Conference on Network, Multimedia and Information Technology (NMITCON)}, 
  title={Tri-Stage Deep Learning Model for Mandibular Condyle Segmentation and Osteoarthritis Identification}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={In a new era of medical imaging, deep-learning models have emerged to identify and diagnose Temporomandibular Joint Osteoarthritis (TMJ-OA) from panoramic X-ray scans. The Convolutional Neural Network (CNN) with U-Net models attain better efficiency to segment and classify TMJ-OA over the past years. But the efficiency of deep-learning models primarily depends on the hyperparameters. Also, the TMJ-OA detection is not satisfactory because of an improper segmentation of the mandibular condyle and glenoid fossae on X-ray scans. To solve these problems, this article develops a Tri-Stage Deep-Learning Model (TSDLM) for TMJ-OA identification and diagnosis. This model aims to accurately segment mandibular condyles and glenoid fossae on X-ray scans using a 3D U-Net. In this model, the initial two stages adopt the 3D U-Net model for Region-Of-Interest (ROI) extraction and mandibular condyle region segmentation. In the third stage, the ResNet50 model is utilized to learn the features from the segmented areas and classify the TMJ-OA for accurate diagnosis. Besides, a Reptile Search Algorithm (RSA) is proposed for hyperparameter optimization, which enhances mandibular condyle segmentation and TMJ-OA identification. Finally, the experimental results exhibit that the TSDLM reaches an accuracy of 92.29% on the panoramic dental X-ray image dataset compared to the conventional deep-learning models.},
  keywords={Image segmentation;Solid modeling;Three-dimensional displays;Dentistry;Convolutional neural networks;Osteoarthritis;Information technology;temporomandibular joint;osteoarthritis panoramic dental X-ray;deep learning;CNN;U-Net;hyperparameter optimization;reptile search optimization},
  doi={10.1109/NMITCON58196.2023.10276342},
  ISSN={},
  month={Sep.},}@ARTICLE{9445658,
  author={Jang, Tae Jun and Kim, Kang Cheol and Cho, Hyun Cheol and Seo, Jin Keun},
  journal={IEEE Transactions on Pattern Analysis and Machine Intelligence}, 
  title={A Fully Automated Method for 3D Individual Tooth Identification and Segmentation in Dental CBCT}, 
  year={2022},
  volume={44},
  number={10},
  pages={6562-6568},
  abstract={Accurate and automatic segmentation of three-dimensional (3D) individual teeth from cone-beam computerized tomography (CBCT) images is a challenging problem because of the difficulty in separating an individual tooth from adjacent teeth and its surrounding alveolar bone. Thus, this paper proposes a fully automated method of identifying and segmenting 3D individual teeth from dental CBCT images. The proposed method addresses the aforementioned difficulty by developing a deep learning-based hierarchical multi-step model. First, it automatically generates upper and lower jaws panoramic images to overcome the computational complexity caused by high-dimensional data and the curse of dimensionality associated with limited training dataset. The obtained 2D panoramic images are then used to identify 2D individual teeth and capture loose- and tight- regions of interest (ROIs) of 3D individual teeth. Finally, accurate 3D individual tooth segmentation is achieved using both loose and tight ROIs. Experimental results showed that the proposed method achieved an F1-score of 93.35 percent for tooth identification and a Dice similarity coefficient of 94.79 percent for individual 3D tooth segmentation. The results demonstrate that the proposed method provides an effective clinical and practical framework for digital dentistry.},
  keywords={Teeth;Three-dimensional displays;Image segmentation;Dentistry;Computed tomography;Image reconstruction;Bones;Cone-beam computerized tomography;digital dentistry;tooth segmentation;tooth identification;deep learning},
  doi={10.1109/TPAMI.2021.3086072},
  ISSN={1939-3539},
  month={Oct},}@INPROCEEDINGS{11449990,
  author={Elliott, Rhett and Benson, Jeff and Rad, Pouria and Orlosky, Jason},
  booktitle={2026 IEEE International Conference on Artificial Intelligence and eXtended and Virtual Reality (AIxVR)}, 
  title={3D View Alignment and Autonomous Navigation of Telepresence Robots During Multi-Participant Interaction in Augmented Reality}, 
  year={2026},
  volume={},
  number={},
  pages={248-252},
  abstract={In multi-participant telepresence, where human participants and remote-controlled telepresence robots interact in the same physical space, robots still suffer from several problems. In particular, manipulation of the robot into place requires significant manual control from a remote user, and even after manual placement, the position and viewpoint may not resemble how an in-person participant appears in physical space. To address these issues, we implemented a viewpoint management algorithm and autonomous navigation system that can 1) autonomously move a telepresence robot into an ongoing conversation in the local environment and 2) build a 3D representation of the remote participant's face that is transferred onto the robot in real time and can be viewed by local participants using AR. In addition to the development of the technical framework that enables this multi-directional communication, we detail the calibration process, navigation algorithms, and facial reconstruction mechanism. Finally, we demonstrate the functionality of our framework both visually and in a systems test that validates two different navigation algorithms.},
  keywords={Telepresence;Three-dimensional displays;Navigation;Oral communication;Manuals;Human factors;Aerospace electronics;Real-time systems;Augmented reality;Autonomous robots;Telepresence;Robotics;Augmented Reality;3D Reconstruction},
  doi={10.1109/AIxVR67263.2026.00043},
  ISSN={2771-7453},
  month={Jan},}@INPROCEEDINGS{10537738,
  author={Shukla, Shambhavi M and Mishra, Ganga Ram and Mishra, Ramesh},
  booktitle={2023 Seventh International Conference on Image Information Processing (ICIIP)}, 
  title={Empowering Rural and Suburban Dental Care with Open-Source Image Processing}, 
  year={2023},
  volume={},
  number={},
  pages={782-788},
  abstract={The research paper aims to determine dental patient care in suburban and rural areas through open-source image-processing modules. Therefore, the architecture of CNN is discussed according to the demand of the study. Moreover, implementing a particularly trained CNN model with different input data distorts the result. It was found that fixed architecture for of CNN model provides a unique nature to the implication. For instance, in every situation, the algorithms of a CNN model are required to be trained for examining input data. Furthermore, it was found that CNN architecture is subjective to the field of implication. Therefore, the effectiveness of the model helps to produce a relevant and relatable outcome. Open-source imaging processes, associated with AI technologies and advanced image processing hardware and software, can transform dental patient care in rural and suburban domains. Open-source image processing modules have become a necessary technology for their various importance. These technologies can bridge the gap in dental services, by enhancing accuracy, accessibility, and efficiency.},
  keywords={Image processing;Imaging;Computer architecture;Transforms;Information processing;Data models;Software;aspect ratios;perspectives;enhancement hinder;medical decisions;reliable sessions},
  doi={10.1109/ICIIP61524.2023.10537738},
  ISSN={2640-074X},
  month={Nov},}@ARTICLE{11177189,
  author={Keshari Parida, Bikram and Sunilkumar, Anusree P. and Sen, Abhijit and You, Wonsang},
  journal={IEEE Access}, 
  title={ViT-NeBLa: A Hybrid Vision Transformer and Neural Beer–Lambert Framework for Single-View 3D Reconstruction of Oral Anatomy From Panoramic Radiographs}, 
  year={2025},
  volume={13},
  number={},
  pages={170761-170781},
  abstract={Panoramic radiography (PX) is widely used in dentistry but provides only a flattened 2D view; Cone Beam Computed Tomography CT (CBCT) recovers 3D anatomy at higher dose and cost. We tackle full 3D reconstruction from a single real-world PX for varying patients. We propose ViT–NeBLa (Vision-Transformer Neural Beer–Lambert), a physics-guided framework that estimates a continuous 3D dentoalveolar density field directly from single PX. The design mirrors panoramic acquisition while simplifying the inverse problem: we parameterize projection-ray directions by tangency to a patient-adaptive elliptical path and independently restrict sampling to a jaw-focused horseshoe (focal trough) in which the projection rays do not intersect. This removes the intermediate density-aggregation step used by overlapping-ray methods and reduces per-ray samples by about 52%, lowering memory and compute. A hybrid ViT–CNN backbone extracts global anatomical context and local texture from the PX, and a learnable multi-resolution hash positional encoding maps 3D sample coordinates to expressive features that preserve fine dental and osseous detail. Per-point densities are predicted by a compact MLP and accumulated into a coarse 3D grid, which a lightweight 3D U-Net refines into the final volume. Training is end-to-end using synthetic PX rendered from CBCT via the Beer–Lambert law together with voxelwise, projection-consistency, and perceptual losses; at inference, a single PX is processed directly—without CBCT flattening or dental-arch priors. Experiments show that ViT–NeBLa outperforms contemporary PX-to-3D baselines both quantitatively and qualitatively, yielding sharper cortical boundaries, clearer trabecular patterns, and fewer artifacts. In sum, ViT–NeBLa provides a radiation-efficient route to clinically informative 3D visualization from routine panoramic radiographs while simplifying geometry, reducing sampling, and preserving high-frequency structure.},
  keywords={Three-dimensional displays;Feature extraction;Dentistry;Image reconstruction;Teeth;Encoding;Training;Shape;Transformers;Bones;Single-view 3D reconstruction;panoramic radiograph;cone-beam computed tomography;vision transformer (ViT);implicit neural representation;hash encoding},
  doi={10.1109/ACCESS.2025.3613789},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{9864442,
  author={Anirudh, Malkuchi and Baburam, Mudavath and Arunachalam, Kavitha},
  booktitle={2022 IEEE Region 10 Symposium (TENSYMP)}, 
  title={Patient-specific Model Generation using Multiview 3D Reconstruction for Hyperthermia Treatment Planning}, 
  year={2022},
  volume={},
  number={},
  pages={1-5},
  abstract={Hyperthermia treatment of locally advanced mouth and oral cancers requires three-dimensional model of the patient, mostly emphasizing nasal throat region for treatment planning. 3D patient-specific model is crucial to plan the procedure for effective and localized thermal therapy. An image-based reconstruction technique, structure from motion (SfM) is a cost effective, flexible and efficient solution for this end application. Although SfM provides various algorithms and pipelines, it is important to select the optimum image capturing technique and effective pipeline to obtain robust 3D image reconstruction. In this work, we present the evaluation and analysis of effective hand-held image capturing techniques and performance of few open-source reconstruction pipelines tested on custom synthetic and real world captured data.},
  keywords={Solid modeling;Three-dimensional displays;Spirals;Pipelines;Cameras;Fiducial markers;Planning;bundle adjustment;feature extraction and matching;geometric verification;hyperthermia;image registration;structure from motion;triangulation},
  doi={10.1109/TENSYMP54529.2022.9864442},
  ISSN={2642-6102},
  month={July},}@INPROCEEDINGS{11346332,
  author={Kalaivani, D and Kamat, Apeksha Anil and Chathurya, G and Vamshith, N and Imran, K},
  booktitle={2025 Eighth International Conference on Image Information Processing (ICIIP)}, 
  title={SurgiX: An Adaptive Multimedia XR Framework for Healthcare Training and Simulation}, 
  year={2025},
  volume={},
  number={},
  pages={545-552},
  abstract={Virtual and Augmented Reality (VR/AR) technologies are reshaping healthcare education by enabling immersive, interactive, and risk-free learning environments. This paper presents SurgiX, an adaptive extended reality (XR) framework designed for pre-clinical dental training. The system integrates real-time multimedia rendering, FSM-based procedural control, and a generative scoring engine to provide structured, feedback-driven practice sessions. Developed in Unity 3D with C# scripting, SurgiX operates seamlessly on affordable standalone headsets such as Proculus One and Oculus Quest, offering gesture-based interactions without dependence on proprietary haptics. Through dynamic feedback visualization and adaptive task scaling, the framework reinforces procedural precision and skill retention. A pilot study with 60 dental students demonstrated notable gains in accuracy, efficiency, and error reduction, with strong usability ratings confirming system feasibility. The findings support SurgiX as an accessible and scalable XR solution bridging the gap between theoretical instruction and clinical readiness.},
  keywords={Training;Visualization;Adaptive systems;Three-dimensional displays;Extended reality;Multimedia systems;Medical services;Rendering (computer graphics);Dentistry;Usability;Extended Reality;Adaptive Simulation;VR in Dental Education;FSM-driven Systems;Intelligent Feedback;Scalable Medical Training},
  doi={10.1109/ICIIP68302.2025.11346332},
  ISSN={2640-074X},
  month={Nov},}@ARTICLE{10226244,
  author={Zhu, Hao and Yang, Haotian and Guo, Longwei and Zhang, Yidi and Wang, Yanru and Huang, Mingkai and Wu, Menghua and Shen, Qiu and Yang, Ruigang and Cao, Xun},
  journal={IEEE Transactions on Pattern Analysis and Machine Intelligence}, 
  title={FaceScape: 3D Facial Dataset and Benchmark for Single-View 3D Face Reconstruction}, 
  year={2023},
  volume={45},
  number={12},
  pages={14528-14545},
  abstract={In this article, we present a large-scale detailed 3D face dataset, FaceScape, and the corresponding benchmark to evaluate single-view facial 3D reconstruction. By training on FaceScape data, a novel algorithm is proposed to predict elaborate riggable 3D face models from a single image input. FaceScape dataset releases 16,940 textured 3D faces, captured from 847 subjects and each with 20 specific expressions. The 3D models contain the pore-level facial geometry that is also processed to be topologically uniform. These fine 3D facial models can be represented as a 3D morphable model for coarse shapes and displacement maps for detailed geometry. Taking advantage of the large-scale and high-accuracy dataset, a novel algorithm is further proposed to learn the expression-specific dynamic details using a deep neural network. The learned relationship serves as the foundation of our 3D face prediction system from a single image input. Different from most previous methods, our predicted 3D models are riggable with highly detailed geometry under different expressions. We also use FaceScape data to generate the in-the-wild and in-the-lab benchmark to evaluate recent methods of single-view face reconstruction. The accuracy is reported and analyzed on the dimensions of camera pose and focal length, which provides a faithful and comprehensive evaluation and reveals new challenges. The unprecedented dataset, benchmark, and code have been released to the public for research purpose.},
  keywords={Three-dimensional displays;Faces;Solid modeling;Shape;Face recognition;Cameras;Geometry;3D face reconstruction;3D morphable model;benchmark;dataset},
  doi={10.1109/TPAMI.2023.3307338},
  ISSN={1939-3539},
  month={Dec},}@INPROCEEDINGS{10928070,
  author={Sherif, Meriam and Barakat, Nahla and Hamdy, Abeer},
  booktitle={2024 International Conference on Computer and Applications (ICCA)}, 
  title={AdaptVR: An Adaptive Learning VR System for Dental Students Training}, 
  year={2024},
  volume={},
  number={},
  pages={01-06},
  abstract={The paper proposes “AdaptVR” a virtual reality (VR) system designed to enhance dental training through realistic real tile simulations and adaptive learning environment, to overcome traditional training challenges in dental education. The system aims to provide personalized learning experiences, facilitating skill development and comprehensive assessments for students. The proposed system was tested by 17 dentistry students and 5 experts. AdaptVR framework is done for operative dentistry which is removing decay especially Class I and Class II of classification of caries. Results from the experiment revealed that 77.3% of participants exceed their expectations, 59.1% saw a positive effect on their dental skills, 90.9% reported higher levels of engagement, and 65% indicated that vibration and force feedback provided students with a genuine sensation. AdpatVR's experimental findings show an average accuracy of 50.85% for Class I, 51.7% for Class II, and 82.09% for the Class II box technique. The error percentage averages 49% for Class I, 48% for Class II, and 18% for Class II box technique.},
  keywords={Training;Vibrations;Drilling;Solid modeling;Adaptive learning;Adaptation models;Force feedback;Virtual reality;Teeth;Dentistry;VR training simulation;dental training;virtual reality;drilling algorithms;tooth decay},
  doi={10.1109/ICCA62237.2024.10928070},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9466012,
  author={Fajar, Aziz and Santoso, Dwi Wahyu and Bahen, Zico Ritonda and Sarno, Riyanarto and Fatichah, Chastine},
  booktitle={2021 International Conference on Artificial Intelligence and Mechatronics Systems (AIMS)}, 
  title={Color Mapping for Volume Rendering Using Digital Imaging and Communications in Medicine Images}, 
  year={2021},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper introduces an automatic colorization of 3D volumetric medical image based on brain Computed Tomography (CT) scan images. This volumetric 3D images are generated from Digital Imaging and Communications in Medicine (DICOM) images. This research renders the DICOM images to volumetric images using ray marching method. Then automatically colorized each brain parts by computing the transfer function based on the value of grayscale to compared to tissue density. Our proposed method focused on the value which color each parts of the brain as well as the use of ray marching algorithm to show colorized result in 3D.},
  keywords={Three-dimensional displays;Mechatronics;Image color analysis;Computed tomography;Transfer functions;Gray-scale;Rendering (computer graphics);Computed Tomography;Volume Rendering;Ray Marching;Transfer Function;Density},
  doi={10.1109/AIMS52415.2021.9466012},
  ISSN={},
  month={April},}@INPROCEEDINGS{9517522,
  author={Gu, Chenlan and Zhao, Ning and Wang, Hesheng},
  booktitle={2021 IEEE International Conference on Real-time Computing and Robotics (RCAR)}, 
  title={Tooth Segmentation of Dental Mesh Based on Improved Region Growing}, 
  year={2021},
  volume={},
  number={},
  pages={1248-1253},
  abstract={Computer-aided design (CAD) systems have gained more and more concern in orthodontics over the last decades. Aimed at tooth segmentation task of three dimension (3D) dental models in orthodontic CAD systems, we propose an efficient and robust framework based on geometric features. To make region growing algorithm flexible and apply it to 3D tooth segmentation, we extend the region similarity description from single-parameter to multi-parameter. A parameter adaptive method is designed to get rid of manual parameter adjustment and raise efficiency. Moreover, we provide a multi-level label optimization algorithm for segmentation refinement. Some experiments are conducted with various dental models from real cases to validate various algorithmic components. The results demonstrate that our pipeline is superior on efficiency and robustness.},
  keywords={Solid modeling;Adaptation models;Three-dimensional displays;Pipelines;Teeth;Manuals;Robustness},
  doi={10.1109/RCAR52367.2021.9517522},
  ISSN={},
  month={July},}@INPROCEEDINGS{9412829,
  author={Zhong, Xin and Zhang, Zhiyuan},
  booktitle={2020 25th International Conference on Pattern Recognition (ICPR)}, 
  title={3D Dental Biometrics: Automatic Pose-invariant Dental Arch Extraction and Matching}, 
  year={2021},
  volume={},
  number={},
  pages={6524-6530},
  abstract={A novel automatic pose-invariant dental arch extraction and matching framework is developed for 3D dental identification using laser-scanned dental plasters. In our previous attempt [1]–[5], 3D point-based algorithms have been developed and they have shown a few advantages over existing 2D dental identifications. This study is a continuous effort in developing arch-based algorithms to extract and match dental arch feature in an automatic and pose-invariant way. As best as we know, this is the first attempt at automatic dental arch extraction and matching for 3D dental identification. A Radial Ray Algorithm (RRA) is proposed by projecting dental arch shape from 3D to 2D. This algorithm is fully automatic and fast. Preliminary identification result is obtained by matching 11 postmortem (PM) samples against 200 ante-mortem (AM) samples. 72.7% samples achieved top 5% accuracy. 90.9% samples achieved top 10% accuracy and all 11 samples (100%) achieved top 15.5% accuracy out of the 200-rank list. In addition, the time for identifying a single subject from 200 subjects has been significantly reduced from 45 minutes to 5 minutes by matching the extracted 2D dental arch. Although the extracted 2D arch feature is not as accurate and discriminative as the full 3D arch, it may serve as an important filter feature to improve the identification speed in future investigations.},
